	{ Name = "Nissan", Min = v(150, -1400), Max = v(230, 900) },
	{ Name = "Centrum", Min = v(-520, -320), Max = v(150, 640) },
	{ Name = "Västra kajen", Min = v(-520, 640), Max = v(150, 900) },
