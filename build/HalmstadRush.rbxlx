-- Byggstenar: lådor, plattor, remsor, ramper, cylindrar, klot och skylttext.

local Geometry = {}

local MAX_PART_SIZE = 2000

function Geometry.Part(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- Markerar en del som "hinder": ger nära-ögat-boost när man susar förbi.
function Geometry.Obstacle(part: BasePart): BasePart
	part:SetAttribute("Obstacle", true)
	return part
end

-- Visuell del som inte påverkar fysik eller raycasts.
function Geometry.Decor(part: BasePart): BasePart
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	return part
end

-- Låda från hörn till hörn. Delas upp i flera Parts om den är större än Robloxs maxstorlek.
function Geometry.Box(
	parent: Instance,
	name: string,
	min: Vector3,
	max: Vector3,
	color: Color3,
	material: Enum.Material?
): { Part }
	local parts = {}
	local size = max - min
	local nx = math.max(1, math.ceil(size.X / MAX_PART_SIZE))
	local nz = math.max(1, math.ceil(size.Z / MAX_PART_SIZE))
	local stepX = size.X / nx
	local stepZ = size.Z / nz
	for ix = 0, nx - 1 do
		for iz = 0, nz - 1 do
			local chunkMin = Vector3.new(min.X + ix * stepX, min.Y, min.Z + iz * stepZ)
			local chunkSize = Vector3.new(stepX, size.Y, stepZ)
			table.insert(
				parts,
				Geometry.Part(parent, name, chunkSize, CFrame.new(chunkMin + chunkSize / 2), color, material)
			)
		end
	end
	return parts
end

-- Horisontell platta (zon) med given översida.
function Geometry.Slab(
	parent: Instance,
	name: string,
	min: Vector2,
	max: Vector2,
	topY: number,
	color: Color3,
	material: Enum.Material?
): { Part }
	return Geometry.Box(parent, name, Vector3.new(min.X, topY - 1, min.Y), Vector3.new(max.X, topY, max.Y), color, material)
end

-- Rak remsa mellan två punkter (vägsegment, vägmarkering).
function Geometry.Strip(
	parent: Instance,
	name: string,
	a: Vector2,
	b: Vector2,
	width: number,
	topY: number,
	thickness: number,
	color: Color3,
	material: Enum.Material?
): Part
	local from = Vector3.new(a.X, topY - thickness / 2, a.Y)
	local to = Vector3.new(b.X, topY - thickness / 2, b.Y)
	local length = (to - from).Magnitude
	local cframe = CFrame.lookAt((from + to) / 2, to)
	return Geometry.Part(parent, name, Vector3.new(width, thickness, length), cframe, color, material)
end

-- Stående cylinder. `base` är mitten av undersidan.
function Geometry.Cylinder(
	parent: Instance,
	name: string,
	base: Vector3,
	radius: number,
	height: number,
	color: Color3,
	material: Enum.Material?
): Part
	local part = Geometry.Part(
		parent,
		name,
		Vector3.new(height, radius * 2, radius * 2),
		CFrame.new(base + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		color,
		material
	)
	part.Shape = Enum.PartType.Cylinder
	return part
end

-- Del mellan två godtyckliga punkter (t.ex. palmstam). Cylinder om `round` är sant.
function Geometry.Between(
	parent: Instance,
	name: string,
	a: Vector3,
	b: Vector3,
	thickness: number,
	color: Color3,
	material: Enum.Material?,
	round: boolean?
): Part
	local length = (b - a).Magnitude
	local cframe = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0)
	local part = Geometry.Part(parent, name, Vector3.new(length, thickness, thickness), cframe, color, material)
	if round then
		part.Shape = Enum.PartType.Cylinder
	end
	return part
end

-- Text på en parts yta (skyltar). Statisk text från oss, inte från spelare.
function Geometry.Label(
	part: BasePart,
	face: Enum.NormalId,
	text: string,
	subText: string?,
	background: Color3,
	textColor: Color3?
): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0.2
	gui.Parent = part

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = background
	frame.BorderSizePixel = 0
	frame.Parent = gui

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Thickness = 6
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = frame

	local main = Instance.new("TextLabel")
	main.BackgroundTransparency = 1
	main.Position = UDim2.fromScale(0.04, if subText then 0.08 else 0.1)
	main.Size = UDim2.fromScale(0.92, if subText then 0.55 else 0.8)
	main.Font = Enum.Font.GothamBlack
	main.TextScaled = true
	main.Text = text
	main.TextColor3 = textColor or Color3.new(1, 1, 1)
	main.Parent = frame

	if subText then
		local sub = Instance.new("TextLabel")
		sub.BackgroundTransparency = 1
		sub.Position = UDim2.fromScale(0.08, 0.64)
		sub.Size = UDim2.fromScale(0.84, 0.28)
		sub.Font = Enum.Font.GothamBold
		sub.TextScaled = true
		sub.Text = subText
		sub.TextColor3 = textColor or Color3.new(1, 1, 1)
		sub.Parent = frame
	end
	return gui
end

function Geometry.Ball(parent: Instance, name: string, center: Vector3, radius: number, color: Color3): Part
	local part = Geometry.Part(parent, name, Vector3.one * radius * 2, CFrame.new(center), color)
	part.Shape = Enum.PartType.Ball
	return part
end

-- Ramp som börjar vid `start` (nedre kanten) och stiger i riktningen `yawDeg`.
-- 0 = stiger mot -Z (norr), 90 = mot -X (väster), -90 = mot +X (öster), 180 = mot +Z (söder).
function Geometry.Ramp(
	parent: Instance,
	name: string,
	start: Vector3,
	yawDeg: number,
	length: number,
	angleDeg: number,
	width: number,
	color: Color3?,
	material: Enum.Material?
): Part
	local thickness = 2
	local yaw = CFrame.Angles(0, math.rad(yawDeg), 0)
	local angle = math.rad(angleDeg)
	local slope = yaw.LookVector * math.cos(angle) + Vector3.yAxis * math.sin(angle)
	local normal = yaw.RightVector:Cross(slope).Unit
	local center = start + slope * (length / 2) - normal * (thickness / 2)
	local cframe = CFrame.fromMatrix(center, slope:Cross(normal), normal)
	return Geometry.Part(
		parent,
		name,
		Vector3.new(width, thickness, length),
		cframe,
		color or Color3.fromRGB(240, 170, 40),
		material or Enum.Material.DiamondPlate
	)
end

function Geometry.RampTop(start: Vector3, yawDeg: number, length: number, angleDeg: number): Vector3
	local flatForward = CFrame.Angles(0, math.rad(yawDeg), 0).LookVector
	local angle = math.rad(angleDeg)
	return start + flatForward * length * math.cos(angle) + Vector3.yAxis * length * math.sin(angle)
end

return Geometry
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">Landmarks</string><ProtectedString name="Source"><![CDATA[--!strict
-- Halmstads kända byggnader och platser, placerade efter stadskartan.
-- Förenklade former men rätt läge, storlek och karaktär.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MapData = require(ReplicatedStorage.Shared.Map.MapData)
local Geometry = require(script.Parent.Geometry)
local Props = require(script.Parent.Props)

local Landmarks = {}

local COPPER = Color3.fromRGB(95, 150, 125)
local DARK_ROOF = Color3.fromRGB(58, 58, 64)
local BRICK = Color3.fromRGB(150, 70, 52)
local FALU_RED = Color3.fromRGB(150, 45, 35)

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function ground(x: number, z: number): number
	return MapData.GroundHeightAt(x, z)
end

-- Sadeltak längs X-axeln i `frame` (lokalt), med given bredd (Z) och höjd.
local function gableRoof(parent: Instance, frame: CFrame, length: number, width: number, rise: number, color: Color3)
	local half = width / 2
	local slope = math.sqrt(half * half + rise * rise)
	local angle = math.atan2(rise, half)
	for _, side in { -1, 1 } do
		Geometry.Part(
			parent,
			"Roof",
			Vector3.new(length, 0.8, slope + 0.6),
			frame * CFrame.new(0, rise / 2, side * half / 2) * CFrame.Angles(side * angle, 0, 0),
			color
		)
	end
end

-- Fontänen "Europa och tjuren" mitt på Stora torg
function Landmarks.Fountain(parent: Instance, at: Vector2)
	local f = folder(parent, "EuropaOchTjuren")
	local base = Vector3.new(at.X, 0, at.Y)
	Geometry.Obstacle(Geometry.Cylinder(f, "Basin", base, 10, 2.2, Color3.fromRGB(170, 170, 172), Enum.Material.Granite))
	local water = Geometry.Cylinder(f, "Water", base + Vector3.new(0, 1.9, 0), 9, 0.3, Color3.fromRGB(70, 140, 180), Enum.Material.Glass)
	water.Transparency = 0.3
	Geometry.Decor(water)
	Geometry.Obstacle(Geometry.Cylinder(f, "Plinth", base, 3, 5, Color3.fromRGB(150, 150, 152), Enum.Material.Granite))
	-- Tjuren (stiliserad, i ärgad brons)
	Geometry.Part(f, "BullBody", Vector3.new(3, 2.6, 6), CFrame.new(base + Vector3.new(0, 6.5, 0)), COPPER, Enum.Material.Metal)
	Geometry.Part(f, "BullHead", Vector3.new(2, 2, 2.2), CFrame.new(base + Vector3.new(0, 7.6, -3.6)), COPPER, Enum.Material.Metal)
	Geometry.Part(f, "Europa", Vector3.new(1.2, 3, 1.2), CFrame.new(base + Vector3.new(0, 9.3, 0.6)), COPPER, Enum.Material.Metal)
	-- Svenska flaggor vid torget
	Props.SwedishFlag(parent, base + Vector3.new(-60, 0, -42), 22)
	Props.SwedishFlag(parent, base + Vector3.new(60, 0, -42), 22)
end

-- S:t Nikolai kyrka: tegelkyrka med västtorn och kopparspira
function Landmarks.Church(parent: Instance, center: Vector2, length: number, width: number)
	local f = folder(parent, "SanktNikolai")
	local wallHeight = 24
	local frame = CFrame.new(center.X, ground(center.X, center.Y), center.Y)
	Geometry.Obstacle(Geometry.Part(f, "Nave", Vector3.new(length, wallHeight, width), frame * CFrame.new(0, wallHeight / 2, 0), BRICK, Enum.Material.Brick))
	gableRoof(f, frame * CFrame.new(0, wallHeight, 0), length + 2, width + 2, 14, COPPER)
	-- Torn i väster
	local towerX = -length / 2 - 7
	local towerHeight = 58
	Geometry.Obstacle(Geometry.Part(f, "Tower", Vector3.new(16, towerHeight, 16), frame * CFrame.new(towerX, towerHeight / 2, 0), BRICK, Enum.Material.Brick))
	local y = towerHeight
	for i, size in { 15, 11, 7, 3.5 } do
		local h = if i == 4 then 10 else 7
		Geometry.Part(f, "Spire", Vector3.new(size, h, size), frame * CFrame.new(towerX, y + h / 2, 0), COPPER, Enum.Material.Metal)
		y += h
	end
	Geometry.Ball(f, "SpireTop", (frame * CFrame.new(towerX, y + 0.8, 0)).Position, 0.9, Color3.fromRGB(230, 190, 60))
	-- Klockfönster
	for _, side in { -1, 1 } do
		Geometry.Part(f, "Window", Vector3.new(4, 7, 0.4), frame * CFrame.new(towerX, towerHeight - 9, side * 8.1), Color3.fromRGB(40, 40, 45))
	end
end

-- Halmstads slott: ljus putsad borg vid Nissan, tre längor kring en gård öppen mot ån
function Landmarks.Castle(parent: Instance, center: Vector2, size: Vector2)
	local f = folder(parent, "HalmstadsSlott")
	local wall = Color3.fromRGB(232, 210, 160)
	local height = 26
	local frame = CFrame.new(center.X, ground(center.X, center.Y), center.Y)
	local wingDepth = 20
	-- Västra längan (huvudbyggnaden)
	local west = frame * CFrame.new(-size.X / 2 + wingDepth / 2, height / 2, 0)
	Geometry.Obstacle(Geometry.Part(f, "WestWing", Vector3.new(wingDepth, height, size.Y), west, wall, Enum.Material.Plaster))
	gableRoof(f, frame * CFrame.new(-size.X / 2 + wingDepth / 2, height, 0) * CFrame.Angles(0, math.rad(90), 0), size.Y + 2, wingDepth + 2, 10, DARK_ROOF)
	-- Norra och södra längorna
	for _, side in { -1, 1 } do
		local wingFrame = frame * CFrame.new(wingDepth / 2, 0, side * (size.Y / 2 - wingDepth / 2))
		Geometry.Obstacle(Geometry.Part(f, "Wing", Vector3.new(size.X - wingDepth, height - 4, wingDepth), wingFrame * CFrame.new(0, (height - 4) / 2, 0), wall, Enum.Material.Plaster))
		gableRoof(f, wingFrame * CFrame.new(0, height - 4, 0), size.X - wingDepth + 2, wingDepth + 2, 9, DARK_ROOF)
	end
	-- Trapptorn i hörnet
	local towerBase = (frame * CFrame.new(-size.X / 2 + 4, 0, -size.Y / 2 + 4)).Position
	Geometry.Obstacle(Geometry.Cylinder(f, "StairTower", towerBase, 6, height + 8, wall, Enum.Material.Plaster))
	Geometry.Cylinder(f, "TowerCap", towerBase + Vector3.new(0, height + 8, 0), 6.5, 2, DARK_ROOF)
	Geometry.Part(f, "TowerSpire", Vector3.new(4, 8, 4), CFrame.new(towerBase + Vector3.new(0, height + 14, 0)), COPPER, Enum.Material.Metal)
	Props.SwedishFlag(parent, (frame * CFrame.new(size.X / 2 - 6, 0, 0)).Position, 26)
end

-- Norre port: den gamla stadsporten i tegel, som Storgatan går igenom
function Landmarks.NorrePort(parent: Instance, position: Vector2, yaw: number)
	local f = folder(parent, "NorrePort")
	local frame = CFrame.new(position.X, ground(position.X, position.Y), position.Y) * CFrame.Angles(0, math.rad(yaw), 0)
	local gap = 22
	for _, side in { -1, 1 } do
		Geometry.Obstacle(Geometry.Part(f, "Pillar", Vector3.new(10, 26, 14), frame * CFrame.new(side * (gap / 2 + 5), 13, 0), BRICK, Enum.Material.Brick))
	end
	Geometry.Part(f, "Arch", Vector3.new(gap + 20, 9, 14), frame * CFrame.new(0, 26.5, 0), BRICK, Enum.Material.Brick)
	gableRoof(f, frame * CFrame.new(0, 31, 0), gap + 22, 16, 7, DARK_ROOF)
end

function Landmarks.LookoutTower(parent: Instance, at: Vector2)
	local f = folder(parent, "Utsiktstornet")
	local base = Vector3.new(at.X, ground(at.X, at.Y), at.Y)
	local stone = Color3.fromRGB(150, 140, 125)
	Geometry.Obstacle(Geometry.Part(f, "Tower", Vector3.new(12, 40, 12), CFrame.new(base + Vector3.new(0, 18, 0)), stone, Enum.Material.Cobblestone))
	Geometry.Part(f, "Battlements", Vector3.new(15, 3, 15), CFrame.new(base + Vector3.new(0, 39.5, 0)), stone, Enum.Material.Cobblestone)
	Props.SwedishFlag(f, base + Vector3.new(0, 41, 0), 10)
end

-- Hallandsgården: friluftsmuseum med faluröda stugor och gräsmark
function Landmarks.Hallandsgarden(parent: Instance, at: Vector2, rng: Random)
	local f = folder(parent, "Hallandsgarden")
	local offsets = { Vector2.new(-24, -14), Vector2.new(14, -18), Vector2.new(-10, 18), Vector2.new(24, 14) }
	for _, offset in offsets do
		local p = at + offset
		local frame = CFrame.new(p.X, ground(p.X, p.Y), p.Y) * CFrame.Angles(0, rng:NextNumber(-0.4, 0.4), 0)
		Geometry.Obstacle(Geometry.Part(f, "Cottage", Vector3.new(16, 8, 10), frame * CFrame.new(0, 4, 0), FALU_RED, Enum.Material.WoodPlanks))
		gableRoof(f, frame * CFrame.new(0, 8, 0), 17, 11, 5, Color3.fromRGB(70, 60, 50))
		for _, side in { -1, 1 } do
			Geometry.Part(f, "Corner", Vector3.new(0.5, 8, 0.5), frame * CFrame.new(side * 8, 4, 5.1), Color3.new(1, 1, 1))
		end
	end
end

-- Stadsbiblioteket: långsmal glasbyggnad på pelare, delvis över Nissan
function Landmarks.Library(parent: Instance, center: Vector2, yaw: number)
	local f = folder(parent, "Stadsbiblioteket")
	local frame = CFrame.new(center.X, 0, center.Y) * CFrame.Angles(0, math.rad(yaw), 0)
	local length, width, lift, height = 26, 90, 6, 14
	Geometry.Obstacle(
		Geometry.Part(f, "Glass", Vector3.new(length, height, width), frame * CFrame.new(0, lift + height / 2, 0), Color3.fromRGB(120, 170, 170), Enum.Material.Glass)
	).Transparency = 0.15
	Geometry.Part(f, "RoofSlab", Vector3.new(length + 2, 1, width + 2), frame * CFrame.new(0, lift + height + 0.5, 0), Color3.new(1, 1, 1))
	Geometry.Part(f, "FloorSlab", Vector3.new(length + 1, 1, width + 1), frame * CFrame.new(0, lift - 0.5, 0), Color3.new(1, 1, 1))
	for i = -3, 3 do
		Geometry.Cylinder(f, "Pillar", (frame * CFrame.new(0, -12, i * 13)).Position, 1, lift + 12, Color3.new(1, 1, 1), Enum.Material.Concrete)
	end
end

function Landmarks.Hotel(parent: Instance, at: Vector2)
	local f = folder(parent, "Strandhotellet")
	local body = Geometry.Part(f, "Body", Vector3.new(160, 30, 50), CFrame.new(at.X, 15, at.Y), Color3.fromRGB(245, 245, 240), Enum.Material.Plaster)
	Geometry.Obstacle(body)
	Geometry.Part(f, "Roof", Vector3.new(162, 2, 52), CFrame.new(at.X, 31, at.Y), DARK_ROOF)
	for floor = 1, 3 do
		Geometry.Part(f, "WindowBand", Vector3.new(160.4, 2.5, 50.4), CFrame.new(at.X, floor * 8, at.Y), Color3.fromRGB(60, 80, 100), Enum.Material.Glass)
	end
end

function Landmarks.Pier(parent: Instance, start: Vector2, length: number, width: number, name: string)
	local f = folder(parent, name)
	local wood = Color3.fromRGB(150, 110, 70)
	Geometry.Box(f, "Deck", Vector3.new(start.X - width / 2, -0.5, start.Y), Vector3.new(start.X + width / 2, 0.5, start.Y + length), wood, Enum.Material.WoodPlanks)
	for z = start.Y + 25, start.Y + length, 25 do
		for _, side in { -1, 1 } do
			Geometry.Cylinder(f, "Post", Vector3.new(start.X + side * (width / 2 - 1), -16, z), 1, 16, wood, Enum.Material.Wood)
		end
	end
end

-- Stranddetaljer: parasoller, badvakttorn, surfbrädor och volleybollnät
function Landmarks.Beach(parent: Instance, beach: { [string]: any }, rng: Random)
	local f = folder(parent, "Strand_" .. beach.Name)
	local min: Vector2, max: Vector2 = beach.Min, beach.Max
	local colors = {
		Color3.fromRGB(230, 70, 60),
		Color3.fromRGB(60, 130, 220),
		Color3.fromRGB(250, 200, 50),
		Color3.fromRGB(240, 240, 240),
		Color3.fromRGB(80, 180, 120),
	}
	local function keepClear(x: number): boolean
		for _, keep in beach.Keep do
			if math.abs(x - keep) < 25 then
				return true
			end
		end
		return false
	end
	for x = min.X + 20, max.X - 20, 55 do
		if not keepClear(x) and rng:NextNumber() < 0.7 then
			local z = rng:NextNumber(min.Y + 8, max.Y - 8)
			Props.Umbrella(f, Vector3.new(x, ground(x, z), z), colors[rng:NextInteger(1, #colors)])
		end
	end
	for _, x in beach.Lifeguards do
		Props.LifeguardTower(f, Vector3.new(x, 0, (min.Y + max.Y) / 2), 180)
	end
	local volley: Vector2 = beach.Volleyball
	Props.VolleyballNet(f, Vector3.new(volley.X, 0, volley.Y))
	local boards: Vector2 = beach.Surfboards
	for i = 0, 4 do
		Props.Surfboard(f, Vector3.new(boards.X + i * 3, 0, boards.Y), rng:NextNumber(-10, 10), colors[i % #colors + 1])
	end
end

return Landmarks
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Props</string><ProtectedString name="Source"><![CDATA[--!strict
-- Rekvisita: träd, tallar, gatlyktor, trafikljus, flaggor, skyltar, parasoller,
-- badvakttorn, surfbrädor, vindkraftverk, fyr, båt och bänkar.
-- Vindkraftverkens rotorer får taggen "Spinner" och roteras av klienten.

local CollectionService = game:GetService("CollectionService")

local Geometry = require(script.Parent.Geometry)

local Props = {}

local function yawCFrame(position: Vector3, yawDeg: number): CFrame
	return CFrame.new(position) * CFrame.Angles(0, math.rad(yawDeg), 0)
end

local function model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

function Props.Tree(parent: Instance, base: Vector3, rng: Random)
	local trunk = Geometry.Cylinder(parent, "TreeTrunk", base - Vector3.new(0, 1, 0), 1.2, 11, Color3.fromRGB(110, 80, 55), Enum.Material.Wood)
	Geometry.Obstacle(trunk)
	Geometry.Ball(parent, "TreeCrown", base + Vector3.new(0, 13, 0), rng:NextNumber(5, 7), Color3.fromRGB(70, 140, 70))
end

function Props.Pine(parent: Instance, base: Vector3, rng: Random)
	local height = rng:NextNumber(14, 20)
	local trunk = Geometry.Cylinder(parent, "PineTrunk", base - Vector3.new(0, 2, 0), 1, height * 0.5 + 2, Color3.fromRGB(100, 70, 50), Enum.Material.Wood)
	Geometry.Obstacle(trunk)
	local green = Color3.fromRGB(40, 100, 60)
	Geometry.Ball(parent, "PineLow", base + Vector3.new(0, height * 0.5, 0), height * 0.32, green)
	Geometry.Ball(parent, "PineHigh", base + Vector3.new(0, height * 0.85, 0), height * 0.22, green)
end

-- Gatlykta. `towardRoad` är riktningen från stolpen ut över gatan.
function Props.StreetLamp(parent: Instance, base: Vector3, towardRoad: Vector3)
	local m = model(parent, "StreetLamp")
	local grey = Color3.fromRGB(60, 62, 70)
	Geometry.Obstacle(Geometry.Cylinder(m, "Pole", base, 0.35, 16, grey, Enum.Material.Metal))
	local top = base + Vector3.new(0, 16, 0)
	local tip = top + towardRoad * 5
	Geometry.Between(m, "Arm", top, tip, 0.4, grey, Enum.Material.Metal)
	Geometry.Decor(Geometry.Part(m, "Light", Vector3.new(1.6, 0.5, 2.6), CFrame.lookAt(tip - Vector3.new(0, 0.4, 0), tip + towardRoad - Vector3.new(0, 0.4, 0)), Color3.fromRGB(255, 225, 170), Enum.Material.Neon))
end

-- Trafikljus på stolpe med arm ut över vägen. Lampan vänds mot `facing`.
function Props.TrafficLight(parent: Instance, base: Vector3, overRoad: Vector3, facing: Vector3)
	local m = model(parent, "TrafficLight")
	local dark = Color3.fromRGB(40, 40, 45)
	Geometry.Obstacle(Geometry.Cylinder(m, "Pole", base, 0.45, 15, dark, Enum.Material.Metal))
	local top = base + Vector3.new(0, 14.5, 0)
	local tip = top + overRoad * 9
	Geometry.Between(m, "Arm", top, tip, 0.5, dark, Enum.Material.Metal)
	local box = CFrame.lookAt(tip - Vector3.new(0, 2.6, 0), tip - Vector3.new(0, 2.6, 0) + facing)
	Geometry.Part(m, "Box", Vector3.new(1.8, 5, 1.2), box, dark)
	local colors = {
		{ Color3.fromRGB(90, 20, 20), 1.6 },
		{ Color3.fromRGB(90, 70, 20), 0 },
		{ Color3.fromRGB(60, 255, 120), -1.6 },
	}
	for _, info in colors do
		Geometry.Decor(Geometry.Part(m, "Lamp", Vector3.new(1.1, 1.1, 0.3), box * CFrame.new(0, info[2], -0.65), info[1], Enum.Material.Neon))
	end
end

-- Gatuskylt med två blad, ett per gata. Varje blad är parallellt med sin gata.
function Props.StreetNameSign(parent: Instance, base: Vector3, roads: { { Name: string, Direction: Vector3 } })
	local m = model(parent, "StreetSign")
	local green = Color3.fromRGB(20, 110, 60)
	Geometry.Obstacle(Geometry.Cylinder(m, "Pole", base, 0.25, 11, Color3.fromRGB(150, 150, 155), Enum.Material.Metal))
	for i, road in roads do
		if i > 2 then
			break
		end
		local position = base + Vector3.new(0, 11 - i * 1.8, 0)
		local blade = Geometry.Part(m, "Blade", Vector3.new(10, 1.5, 0.25), CFrame.fromMatrix(position, road.Direction, Vector3.yAxis), green)
		Geometry.Label(blade, Enum.NormalId.Front, road.Name, nil, green)
		Geometry.Label(blade, Enum.NormalId.Back, road.Name, nil, green)
	end
end

function Props.SwedishFlag(parent: Instance, base: Vector3, height: number)
	local m = model(parent, "Flag")
	Geometry.Obstacle(Geometry.Cylinder(m, "Pole", base, 0.3, height, Color3.new(1, 1, 1), Enum.Material.Metal))
	local width, flagHeight = 8, 5
	local center = base + Vector3.new(width / 2 + 0.3, height - flagHeight / 2 - 0.5, 0)
	local blue = Color3.fromRGB(0, 90, 170)
	local yellow = Color3.fromRGB(255, 205, 0)
	Geometry.Part(m, "Field", Vector3.new(width, flagHeight, 0.2), CFrame.new(center), blue)
	-- Korset: proportioner 5:2:9 på bredden, 4:2:4 på höjden
	local unitX = width / 16
	local crossX = center.X - width / 2 + unitX * 6
	Geometry.Part(m, "CrossV", Vector3.new(unitX * 2, flagHeight, 0.25), CFrame.new(crossX, center.Y, center.Z), yellow)
	Geometry.Part(m, "CrossH", Vector3.new(width, flagHeight / 5, 0.25), CFrame.new(center), yellow)
	for _, part in m:GetChildren() do
		if part:IsA("BasePart") and part.Name ~= "Pole" then
			Geometry.Decor(part)
		end
	end
end

-- Skyltar. Framsidan vänds åt `yaw` (0 = norr).
function Props.Sign(parent: Instance, kind: string, text: string, subText: string?, position: Vector3, yaw: number, width: number, color: Color3, textColor: Color3?)
	local m = model(parent, "Sign_" .. text)
	local frame = yawCFrame(position, yaw)
	local metal = Color3.fromRGB(170, 170, 175)
	if kind == "Arch" then
		local height = 22
		for _, side in { -1, 1 } do
			Geometry.Obstacle(Geometry.Part(m, "Post", Vector3.new(2, height, 2), frame * CFrame.new(side * width / 2, height / 2, 0), metal, Enum.Material.Metal))
		end
		local board = Geometry.Part(m, "Board", Vector3.new(width + 2, 7, 1), frame * CFrame.new(0, height + 2.5, 0), color)
		Geometry.Label(board, Enum.NormalId.Front, text, subText, color, textColor)
		Geometry.Label(board, Enum.NormalId.Back, text, subText, color, textColor)
		return
	end

	local boardHeight, bottom = 4, 1
	if kind == "Billboard" then
		boardHeight, bottom = width * 0.4, 10
	elseif kind == "Highway" then
		boardHeight, bottom = width * 0.4, 8
	elseif kind == "Plaque" then
		boardHeight, bottom = 4, 1.5
	end
	for _, side in { -1, 1 } do
		Geometry.Obstacle(Geometry.Part(m, "Post", Vector3.new(1, bottom + boardHeight / 2, 1), frame * CFrame.new(side * width * 0.3, (bottom + boardHeight / 2) / 2, 0.8), metal, Enum.Material.Metal))
	end
	local board = Geometry.Part(m, "Board", Vector3.new(width, boardHeight, 1), frame * CFrame.new(0, bottom + boardHeight / 2, 0), color)
	Geometry.Label(board, Enum.NormalId.Front, text, subText, color, textColor)
end

function Props.Umbrella(parent: Instance, base: Vector3, color: Color3)
	local m = model(parent, "Umbrella")
	Geometry.Cylinder(m, "Pole", base, 0.2, 7, Color3.new(1, 1, 1))
	Geometry.Cylinder(m, "Canopy", base + Vector3.new(0, 7, 0), 4.5, 0.5, color, Enum.Material.Fabric)
	Geometry.Part(m, "Towel", Vector3.new(3, 0.1, 6), CFrame.new(base + Vector3.new(3, 0.1, 1)), color, Enum.Material.Fabric).CanCollide = false
end

function Props.LifeguardTower(parent: Instance, base: Vector3, yaw: number)
	local m = model(parent, "LifeguardTower")
	local frame = yawCFrame(base, yaw)
	local wood = Color3.fromRGB(230, 225, 210)
	for _, dx in { -2.5, 2.5 } do
		for _, dz in { -2.5, 2.5 } do
			Geometry.Obstacle(Geometry.Part(m, "Leg", Vector3.new(0.6, 8, 0.6), frame * CFrame.new(dx, 4, dz), wood, Enum.Material.Wood))
		end
	end
	local cabin = Geometry.Part(m, "Cabin", Vector3.new(7, 4.5, 7), frame * CFrame.new(0, 10.25, 0), Color3.fromRGB(240, 70, 60), Enum.Material.WoodPlanks)
	Geometry.Label(cabin, Enum.NormalId.Front, "LIVRÄDDNING", nil, Color3.fromRGB(240, 70, 60))
	Geometry.Part(m, "Roof", Vector3.new(8.5, 0.6, 8.5), frame * CFrame.new(0, 12.8, 0), Color3.new(1, 1, 1))
	Geometry.Between(m, "Ramp", (frame * CFrame.new(0, 8, 3.5)).Position, (frame * CFrame.new(0, 0, 11)).Position, 2.4, wood, Enum.Material.WoodPlanks)
end

function Props.Surfboard(parent: Instance, base: Vector3, yaw: number, color: Color3)
	local board = Geometry.Part(parent, "Surfboard", Vector3.new(2.2, 7, 0.4), yawCFrame(base + Vector3.new(0, 2.8, 0), yaw) * CFrame.Angles(math.rad(-8), 0, 0), color)
	Geometry.Obstacle(board)
end

function Props.VolleyballNet(parent: Instance, center: Vector3)
	local m = model(parent, "Volleyball")
	for _, dx in { -9, 9 } do
		Geometry.Obstacle(Geometry.Cylinder(m, "Pole", center + Vector3.new(dx, 0, 0), 0.3, 8, Color3.new(1, 1, 1)))
	end
	local net = Geometry.Part(m, "Net", Vector3.new(18, 3, 0.1), CFrame.new(center + Vector3.new(0, 6.5, 0)), Color3.new(1, 1, 1))
	net.Transparency = 0.5
	Geometry.Decor(net)
end

function Props.WindTurbine(parent: Instance, base: Vector3, yaw: number)
	local m = model(parent, "WindTurbine")
	local white = Color3.fromRGB(240, 240, 245)
	local height = 90
	Geometry.Obstacle(Geometry.Cylinder(m, "Tower", base - Vector3.new(0, 1, 0), 2.5, height + 1, white, Enum.Material.Concrete))
	local hubFrame = yawCFrame(base + Vector3.new(0, height + 2, 0), yaw)
	Geometry.Part(m, "Nacelle", Vector3.new(4, 4, 11), hubFrame * CFrame.new(0, 0, 3), white)

	local rotor = model(m, "Rotor")
	local rotorFrame = hubFrame * CFrame.new(0, 0, -3)
	Geometry.Part(rotor, "Hub", Vector3.new(3, 3, 3), rotorFrame, white)
	for i = 0, 2 do
		Geometry.Part(rotor, "Blade", Vector3.new(2, 34, 0.5), rotorFrame * CFrame.Angles(0, 0, i * math.pi * 2 / 3) * CFrame.new(0, 18, 0), white)
	end
	rotor.WorldPivot = rotorFrame
	rotor:SetAttribute("SpinSpeed", 0.8)
	CollectionService:AddTag(rotor, "Spinner")
end

function Props.Lighthouse(parent: Instance, base: Vector3)
	local m = model(parent, "Fyren")
	local colors = { Color3.fromRGB(220, 40, 40), Color3.new(1, 1, 1) }
	for i = 0, 5 do
		local radius = 5 - i * 0.3
		Geometry.Obstacle(Geometry.Cylinder(m, "Section", base + Vector3.new(0, i * 6, 0), radius, 6, colors[i % 2 + 1], Enum.Material.Concrete))
	end
	Geometry.Cylinder(m, "Gallery", base + Vector3.new(0, 36, 0), 4.5, 1, Color3.fromRGB(40, 40, 45), Enum.Material.Metal)
	Geometry.Ball(m, "Lantern", base + Vector3.new(0, 39, 0), 2.8, Color3.fromRGB(255, 230, 120)).Material = Enum.Material.Neon
	Geometry.Cylinder(m, "Cap", base + Vector3.new(0, 41.5, 0), 3, 1.5, Color3.fromRGB(220, 40, 40))
end

function Props.Ship(parent: Instance, center: Vector3, length: number, width: number, name: string)
	local m = model(parent, "Ship")
	local hull = Geometry.Part(m, "Hull", Vector3.new(length, 14, width), CFrame.new(center + Vector3.new(0, 1, 0)), Color3.fromRGB(30, 60, 120), Enum.Material.Metal)
	Geometry.Label(hull, Enum.NormalId.Front, name, nil, Color3.fromRGB(30, 60, 120))
	Geometry.Part(m, "Stripe", Vector3.new(length + 0.2, 1.5, width + 0.2), CFrame.new(center + Vector3.new(0, 6, 0)), Color3.new(1, 1, 1))
	Geometry.Part(m, "Deck", Vector3.new(length - 4, 0.5, width - 2), CFrame.new(center + Vector3.new(0, 8.2, 0)), Color3.fromRGB(150, 110, 70), Enum.Material.WoodPlanks)
	local bridge = center + Vector3.new(length * 0.28, 8, 0)
	Geometry.Part(m, "Superstructure", Vector3.new(40, 14, width - 6), CFrame.new(bridge + Vector3.new(0, 7, 0)), Color3.new(1, 1, 1))
	Geometry.Part(m, "Windows", Vector3.new(40.4, 2.5, width - 5.6), CFrame.new(bridge + Vector3.new(0, 11, 0)), Color3.fromRGB(40, 60, 80), Enum.Material.Glass)
	Geometry.Cylinder(m, "Funnel", bridge + Vector3.new(6, 14, 0), 3.5, 10, Color3.fromRGB(250, 200, 40))
	Geometry.Cylinder(m, "FunnelTop", bridge + Vector3.new(6, 24, 0), 3.6, 2, Color3.fromRGB(30, 30, 30))
end

function Props.Bench(parent: Instance, base: Vector3, yaw: number)
	local bench = Geometry.Part(parent, "Bench", Vector3.new(6, 1.6, 2), yawCFrame(base + Vector3.new(0, 0.8, 0), yaw), Color3.fromRGB(140, 100, 60), Enum.Material.WoodPlanks)
	Geometry.Obstacle(bench)
end

return Props
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000020"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">CrashService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Krockar och takedowns på servern:
--  * Kvaddade spelarbilar flyttas tillbaka till gatan (ReportWreck, med cooldown).
--    Under ett race tar RespawnService:s override hand om var bilen hamnar.
--  * Takedowns räknas här, syns i leaderstats och ger pengar. Klienten kan aldrig själv
--    rapportera en takedown: NpcService och RaceService avgör utifrån vad servern ser.

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EconomyConfig = require(ReplicatedStorage.Shared.Config.EconomyConfig)
local VehicleConfig = require(ReplicatedStorage.Shared.Config.VehicleConfig)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Leaderstats = require(script.Parent.Parent.Util.Leaderstats)
local EconomyService = require(script.Parent.EconomyService)
local RespawnService = require(script.Parent.RespawnService)

local CrashService = {}

type WreckListener = (player: Player) -> ()
type TakedownListener = (player: Player, victim: BasePart) -> ()

local lastWreck: { [Player]: number } = {}
local wreckListeners: { WreckListener } = {}
local takedownListeners: { TakedownListener } = {}
local takedownRemote: RemoteEvent

-- Lyssnare som vill veta när en spelare kvaddats (t.ex. RaceService för takedowns mellan spelare).
function CrashService.OnWrecked(listener: WreckListener)
	table.insert(wreckListeners, listener)
end

function CrashService.OnTakedown(listener: TakedownListener)
	table.insert(takedownListeners, listener)
end

local function onReportWreck(player: Player)
	local now = os.clock()
	if now - (lastWreck[player] or -math.huge) < VehicleConfig.Crash.ReportWreckCooldown then
		return
	end
	lastWreck[player] = now
	for _, listener in wreckListeners do
		task.spawn(listener, player)
	end
	RespawnService.RespawnOnRoad(player, "Back in action!")
end

-- `victim` är chassit på bilen som togs ut (NPC eller annan racedeltagare).
function CrashService.AwardTakedown(player: Player, victim: BasePart)
	if player.Parent ~= Players then
		return
	end
	Leaderstats.Get(player, "Takedowns").Value += 1
	EconomyService.AddMoney(player, EconomyConfig.TakedownReward, "Takedown")
	takedownRemote:FireClient(player, victim)
	for _, listener in takedownListeners do
		task.spawn(listener, player, victim)
	end
end

function CrashService.Init()
	-- Klientens lokala plåtdelar ska inte påverka bilarna
	for _, group in { "Debris", VehicleConfig.CollisionGroup } do
		if not PhysicsService:IsCollisionGroupRegistered(group) then
			PhysicsService:RegisterCollisionGroup(group)
		end
	end
	PhysicsService:CollisionGroupSetCollidable("Debris", VehicleConfig.CollisionGroup, false)
	PhysicsService:CollisionGroupSetCollidable("Debris", "Debris", false)
	takedownRemote = Remotes.Get("Takedown")
	Remotes.Get("CrashEffect")
	Remotes.Get("ReportWreck").OnServerEvent:Connect(onReportWreck)
end

function CrashService.Start()
	local function onPlayer(player: Player)
		Leaderstats.Get(player, "Takedowns")
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastWreck[player] = nil
	end)
end

return CrashService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Spelarnas pengar (kronor). Fas 4: bara i minnet. Fas 5 sparar med DataStore.
-- All ändring av saldot går genom den här modulen och sker bara på servern.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EconomyConfig = require(ReplicatedStorage.Shared.Config.EconomyConfig)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Leaderstats = require(script.Parent.Parent.Util.Leaderstats)

local EconomyService = {}

local notifyRemote: RemoteEvent

function EconomyService.GetMoney(player: Player): number
	return Leaderstats.Get(player, EconomyConfig.Currency).Value
end

-- Betalar ut ett belopp. `reason` visas för spelaren.
function EconomyService.AddMoney(player: Player, amount: number, reason: string?): boolean
	if player.Parent ~= Players then
		return false
	end
	if typeof(amount) ~= "number" or amount ~= amount or amount <= 0 or amount > EconomyConfig.MaxSingleReward then
		warn(("[EconomyService] Ogiltigt belopp %s till %s"):format(tostring(amount), player.Name))
		return false
	end
	local rounded = math.floor(amount)
	local stat = Leaderstats.Get(player, EconomyConfig.Currency)
	stat.Value += rounded
	notifyRemote:FireClient(player, ("+%d kr%s"):format(rounded, if reason then "  " .. reason else ""), "money")
	return true
end

function EconomyService.Init()
	notifyRemote = Remotes.Get("Notify")
end

function EconomyService.Start()
	local function onPlayer(player: Player)
		Leaderstats.Get(player, EconomyConfig.Currency).Value = EconomyConfig.StartMoney
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">MapService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Bygger Halmstad när servern startar: terräng och hus från stadskartan (CityBuilder),
-- landmärken, skyltar, stränder och områdena utanför kartan.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MapData = require(ReplicatedStorage.Shared.Map.MapData)
local CityBuilder = require(script.Parent.Parent.Map.CityBuilder)
local Geometry = require(script.Parent.Parent.Map.Geometry)
local Landmarks = require(script.Parent.Parent.Map.Landmarks)
local Props = require(script.Parent.Parent.Map.Props)
local RespawnService = require(script.Parent.RespawnService)
local VehicleService = require(script.Parent.VehicleService)

local MapService = {}

local MAP_SEED = 1307

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Svensk sommareftermiddag: hög sol, klar luft, lite dis mot havet.
local function setupLighting()
	Lighting.ClockTime = 15.5
	Lighting.GeographicLatitude = 56.7 -- Halmstad
	Lighting.Brightness = 2.6
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.OutdoorAmbient = Color3.fromRGB(130, 135, 145)
	Lighting.Ambient = Color3.fromRGB(60, 62, 70)

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(200, 215, 230)
	atmosphere.Decay = Color3.fromRGB(110, 130, 160)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting

	local correction = Instance.new("ColorCorrectionEffect")
	correction.Saturation = 0.08
	correction.Contrast = 0.05
	correction.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.3
	bloom.Size = 20
	bloom.Threshold = 1.8
	bloom.Parent = Lighting

	local clouds = Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.6
	clouds.Parent = workspace.Terrain
end

local function buildLandmarks(map: Folder, rng: Random)
	local landmarks = folder(map, "Landmarks")
	local data = MapData.Landmarks
	Landmarks.Fountain(landmarks, Vector2.new(0, 0))
	Landmarks.Church(landmarks, data.Church.Center, data.Church.Length, data.Church.Width)
	Landmarks.Castle(landmarks, data.Castle.Center, data.Castle.Size)
	Landmarks.NorrePort(landmarks, data.NorrePort.Position, data.NorrePort.Yaw)
	Landmarks.LookoutTower(landmarks, data.LookoutTower)
	Landmarks.Hallandsgarden(landmarks, data.Hallandsgarden, rng)
	Landmarks.Library(landmarks, data.Library.Center, data.Library.Yaw)
	Landmarks.Hotel(landmarks, data.Hotel)
	Landmarks.Pier(landmarks, data.Pier.Start, data.Pier.Length, data.Pier.Width, "Badbryggan")

	-- Piren vid Nissans mynning med fyr, och en båt ute på redden
	local breakwater = data.Breakwater
	Geometry.Box(
		landmarks,
		"Pir",
		Vector3.new(breakwater.Start.X - breakwater.Width / 2, -16, breakwater.Start.Y),
		Vector3.new(breakwater.Start.X + breakwater.Width / 2, 1, breakwater.Start.Y + breakwater.Length),
		Color3.fromRGB(140, 140, 140),
		Enum.Material.Concrete
	)
	Props.Lighthouse(landmarks, Vector3.new(breakwater.Start.X, 1, breakwater.Start.Y + breakwater.Length - 8))
	local ship = data.Ship
	Props.Ship(landmarks, Vector3.new(ship.Center.X, -4, ship.Center.Y), ship.Length, ship.Width, ship.Name)

	for _, position in data.WindTurbines do
		Props.WindTurbine(landmarks, Vector3.new(position.X, 0, position.Y), 0)
	end

	for _, beach in MapData.Beaches do
		Landmarks.Beach(landmarks, beach :: any, rng)
	end
end

local function buildSigns(map: Folder)
	local signs = folder(map, "Signs")
	for _, sign in MapData.Signs do
		local p = sign.Position
		local position = Vector3.new(p.X, MapData.GroundHeightAt(p.X, p.Z), p.Z)
		Props.Sign(signs, sign.Kind, sign.Text, sign.SubText, position, sign.Yaw, sign.Width, sign.Color, sign.TextColor)
	end
end

-- Lövträd längs landsvägen mot Tylösand
local function buildRoadsideTrees(map: Folder, rng: Random)
	local trees = folder(map, "Trees")
	for _, road in MapData.ExtraRoads do
		for i = 1, #road.Points - 1 do
			local a, b = road.Points[i], road.Points[i + 1]
			local direction = (b - a).Unit
			local side = Vector2.new(-direction.Y, direction.X)
			for distance = 30, (b - a).Magnitude - 30, 50 do
				for _, sign in { -1, 1 } do
					if rng:NextNumber() < 0.7 then
						local p = a + direction * distance + side * sign * (road.Width / 2 + rng:NextNumber(8, 18))
						Props.Tree(trees, Vector3.new(p.X, 0, p.Y), rng)
					end
				end
			end
		end
	end
	-- Tallskog på Galgberget
	local hill = MapData.Hills[1]
	for _ = 1, 70 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(hill.FlatRadius + 20, hill.Radius * 0.8)
		local x = hill.Center.X + math.cos(angle) * r
		local z = hill.Center.Y + math.sin(angle) * r
		if CityBuilder.CodeAt(x, z) == "P" or CityBuilder.CodeAt(x, z) == nil then
			Props.Pine(trees, Vector3.new(x, MapData.GroundHeightAt(x, z), z), rng)
		end
	end
end

local function buildSpawn(map: Folder)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlayerSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.CFrame = CFrame.new(40, 0.5, 0)
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.CanQuery = false
	spawn.Parent = map
end

local function registerRespawnPoints()
	RespawnService.AddPoints(CityBuilder.RoadPoints())
	-- Punkter längs vägarna utanför stadskartan
	local points = {}
	for _, road in MapData.ExtraRoads do
		for i = 1, #road.Points - 1 do
			local a, b = road.Points[i], road.Points[i + 1]
			local direction = (b - a).Unit
			local yaw = math.deg(math.atan2(-direction.X, -direction.Y))
			for distance = 0, (b - a).Magnitude, 50 do
				local p = a + direction * distance
				table.insert(points, { Position = Vector3.new(p.X, 0, p.Y), Yaw = yaw })
			end
		end
	end
	RespawnService.AddPoints(points)
end

function MapService.Init()
	local started = os.clock()
	setupLighting()

	local rng = Random.new(MAP_SEED)
	local map = folder(workspace, "Halmstad")
	CityBuilder.BuildTerrain()
	local terrainTime = os.clock() - started
	local buildingCount = CityBuilder.BuildBuildings(map)
	buildLandmarks(map, rng)
	buildSigns(map)
	buildRoadsideTrees(map, rng)
	buildSpawn(map)
	registerRespawnPoints()

	VehicleService.SetSpawnProvider(MapData.PlayerSpawn)
	print(
		("[MapService] Halmstad byggt på %.1f s (terräng %.1f s, %d hus)"):format(os.clock() - started, terrainTime, buildingCount)
	)
end

function MapService.Start() end

return MapService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">NpcService</string><ProtectedString name="Source"><![CDATA[--!strict
-- NPC-bilar som kör runt på Halmstads huvudgator (rutter från tools/map/build_city.py).
-- Servern äger deras fysik. De använder samma raycast-fjädring som spelarbilarna.
--
-- Takedowns avgörs här: när en NPC-bil får en hård smäll och en spelarbil var nära,
-- eller välter/kvaddas inom några sekunder efter en knuff, räknas det som en takedown.

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local MapData = require(ReplicatedStorage.Shared.Map.MapData)
local VehicleConfig = require(ReplicatedStorage.Shared.Config.VehicleConfig)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Suspension = require(ReplicatedStorage.Shared.Vehicle.Suspension)
local CarBuilder = require(script.Parent.Parent.Vehicle.CarBuilder)
local CityRoutes = require(script.Parent.Parent.Map.Generated.CityRoutes)
local CrashService = require(script.Parent.CrashService)
local VehicleService = require(script.Parent.VehicleService)

local N = VehicleConfig.Npc

export type Npc = {
	Kind: string, -- "Traffic" | "Racer"
	Speed: number, -- marschfart
	SpeedScale: number, -- justeras av RaceService (rubber band)
	Passed: number, -- antal passerade ruttpunkter (racets framsteg)
	WreckDuration: number,
	Model: Model,
	Chassis: BasePart,
	Wheels: { Suspension.Wheel },
	RayParams: RaycastParams,
	Route: { Vector2 },
	Index: number,
	Mode: string, -- "Drive" | "Wrecked"
	WreckedAt: number,
	StuckTime: number,
	LastSetVelocity: Vector3?,
	LastHitter: Player?,
	LastHitTime: number,
}

local NpcService = {}

local npcs: { Npc } = {}
local routes: { [string]: { Vector2 } } = {}
local crashEffectRemote: RemoteEvent
local folder: Folder

local function decodeRoute(encoded: string): { Vector2 }
	local points = {}
	for x, z in encoded:gmatch("(%-?%d+),(%-?%d+)") do
		table.insert(points, Vector2.new(tonumber(x) :: number, tonumber(z) :: number))
	end
	return points
end

local function moveToward(value: number, target: number, maxDelta: number): number
	if value < target then
		return math.min(value + maxDelta, target)
	end
	return math.max(value - maxDelta, target)
end

local function setGroup(root: Instance)
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = N.CollisionGroup
		end
	end
end

-- Enkel förare (två block) så att NPC-bilarna inte ser förarlösa ut.
local function addDriver(model: Model, chassis: BasePart, rng: Random)
	local seat = model:FindFirstChild("DriverSeat") :: BasePart?
	if not seat then
		return
	end
	local shirt = Color3.fromHSV(rng:NextNumber(), 0.5, 0.8)
	local parts = {
		{ Vector3.new(2, 2.2, 1.2), CFrame.new(0, 1.4, 0), shirt },
		{ Vector3.new(1.3, 1.3, 1.3), CFrame.new(0, 3.2, 0), Color3.fromRGB(240, 200, 160) },
	}
	for _, info in parts do
		local part = Instance.new("Part")
		part.Name = "Driver"
		part.Size = info[1]
		part.CFrame = seat.CFrame * info[2]
		part.Color = info[3]
		part.CanCollide = false
		part.CanQuery = false
		part.Massless = true
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = chassis
		weld.Part1 = part
		weld.Parent = part
		part.Parent = model
	end
end

local function cframeAt(route: { Vector2 }, index: number): CFrame
	local point = route[index]
	local nextPoint = route[index % #route + 1]
	local y = MapData.GroundHeightAt(point.X, point.Y) + 4
	local position = Vector3.new(point.X, y, point.Y)
	local ahead = Vector3.new(nextPoint.X, y, nextPoint.Y)
	return CFrame.lookAt(position, ahead)
end

-- Väljer en ruttpunkt långt från spelare (så att ingen ser bilen dyka upp).
local function chooseSpawnIndex(route: { Vector2 }, preferred: number): number
	local carPositions = {}
	for _, car in VehicleService.GetCars() do
		if car.PrimaryPart then
			table.insert(carPositions, car.PrimaryPart.Position)
		end
	end
	for offset = 0, #route - 1 do
		local index = (preferred + offset - 1) % #route + 1
		local point = route[index]
		local clear = true
		for _, position in carPositions do
			if (Vector2.new(position.X, position.Z) - point).Magnitude < N.MinSpawnDistance then
				clear = false
				break
			end
		end
		if clear then
			return index
		end
	end
	return preferred
end

local function placeNpc(npc: Npc, index: number)
	npc.Index = index % #npc.Route + 1
	npc.Model:PivotTo(cframeAt(npc.Route, index))
	npc.Chassis.AssemblyLinearVelocity = Vector3.zero
	npc.Chassis.AssemblyAngularVelocity = Vector3.zero
	npc.Mode = "Drive"
	npc.StuckTime = 0
	npc.LastSetVelocity = nil
	npc.LastHitter = nil
end

local function respawnNpc(npc: Npc)
	if npc.Kind == "Racer" then
		-- Tävlingsbilar kommer tillbaka strax bakom där de kvaddades
		local back = 3
		npc.Passed -= back
		placeNpc(npc, (npc.Index - 1 - back - 1) % #npc.Route + 1)
		return
	end
	placeNpc(npc, chooseSpawnIndex(npc.Route, npc.Index + math.floor(#npc.Route / 3)))
end

local function spawnNpc(route: { Vector2 }, index: number, color: Color3, rng: Random): Npc
	local model = CarBuilder.Build(color, 0)
	model.Name = "NpcCar"
	model:SetAttribute("IsNpc", true)
	local chassis = model.PrimaryPart :: BasePart
	chassis:SetAttribute("Obstacle", true) -- nära-ögat-boost när man susar förbi trafiken
	addDriver(model, chassis, rng)
	setGroup(model)

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { model }
	rayParams.RespectCanCollide = true
	rayParams.CollisionGroup = N.CollisionGroup

	local npc: Npc = {
		Kind = "Traffic",
		Speed = N.CruiseSpeed,
		SpeedScale = 1,
		Passed = 0,
		WreckDuration = N.WreckDuration,
		Model = model,
		Chassis = chassis,
		Wheels = Suspension.FindWheels(chassis),
		RayParams = rayParams,
		Route = route,
		Index = index,
		Mode = "Drive",
		WreckedAt = 0,
		StuckTime = 0,
		LastSetVelocity = nil,
		LastHitter = nil,
		LastHitTime = 0,
	}
	model:PivotTo(cframeAt(route, index))
	model.Parent = folder
	chassis:SetNetworkOwner(nil)
	placeNpc(npc, index)
	table.insert(npcs, npc)
	return npc
end

local function nearestPlayerCar(position: Vector3): Player?
	local best: Player? = nil
	local bestDistance = N.HitRadius
	for player, car in VehicleService.GetCars() do
		local root = car.PrimaryPart
		if root then
			local distance = (root.Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = player, distance
			end
		end
	end
	return best
end

local function wreckNpc(npc: Npc, strength: number, now: number)
	npc.Mode = "Wrecked"
	npc.WreckedAt = now
	Suspension.Release(npc.Wheels)
	local root = npc.Chassis
	-- Tecknad krock: bilen studsar upp och snurrar
	local mass = root.AssemblyMass
	root:ApplyImpulse(Vector3.new(0, mass * 45, 0))
	root:ApplyAngularImpulse(Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * mass * 60)
	crashEffectRemote:FireAllClients(root.Position, strength)

	local hitter = npc.LastHitter
	if hitter and now - npc.LastHitTime <= N.TakedownWindow then
		CrashService.AwardTakedown(hitter, root)
	end
end

local function updateNpc(npc: Npc, dt: number, now: number)
	local root = npc.Chassis
	local cf = root.CFrame
	local position = cf.Position
	local velocity = root.AssemblyLinearVelocity
	local angular = root.AssemblyAngularVelocity

	if npc.Mode == "Wrecked" then
		if now - npc.WreckedAt > npc.WreckDuration then
			respawnNpc(npc)
		end
		return
	end

	if position.Y < MapData.WaterLevel + 1 or not MapData.IsInBounds(position) then
		respawnNpc(npc)
		return
	end

	-- Smällar: jämför med hastigheten vi själva satte förra rutan
	local previous = npc.LastSetVelocity
	if previous then
		local change = ((velocity - previous) * Vector3.new(1, 0, 1)).Magnitude
		if change > N.ImpactThreshold then
			local hitter = nearestPlayerCar(position)
			if hitter then
				npc.LastHitter = hitter
				npc.LastHitTime = now
			end
			if change > N.WreckImpact then
				wreckNpc(npc, change, now)
				return
			end
		end
	end
	if cf.UpVector.Y < 0.3 then
		wreckNpc(npc, 40, now)
		return
	end

	local grounded, normalSum = Suspension.Update(root, npc.Wheels, npc.RayParams)
	if grounded < 2 then
		npc.LastSetVelocity = nil
		return
	end

	-- Följ rutten
	local route = npc.Route
	local flat = Vector2.new(position.X, position.Z)
	local target = route[npc.Index]
	local guard = 0
	while (target - flat).Magnitude < N.WaypointRadius and guard < 5 do
		npc.Index = npc.Index % #route + 1
		npc.Passed += 1
		target = route[npc.Index]
		guard += 1
	end
	local after = route[npc.Index % #route + 1]
	local toTarget = target - flat
	local toTarget3 = Vector3.new(toTarget.X, 0, toTarget.Y).Unit
	local segment = (after - target)
	local segment3 = Vector3.new(segment.X, 0, segment.Y).Unit
	local turn = math.acos(math.clamp(toTarget3:Dot(segment3), -1, 1))
	local targetSpeed = npc.Speed * npc.SpeedScale * (1 - math.min(turn / (math.pi / 2), 0.6))

	local normal = (normalSum / grounded).Unit
	local forward = cf.LookVector - normal * cf.LookVector:Dot(normal)
	forward = if forward.Magnitude > 1e-3 then forward.Unit else cf.LookVector
	local right = forward:Cross(normal)
	local vF = velocity:Dot(forward)
	local vR = velocity:Dot(right)
	local vN = velocity:Dot(normal)

	vF = moveToward(vF, targetSpeed, N.Acceleration * dt)
	vR *= math.exp(-N.Grip * dt)

	local flatLook = (forward * Vector3.new(1, 0, 1)).Unit
	local yawError = math.atan2(flatLook:Cross(toTarget3).Y, flatLook:Dot(toTarget3))
	local targetYaw = math.clamp(yawError * N.TurnGain, -N.MaxYawRate, N.MaxYawRate)
	local currentYaw = angular:Dot(normal)
	angular += normal * ((targetYaw - currentYaw) * (1 - math.exp(-N.YawResponse * dt)))

	velocity = forward * vF + right * vR + normal * vN
	root.AssemblyLinearVelocity = velocity
	root.AssemblyAngularVelocity = angular
	npc.LastSetVelocity = velocity

	if velocity.Magnitude < 4 then
		npc.StuckTime += dt
		if npc.StuckTime > N.StuckTime then
			respawnNpc(npc)
		end
	else
		npc.StuckTime = 0
	end
end

function NpcService.GetRoute(name: string): { Vector2 }?
	return routes[name]
end

-- NPC-motståndare i ett race. Startar vid ruttpunkt `index` och kör med farten `speed`.
function NpcService.SpawnRacer(routeName: string, index: number, color: Color3, speed: number, wreckDuration: number): Npc?
	local route = routes[routeName]
	if not route then
		return nil
	end
	local npc = spawnNpc(route, index, color, Random.new())
	npc.Kind = "Racer"
	npc.Speed = speed
	npc.WreckDuration = wreckDuration
	npc.Model.Name = "RacerCar"
	return npc
end

function NpcService.Remove(npc: Npc)
	local index = table.find(npcs, npc)
	if index then
		table.remove(npcs, index)
	end
	npc.Model:Destroy()
end

function NpcService.Init()
	if not PhysicsService:IsCollisionGroupRegistered(N.CollisionGroup) then
		PhysicsService:RegisterCollisionGroup(N.CollisionGroup)
	end
	crashEffectRemote = Remotes.Get("CrashEffect")
	for name, encoded in CityRoutes :: { [string]: string } do
		routes[name] = decodeRoute(encoded)
	end
end

function NpcService.Start()
	folder = Instance.new("Folder")
	folder.Name = "NpcCars"
	folder.Parent = workspace

	local rng = Random.new(2024)
	for name, count in N.PerRoute :: { [string]: number } do
		local route = routes[name]
		if route and #route > 0 then
			for i = 0, count - 1 do
				spawnNpc(route, math.floor(i * #route / count) + 1, N.Colors[rng:NextInteger(1, #N.Colors)], rng)
			end
		end
	end

	RunService.PreSimulation:Connect(function(dt)
		dt = math.min(dt, 1 / 30)
		local now = os.clock()
		for _, npc in npcs do
			if npc.Chassis.Parent then
				updateNpc(npc, dt, now)
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		for _, npc in npcs do
			if npc.LastHitter == player then
				npc.LastHitter = nil
			end
		end
	end)
	print(("[NpcService] %d NPC-bilar ute på gatorna"):format(#npcs))
end

return NpcService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">RaceService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Race i Halmstads gator. Servern avgör allt: vem som är med, kontrollpunkter (i ordning),
-- placering, måltid och belöning. Klienten visar bara portar, nedräkning och resultat.
--
-- Flöde: Idle -> Lobby (andra kan gå med) -> Countdown (alla på startgriden) -> Running -> Cooldown.
-- Under racet ligger deltagarna i kollisionsgruppen RaceCars: de krockar med varandra och trafiken
-- men är fortfarande spöken för spelare som inte kör racet.

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local MapData = require(ReplicatedStorage.Shared.Map.MapData)
local RaceConfig = require(ReplicatedStorage.Shared.Config.RaceConfig)
local VehicleConfig = require(ReplicatedStorage.Shared.Config.VehicleConfig)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Geometry = require(script.Parent.Parent.Map.Geometry)
local CrashService = require(script.Parent.CrashService)
local EconomyService = require(script.Parent.EconomyService)
local NpcService = require(script.Parent.NpcService)
local RespawnService = require(script.Parent.RespawnService)
local VehicleService = require(script.Parent.VehicleService)

type Checkpoint = {
	Position: Vector3,
	Direction: Vector3,
	Progress: number, -- ruttpunkter från start till den här kontrollpunkten
}

type Participant = {
	Name: string,
	Player: Player?,
	Npc: NpcService.Npc?,
	NextCheckpoint: number,
	FinishTime: number?,
	Grid: CFrame,
	Takedowns: number,
}

type Session = {
	Race: RaceConfig.RaceDefinition,
	Route: { Vector2 },
	StartPosition: Vector3,
	Checkpoints: { Checkpoint },
	LapLength: number,
	State: string, -- "Idle" | "Lobby" | "Countdown" | "Running" | "Cooldown"
	Participants: { Participant },
	LobbyEndsAt: number,
	StartAt: number, -- servertid (workspace:GetServerTimeNow())
	FirstFinishAt: number?,
	CooldownUntil: number,
	LastBroadcast: number,
}

local RaceService = {}

local sessions: { [string]: Session } = {}
local lastInvite: { [Player]: number } = {}
local remotes: { [string]: RemoteEvent } = {}

local RIVAL_COLORS = {
	Color3.fromRGB(250, 120, 20),
	Color3.fromRGB(20, 180, 170),
	Color3.fromRGB(200, 40, 140),
	Color3.fromRGB(240, 220, 40),
}

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function wrap(index: number, count: number): number
	return (index - 1) % count + 1
end

local function routePosition(route: { Vector2 }, index: number): (Vector3, Vector3)
	local i = wrap(index, #route)
	local p = route[i]
	local before = route[wrap(i - 1, #route)]
	local after = route[wrap(i + 1, #route)]
	local direction = Vector3.new(after.X - before.X, 0, after.Y - before.Y).Unit
	return Vector3.new(p.X, MapData.GroundHeightAt(p.X, p.Y), p.Y), direction
end

local function buildCheckpoints(race: RaceConfig.RaceDefinition, route: { Vector2 }): { Checkpoint }
	local spacing = race.CheckpointSpacing
	local count = math.floor(#route / spacing)
	if #route - (count - 1) * spacing < spacing / 2 then
		count -= 1
	end
	local checkpoints = {}
	for lap = 0, race.Laps - 1 do
		for k = 1, count do
			local offset = if k == count then #route else k * spacing
			local position, direction = routePosition(route, race.StartIndex + offset)
			table.insert(checkpoints, {
				Position = position,
				Direction = direction,
				Progress = lap * #route + offset,
			})
		end
	end
	return checkpoints
end

local function gridCFrame(session: Session, slot: number): CFrame
	local row = math.floor((slot - 1) / 2)
	local side = if slot % 2 == 1 then -5 else 5
	local position, direction = routePosition(session.Route, session.Race.StartIndex - 1 - row * 2)
	local right = Vector3.new(-direction.Z, 0, direction.X)
	local at = position + right * side + Vector3.new(0, 4, 0)
	return CFrame.lookAt(at, at + direction)
end

local function findParticipant(player: Player): (Session?, Participant?)
	for _, session in sessions do
		for _, participant in session.Participants do
			if participant.Player == player then
				return session, participant
			end
		end
	end
	return nil, nil
end

local function playerCount(session: Session): number
	local count = 0
	for _, participant in session.Participants do
		if participant.Player then
			count += 1
		end
	end
	return count
end

local function progressOf(session: Session, participant: Participant): number
	if participant.Npc then
		return participant.Npc.Passed
	end
	local reached = participant.NextCheckpoint - 1
	local base = if reached > 0 then session.Checkpoints[reached].Progress else 0
	local nextCheckpoint = session.Checkpoints[participant.NextCheckpoint]
	local car = participant.Player and VehicleService.GetCar(participant.Player)
	if not nextCheckpoint or not car or not car.PrimaryPart then
		return base
	end
	local gap = nextCheckpoint.Progress - base
	local distance = (car.PrimaryPart.Position - nextCheckpoint.Position).Magnitude / 20
	return base + math.max(0, gap - distance)
end

-- Ordning: i mål (snabbast först), sedan längst kommen.
local function standings(session: Session): { Participant }
	local order = table.clone(session.Participants)
	local progress = {}
	for _, participant in order do
		progress[participant] = progressOf(session, participant)
	end
	table.sort(order, function(a, b)
		if a.FinishTime and b.FinishTime then
			return a.FinishTime < b.FinishTime
		elseif a.FinishTime or b.FinishTime then
			return a.FinishTime ~= nil
		end
		return progress[a] > progress[b]
	end)
	return order
end

local function restorePlayer(player: Player)
	VehicleService.SetCollisionGroup(player, nil)
end

local function cleanup(session: Session)
	for _, participant in session.Participants do
		if participant.Player then
			restorePlayer(participant.Player)
		end
		if participant.Npc then
			NpcService.Remove(participant.Npc)
		end
	end
	session.Participants = {}
	session.FirstFinishAt = nil
	session.State = "Cooldown"
	session.CooldownUntil = os.clock() + RaceConfig.CooldownAfterRace
end

local function finishRace(session: Session)
	local order = standings(session)
	local results = {}
	for position, participant in order do
		local reward = 0
		if participant.Player and participant.FinishTime then
			local rewards = session.Race.Rewards
			reward = rewards[math.min(position, #rewards)]
		end
		if participant.Player then
			reward += participant.Takedowns * RaceConfig.TakedownBonus
		end
		table.insert(results, {
			Position = position,
			Name = participant.Name,
			Time = participant.FinishTime,
			UserId = if participant.Player then participant.Player.UserId else 0,
			Reward = reward,
			Takedowns = participant.Takedowns,
		})
	end
	for _, participant in order do
		local player = participant.Player
		if player then
			for _, result in results do
				if result.UserId == player.UserId and result.Reward > 0 then
					EconomyService.AddMoney(player, result.Reward, session.Race.Name)
				end
			end
			remotes.RaceFinished:FireClient(player, { RaceName = session.Race.Name, Results = results })
		end
	end
	cleanup(session)
end

local function removePlayer(session: Session, player: Player)
	for i, participant in session.Participants do
		if participant.Player == player then
			table.remove(session.Participants, i)
			break
		end
	end
	if player.Parent == Players then
		restorePlayer(player)
		remotes.RaceFinished:FireClient(player, { Left = true })
	end
	if session.State ~= "Idle" and session.State ~= "Cooldown" and playerCount(session) == 0 then
		cleanup(session)
	end
end

local function startCountdown(session: Session)
	session.State = "Countdown"
	local slot = 0
	for _, participant in session.Participants do
		slot += 1
		participant.Grid = gridCFrame(session, slot)
		local player = participant.Player
		if player then
			VehicleService.SetCollisionGroup(player, RaceConfig.CollisionGroup)
			VehicleService.MoveCar(player, participant.Grid)
		end
	end
	local race = session.Race
	for r = 1, math.min(race.Rivals, RaceConfig.MaxParticipants - slot) do
		slot += 1
		local grid = gridCFrame(session, slot)
		local row = math.floor((slot - 1) / 2)
		local npc = NpcService.SpawnRacer(
			race.Route,
			wrap(race.StartIndex - 1 - row * 2, #session.Route),
			RIVAL_COLORS[(r - 1) % #RIVAL_COLORS + 1],
			race.RivalSpeeds[math.min(r, #race.RivalSpeeds)],
			RaceConfig.RivalWreckDuration
		)
		if npc then
			npc.Model:PivotTo(grid)
			npc.Passed = -(1 + row * 2)
			npc.SpeedScale = 0 -- står still tills GO
			table.insert(session.Participants, {
				Name = ("Rival %d"):format(r),
				Npc = npc,
				NextCheckpoint = 1,
				Grid = grid,
				Takedowns = 0,
			})
		end
	end

	session.StartAt = serverNow() + RaceConfig.Countdown
	local checkpoints = {}
	for _, checkpoint in session.Checkpoints do
		table.insert(checkpoints, { Position = checkpoint.Position, Direction = checkpoint.Direction })
	end
	for _, participant in session.Participants do
		if participant.Player then
			remotes.RaceSetup:FireClient(participant.Player, {
				RaceId = race.Id,
				Name = race.Name,
				StartAt = session.StartAt,
				Checkpoints = checkpoints,
				Participants = #session.Participants,
			})
		end
	end
end

local function updateRunning(session: Session)
	local now = serverNow()
	local elapsed = now - session.StartAt
	local total = #session.Checkpoints

	-- Spelare: kontrollpunkter i ordning
	for _, participant in session.Participants do
		local player = participant.Player
		if player and not participant.FinishTime then
			local car = VehicleService.GetCar(player)
			local checkpoint = session.Checkpoints[participant.NextCheckpoint]
			if car and car.PrimaryPart and checkpoint then
				local offset = (car.PrimaryPart.Position - checkpoint.Position) * Vector3.new(1, 0.3, 1)
				if offset.Magnitude < RaceConfig.CheckpointRadius then
					participant.NextCheckpoint += 1
					remotes.RaceCheckpoint:FireClient(player, participant.NextCheckpoint - 1)
					if participant.NextCheckpoint > total then
						participant.FinishTime = elapsed
						session.FirstFinishAt = session.FirstFinishAt or os.clock()
					end
				end
			end
		end
	end

	-- NPC-motståndare: mål när de kört hela banan. Rubber band mot ledande spelare.
	local leader = 0
	for _, participant in session.Participants do
		if participant.Player then
			leader = math.max(leader, progressOf(session, participant))
		end
	end
	for _, participant in session.Participants do
		local npc = participant.Npc
		if npc and not participant.FinishTime then
			if npc.Passed >= session.LapLength * session.Race.Laps then
				participant.FinishTime = elapsed
				session.FirstFinishAt = session.FirstFinishAt or os.clock()
				npc.SpeedScale = 0.4
			else
				local gap = (leader - npc.Passed) * RaceConfig.RubberBand
				npc.SpeedScale = 1 + math.clamp(gap, -RaceConfig.RubberBandMax, RaceConfig.RubberBandMax)
			end
		end
	end

	if os.clock() - session.LastBroadcast > 0.5 then
		session.LastBroadcast = os.clock()
		local order = standings(session)
		for position, participant in order do
			if participant.Player then
				remotes.RaceUpdate:FireClient(participant.Player, position, #order, elapsed)
			end
		end
	end

	local allPlayersDone = true
	for _, participant in session.Participants do
		if participant.Player and not participant.FinishTime then
			allPlayersDone = false
		end
	end
	local timedOut = session.FirstFinishAt ~= nil and os.clock() - session.FirstFinishAt > RaceConfig.FinishTimeout
	if allPlayersDone or timedOut or elapsed > RaceConfig.MaxRaceTime then
		finishRace(session)
	end
end

local function updateSession(session: Session)
	local state = session.State
	if state == "Lobby" then
		if os.clock() >= session.LobbyEndsAt then
			startCountdown(session)
		end
	elseif state == "Countdown" then
		-- Ingen tjuvstart: den som rullar iväg ställs tillbaka på sin ruta
		for _, participant in session.Participants do
			local player = participant.Player
			local car = player and VehicleService.GetCar(player)
			if player and car and car.PrimaryPart then
				if (car.PrimaryPart.Position - participant.Grid.Position).Magnitude > RaceConfig.GridMoveTolerance then
					VehicleService.MoveCar(player, participant.Grid)
				end
			end
		end
		if serverNow() >= session.StartAt then
			session.State = "Running"
			for _, participant in session.Participants do
				if participant.Npc then
					participant.Npc.SpeedScale = 1
				end
			end
		end
	elseif state == "Running" then
		updateRunning(session)
	elseif state == "Cooldown" then
		if os.clock() >= session.CooldownUntil then
			session.State = "Idle"
		end
	end

	-- Inbjudan till spelare vid startlinjen
	if state == "Idle" or state == "Lobby" then
		for player, car in VehicleService.GetCars() do
			local root = car.PrimaryPart
			if root and (root.Position - session.StartPosition).Magnitude < RaceConfig.StartRadius then
				local inSession = findParticipant(player)
				if not inSession and os.clock() - (lastInvite[player] or 0) > 1 then
					lastInvite[player] = os.clock()
					remotes.RaceInvite:FireClient(player, session.Race.Id, session.Race.Name, state == "Lobby")
				end
			end
		end
	end
end

local function onJoinRequested(player: Player, raceId: unknown)
	if typeof(raceId) ~= "string" or #raceId > 40 then
		return
	end
	local session = sessions[raceId]
	if not session or (session.State ~= "Idle" and session.State ~= "Lobby") then
		return
	end
	if findParticipant(player) then
		return
	end
	local car = VehicleService.GetCar(player)
	if not car or not car.PrimaryPart then
		return
	end
	if (car.PrimaryPart.Position - session.StartPosition).Magnitude > RaceConfig.StartRadius * 1.5 then
		return
	end
	if playerCount(session) >= RaceConfig.MaxParticipants then
		return
	end
	if session.State == "Idle" then
		session.State = "Lobby"
		session.LobbyEndsAt = os.clock() + RaceConfig.LobbyTime
		session.Participants = {}
	end
	table.insert(session.Participants, {
		Name = player.DisplayName,
		Player = player,
		NextCheckpoint = 1,
		Grid = CFrame.new(),
		Takedowns = 0,
	})
	local left = math.max(0, math.ceil(session.LobbyEndsAt - os.clock()))
	remotes.Notify:FireClient(player, ("%s – start in %d s"):format(session.Race.Name, left), "info")
end

local function onLeaveRequested(player: Player)
	local session = findParticipant(player)
	if session then
		removePlayer(session, player)
	end
end

-- Kvaddad racedeltagare: närmaste andra deltagare får en takedown.
local function onPlayerWrecked(player: Player)
	local session = findParticipant(player)
	if not session or session.State ~= "Running" then
		return
	end
	local victim = VehicleService.GetCar(player)
	local victimRoot = victim and victim.PrimaryPart
	if not victimRoot then
		return
	end
	local best: Participant? = nil
	local bestDistance = RaceConfig.PlayerTakedownRadius
	for _, participant in session.Participants do
		local other = participant.Player
		local car = other and other ~= player and VehicleService.GetCar(other)
		if car and car.PrimaryPart then
			local distance = (car.PrimaryPart.Position - victimRoot.Position).Magnitude
			if distance < bestDistance then
				best, bestDistance = participant, distance
			end
		end
	end
	if best and best.Player then
		CrashService.AwardTakedown(best.Player, victimRoot)
	end
end

-- Takedowns under racet (på motståndare eller andra deltagare) ger bonus vid målgång.
local function onTakedown(player: Player, victim: BasePart)
	local session, participant = findParticipant(player)
	if not session or not participant or session.State ~= "Running" then
		return
	end
	for _, other in session.Participants do
		local model = if other.Npc then other.Npc.Model elseif other.Player then VehicleService.GetCar(other.Player) else nil
		if model and victim:IsDescendantOf(model) then
			participant.Takedowns += 1
			return
		end
	end
end

local function buildStartMarker(session: Session)
	local marker = Instance.new("Folder")
	marker.Name = "RaceStart_" .. session.Race.Id
	marker.Parent = workspace
	local base = session.StartPosition
	local ring = Geometry.Cylinder(marker, "Ring", base + Vector3.new(0, 0.1, 0), RaceConfig.StartRadius - 6, 0.3, Color3.fromRGB(255, 200, 40), Enum.Material.Neon)
	ring.Transparency = 0.6
	Geometry.Decor(ring)
	local _, direction = routePosition(session.Route, session.Race.StartIndex)
	local right = Vector3.new(-direction.Z, 0, direction.X)
	for _, side in { -1, 1 } do
		local post = Geometry.Part(
			marker,
			"Post",
			Vector3.new(1.5, 18, 1.5),
			CFrame.new(base + right * side * 20 + Vector3.new(0, 9, 0)),
			Color3.new(1, 1, 1),
			Enum.Material.Metal
		)
		Geometry.Obstacle(post)
	end
	local banner = Geometry.Part(marker, "Banner", Vector3.new(40, 4, 0.5), CFrame.lookAt(base + Vector3.new(0, 19, 0), base + Vector3.new(0, 19, 0) - direction) * CFrame.Angles(0, 0, 0), Color3.fromRGB(20, 20, 25))
	Geometry.Label(banner, Enum.NormalId.Front, "START / MÅL", session.Race.Name, Color3.fromRGB(20, 20, 25))
	Geometry.Label(banner, Enum.NormalId.Back, "START / MÅL", session.Race.Name, Color3.fromRGB(20, 20, 25))

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(220, 60)
	billboard.StudsOffset = Vector3.new(0, 26, 0)
	billboard.MaxDistance = 600
	billboard.Parent = ring
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 210, 60)
	label.TextStrokeTransparency = 0.2
	label.Text = "RACE: " .. session.Race.Name
	label.Parent = billboard
end

function RaceService.IsRacing(player: Player): boolean
	return findParticipant(player) ~= nil
end

function RaceService.Init()
	for _, group in { RaceConfig.CollisionGroup, VehicleConfig.CollisionGroup, "Debris" } do
		if not PhysicsService:IsCollisionGroupRegistered(group) then
			PhysicsService:RegisterCollisionGroup(group)
		end
	end
	PhysicsService:CollisionGroupSetCollidable(RaceConfig.CollisionGroup, VehicleConfig.CollisionGroup, false)
	PhysicsService:CollisionGroupSetCollidable(RaceConfig.CollisionGroup, "Debris", false)

	for _, name in { "RaceInvite", "RaceSetup", "RaceCheckpoint", "RaceUpdate", "RaceFinished", "Notify" } do
		remotes[name] = Remotes.Get(name)
	end
	Remotes.Get("RequestJoinRace").OnServerEvent:Connect(onJoinRequested)
	Remotes.Get("LeaveRace").OnServerEvent:Connect(onLeaveRequested)

	CrashService.OnWrecked(onPlayerWrecked)
	CrashService.OnTakedown(onTakedown)

	-- Kvaddad eller i vattnet under racet: tillbaka till senaste kontrollpunkten
	RespawnService.SetRespawnOverride(function(player: Player): CFrame?
		local session, participant = findParticipant(player)
		if not session or not participant or (session.State ~= "Running" and session.State ~= "Countdown") then
			return nil
		end
		local reached = participant.NextCheckpoint - 1
		if reached < 1 or session.State == "Countdown" then
			return participant.Grid
		end
		local checkpoint = session.Checkpoints[reached]
		local at = checkpoint.Position + Vector3.new(0, 4, 0)
		return CFrame.lookAt(at, at + checkpoint.Direction)
	end)
	RespawnService.SetTeleportBlocker(function(player: Player): string?
		if findParticipant(player) then
			return "Not during a race"
		end
		return nil
	end)
end

function RaceService.Start()
	for _, race in RaceConfig.Races do
		local route = NpcService.GetRoute(race.Route)
		if route then
			local startPosition = routePosition(route, race.StartIndex)
			local session: Session = {
				Race = race,
				Route = route,
				StartPosition = startPosition,
				Checkpoints = buildCheckpoints(race, route),
				LapLength = #route,
				State = "Idle",
				Participants = {},
				LobbyEndsAt = 0,
				StartAt = 0,
				FirstFinishAt = nil,
				CooldownUntil = 0,
				LastBroadcast = 0,
			}
			sessions[race.Id] = session
			buildStartMarker(session)
			print(("[RaceService] %s: %d kontrollpunkter"):format(race.Name, #session.Checkpoints))
		else
			warn("[RaceService] Rutten saknas: " .. race.Route)
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		lastInvite[player] = nil
		local session = findParticipant(player)
		if session then
			removePlayer(session, player)
		end
	end)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.1 then
			return
		end
		accumulator = 0
		for _, session in sessions do
			updateSession(session)
		end
	end)
end

return RaceService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">RespawnService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Respawn-systemet:
--  * R / ↻: ställ bilen på hjulen där den står. Två tryck inom några sekunder = till närmaste väg.
--  * Automatiskt till närmaste väg om bilen hamnar i vattnet eller utanför kartan.
--  * Snabbresa till namngivna platser (MapData.Locations), med cooldown.
-- Respawnpunkterna läggs till av MapService (gatorna) och TestTrackService.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local MapData = require(ReplicatedStorage.Shared.Map.MapData)
local VehicleConfig = require(ReplicatedStorage.Shared.Config.VehicleConfig)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local VehicleService = require(script.Parent.VehicleService)

local Settings = VehicleConfig.Respawn

export type RespawnPoint = {
	Position: Vector3,
	Yaw: number, -- grader, 0 = norr
}

local RespawnService = {}

local points: { RespawnPoint } = {}
-- Under ett race bestämmer RaceService var bilen ska respawna och spärrar snabbresa.
local respawnOverride: ((player: Player) -> CFrame?)? = nil
local teleportBlocker: ((player: Player) -> string?)? = nil
local lastReset: { [Player]: number } = {}
local lastTeleport: { [Player]: number } = {}
local notifyRemote: RemoteEvent

local function pointCFrame(point: RespawnPoint): CFrame
	return CFrame.new(point.Position + Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.rad(point.Yaw), 0)
end

function RespawnService.AddPoints(newPoints: { RespawnPoint })
	for _, point in newPoints do
		table.insert(points, point)
	end
end

function RespawnService.FindNearest(position: Vector3): RespawnPoint?
	local best: RespawnPoint? = nil
	local bestDistance = math.huge
	for _, point in points do
		local distance = (point.Position - position).Magnitude
		if distance < bestDistance then
			best = point
			bestDistance = distance
		end
	end
	return best
end

function RespawnService.SetRespawnOverride(override: (player: Player) -> CFrame?)
	respawnOverride = override
end

-- Blockeraren returnerar ett meddelande om snabbresa inte är tillåten just nu.
function RespawnService.SetTeleportBlocker(blocker: (player: Player) -> string?)
	teleportBlocker = blocker
end

function RespawnService.RespawnOnRoad(player: Player, message: string?)
	local car = VehicleService.GetCar(player)
	if not car or not car.PrimaryPart then
		return
	end
	local target = respawnOverride and respawnOverride(player)
	if not target then
		local point = RespawnService.FindNearest(car.PrimaryPart.Position)
		target = if point then pointCFrame(point) else MapData.PlayerSpawn(1)
	end
	VehicleService.MoveCar(player, target)
	if message then
		notifyRemote:FireClient(player, message, "respawn")
	end
end

local function onResetRequested(player: Player)
	local now = os.clock()
	local previous = lastReset[player] or -math.huge
	if now - previous < VehicleConfig.Server.ResetCooldown then
		return
	end
	lastReset[player] = now
	if now - previous < Settings.DoubleResetWindow then
		RespawnService.RespawnOnRoad(player, "Back on the road")
	else
		VehicleService.UprightCar(player)
	end
end

local function onTeleportRequested(player: Player, locationId: unknown)
	if typeof(locationId) ~= "string" or #locationId > 40 then
		return
	end
	local location = MapData.FindLocation(locationId)
	if not location then
		return
	end
	local blocked = teleportBlocker and teleportBlocker(player)
	if blocked then
		notifyRemote:FireClient(player, blocked, "info")
		return
	end
	local now = os.clock()
	if now - (lastTeleport[player] or -math.huge) < Settings.TeleportCooldown then
		notifyRemote:FireClient(player, "Wait a moment…", "info")
		return
	end
	lastTeleport[player] = now
	local target = MapData.LocationCFrame(location)
	if location.SnapToRoad then
		local point = RespawnService.FindNearest(location.Position)
		if point then
			target = pointCFrame(point)
		end
	end
	if VehicleService.MoveCar(player, target) then
		notifyRemote:FireClient(player, location.Name, "location")
	end
end

function RespawnService.Init()
	notifyRemote = Remotes.Get("Notify")
	Remotes.Get("ResetVehicle").OnServerEvent:Connect(onResetRequested)
	Remotes.Get("TeleportToLocation").OnServerEvent:Connect(onTeleportRequested)
end

function RespawnService.Start()
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastReset[player] = nil
		lastTeleport[player] = nil
	end)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < Settings.CheckInterval then
			return
		end
		accumulator = 0
		for player, car in VehicleService.GetCars() do
			local chassis = car.PrimaryPart
			if chassis then
				local position = chassis.Position
				if position.Y < MapData.WaterLevel + Settings.WaterMargin then
					RespawnService.RespawnOnRoad(player, "SPLASH!")
				elseif not MapData.IsInBounds(position) then
					RespawnService.RespawnOnRoad(player, "Out of bounds")
				end
			end
		end
	end)
end

return RespawnService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">TestTrackService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Testplattan från fas 1, flyttad till MapData.TestTrackOrigin (öster om Halmstad).
-- Nås via snabbresemenyn ("Testbanan"). Bra för att finjustera bilens känsla.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MapData = require(ReplicatedStorage.Shared.Map.MapData)
local Geometry = require(script.Parent.Parent.Map.Geometry)
local RespawnService = require(script.Parent.RespawnService)

local TestTrackService = {}

local SPAWN_Z = 300

local function build(): Model
	local track = Instance.new("Model")
	track.Name = "TestTrack"

	local asphalt = Color3.fromRGB(70, 72, 78)
	Geometry.Part(track, "Ground", Vector3.new(1600, 4, 1600), CFrame.new(0, -2, 0), asphalt, Enum.Material.Asphalt)

	for z = SPAWN_Z - 40, -700, -30 do
		Geometry.Decor(Geometry.Part(track, "LaneLine", Vector3.new(1, 0.05, 14), CFrame.new(0, 0.03, z), Color3.new(1, 1, 1)))
	end

	-- 1) Liten kicker
	Geometry.Ramp(track, "Kicker", Vector3.new(0, 0, 150), 0, 18, 15, 20)

	-- 2) Table-top: upp, platå, ner
	local upStart = Vector3.new(0, 0, -50)
	Geometry.Ramp(track, "TableUp", upStart, 0, 40, 14, 26)
	local top = Geometry.RampTop(upStart, 0, 40, 14)
	local plateauLength = 40
	Geometry.Part(
		track,
		"TablePlateau",
		Vector3.new(26, top.Y, plateauLength),
		CFrame.new(top.X, top.Y / 2, top.Z - plateauLength / 2),
		Color3.fromRGB(240, 170, 40),
		Enum.Material.DiamondPlate
	)
	Geometry.Ramp(track, "TableDown", Vector3.new(0, 0, top.Z - plateauLength - 40 * math.cos(math.rad(14))), 180, 40, 14, 26)

	-- 3) Stort hopp
	Geometry.Ramp(track, "BigJump", Vector3.new(0, 0, -300), 0, 50, 22, 24)

	-- 4) Slalom med pelare
	for i = 0, 9 do
		local x = 150 + (i % 2) * 14 - 7
		Geometry.Obstacle(
			Geometry.Part(track, "Pillar", Vector3.new(4, 16, 4), CFrame.new(x, 8, 200 - i * 45), Color3.fromRGB(230, 230, 235), Enum.Material.Concrete)
		)
	end

	-- 5) Smal tunnel
	for _, x in { -159, -141 } do
		Geometry.Obstacle(
			Geometry.Part(track, "TunnelWall", Vector3.new(2, 8, 160), CFrame.new(x, 4, 100), Color3.fromRGB(200, 60, 60), Enum.Material.Brick)
		)
	end

	-- 6) Driftcirkel
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		Geometry.Obstacle(
			Geometry.Part(track, "Cone", Vector3.new(2, 3, 2), CFrame.new(-350 + math.cos(a) * 90, 1.5, -200 + math.sin(a) * 90), Color3.fromRGB(255, 120, 20))
		)
	end

	-- 7) Sidoramper
	Geometry.Ramp(track, "SideRampEast", Vector3.new(300, 0, -100), -90, 30, 18, 20)
	Geometry.Ramp(track, "SideRampWest", Vector3.new(-300, 0, 100), 90, 30, 18, 20)

	for _, data in
		{
			{ Vector3.new(1600, 3, 3), Vector3.new(0, 1.5, -800) },
			{ Vector3.new(1600, 3, 3), Vector3.new(0, 1.5, 800) },
			{ Vector3.new(3, 3, 1600), Vector3.new(-800, 1.5, 0) },
			{ Vector3.new(3, 3, 1600), Vector3.new(800, 1.5, 0) },
		}
	do
		Geometry.Part(track, "Edge", data[1], CFrame.new(data[2]), Color3.fromRGB(255, 220, 0))
	end

	track.WorldPivot = CFrame.new()
	track:PivotTo(CFrame.new(MapData.TestTrackOrigin))
	track.Parent = workspace
	return track
end

function TestTrackService.Init()
	build()

	-- Respawnpunkter längs mittlinjen
	local points = {}
	for z = SPAWN_Z, -700, -100 do
		table.insert(points, { Position = MapData.TestTrackOrigin + Vector3.new(0, 0, z), Yaw = 0 })
	end
	RespawnService.AddPoints(points)
end

function TestTrackService.Start() end

return TestTrackService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">VehicleService</string><ProtectedString name="Source"><![CDATA[--!strict
-- Ger varje spelare en bil, sätter föraren i den och vaktar fysiken.
--
-- Nätverksmodell: föraren äger bilens fysik (SetNetworkOwner) så att styrningen
-- känns direkt. Servern litar inte blint på det: den kontrollerar hastighet och
-- förflyttning och rättar till bilen om något ser fel ut.
--
-- Spökläge: alla bilar (och förare) ligger i kollisionsgruppen "Cars", som inte
-- krockar med sig själv. Krockar mellan spelare slås på per läge i senare faser.

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local VehicleConfig = require(ReplicatedStorage.Shared.Config.VehicleConfig)
local CarBuilder = require(script.Parent.Parent.Vehicle.CarBuilder)

local ServerLimits = VehicleConfig.Server
local CAR_GROUP = VehicleConfig.CollisionGroup

type CarRecord = {
	Player: Player,
	Model: Model,
	Chassis: BasePart,
	Seat: Seat,
	Slot: number,
	LastPosition: Vector3,
	LastCheck: number,
	SpeedStrikes: number,
	IgnoreChecksUntil: number,
	CollisionGroup: string,
}

local VehicleService = {}

local cars: { [Player]: CarRecord } = {}
local usedSlots: { [number]: boolean } = {}
local spawnProvider: ((slot: number) -> CFrame)? = nil

local CAR_COLORS = {
	Color3.fromRGB(230, 60, 60),
	Color3.fromRGB(40, 130, 230),
	Color3.fromRGB(250, 190, 30),
	Color3.fromRGB(60, 190, 90),
	Color3.fromRGB(160, 80, 220),
	Color3.fromRGB(250, 120, 30),
}

-- Kartan (eller testbanan) talar om var nya bilar ska starta.
function VehicleService.SetSpawnProvider(provider: (slot: number) -> CFrame)
	spawnProvider = provider
end

local function getSpawnCFrame(slot: number): CFrame
	if spawnProvider then
		return spawnProvider(slot)
	end
	return CFrame.new(slot * 12, 5, 0)
end

local function claimSlot(): number
	local slot = 1
	while usedSlots[slot] do
		slot += 1
	end
	usedSlots[slot] = true
	return slot
end

local function setCollisionGroup(root: Instance, group: string)
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = group
		end
	end
end

-- Flyttar en bil som klienten äger. Servern tar tillfälligt över ägarskapet
-- så att flytten inte skrivs över av klientens simulering.
local function forceMove(record: CarRecord, target: CFrame, velocity: Vector3?)
	local chassis = record.Chassis
	chassis:SetNetworkOwner(nil)
	record.Model:PivotTo(target)
	chassis.AssemblyLinearVelocity = velocity or Vector3.zero
	chassis.AssemblyAngularVelocity = Vector3.zero
	record.LastPosition = target.Position
	record.IgnoreChecksUntil = os.clock() + 1
	task.delay(0.15, function()
		if cars[record.Player] == record and chassis.Parent then
			chassis:SetNetworkOwner(record.Player)
		end
	end)
end

local function flatYaw(cf: CFrame): CFrame
	local look = cf.LookVector * Vector3.new(1, 0, 1)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(Vector3.zero, look.Unit)
end

local function destroyCar(player: Player)
	local record = cars[player]
	if not record then
		return
	end
	cars[player] = nil
	usedSlots[record.Slot] = nil
	record.Model:Destroy()
end

local function seatDriver(record: CarRecord, humanoid: Humanoid)
	if record.Seat.Occupant == humanoid then
		return
	end
	local character = humanoid.Parent :: Model
	-- Föraren ska inte påverka bilens tyngdpunkt och ska vara spöke precis som bilen.
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Massless = true
			descendant.CollisionGroup = record.CollisionGroup
		end
	end
	character:PivotTo(record.Seat.CFrame + Vector3.new(0, 3, 0))
	record.Seat:Sit(humanoid)
	task.defer(function()
		if record.Chassis.Parent then
			record.Chassis:SetNetworkOwner(record.Player)
		end
	end)
end

local function spawnCarFor(player: Player, character: Model)
	destroyCar(player)

	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root or character.Parent == nil then
		return
	end

	local slot = claimSlot()
	local model = CarBuilder.Build(CAR_COLORS[(slot - 1) % #CAR_COLORS + 1], player.UserId)
	setCollisionGroup(model, CAR_GROUP)
	local spawnCFrame = getSpawnCFrame(slot)
	model:PivotTo(spawnCFrame)
	model.Parent = workspace

	local record: CarRecord = {
		Player = player,
		Model = model,
		Chassis = model.PrimaryPart :: BasePart,
		Seat = model:FindFirstChild("DriverSeat") :: Seat,
		Slot = slot,
		LastPosition = spawnCFrame.Position,
		LastCheck = os.clock(),
		SpeedStrikes = 0,
		IgnoreChecksUntil = os.clock() + 2,
		CollisionGroup = CAR_GROUP,
	}
	cars[player] = record
	record.Chassis:SetNetworkOwner(player)

	seatDriver(record, humanoid)

	-- Om föraren av någon anledning åker ur sätet sätter vi tillbaka hen.
	humanoid.Seated:Connect(function(isSeated: boolean)
		if isSeated or cars[player] ~= record or humanoid.Health <= 0 then
			return
		end
		task.delay(0.5, function()
			if cars[player] == record and humanoid.Parent and humanoid.Health > 0 then
				seatDriver(record, humanoid)
			end
		end)
	end)

	humanoid.Died:Connect(function()
		if cars[player] == record then
			destroyCar(player)
		end
	end)
end

local function validateCar(record: CarRecord, now: number)
	local chassis = record.Chassis
	local position = chassis.Position
	local elapsed = now - record.LastCheck
	record.LastCheck = now

	if now < record.IgnoreChecksUntil then
		record.LastPosition = position
		return
	end

	-- Bara horisontellt: fritt fall får gå fort.
	local velocity = chassis.AssemblyLinearVelocity
	local horizontalSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local moved = (position - record.LastPosition) * Vector3.new(1, 0, 1)
	local maxMove = ServerLimits.HorizontalSpeedCap * elapsed * 1.5 + ServerLimits.TeleportSlack

	if moved.Magnitude > maxMove then
		warn(("[VehicleService] %s flyttade %.0f studs på %.2f s, återställer"):format(
			record.Player.Name,
			moved.Magnitude,
			elapsed
		))
		forceMove(record, CFrame.new(record.LastPosition + Vector3.new(0, 3, 0)) * flatYaw(chassis.CFrame))
		return
	end

	if horizontalSpeed > ServerLimits.HorizontalSpeedCap then
		record.SpeedStrikes += 1
		if record.SpeedStrikes >= ServerLimits.SpeedStrikesBeforeCorrection then
			warn(("[VehicleService] %s körde %.0f studs/s, bromsar"):format(record.Player.Name, horizontalSpeed))
			record.SpeedStrikes = 0
			forceMove(record, chassis.CFrame, velocity.Unit * ServerLimits.HorizontalSpeedCap * 0.8)
			return
		end
	else
		record.SpeedStrikes = 0
	end

	record.LastPosition = position
end

function VehicleService.GetCar(player: Player): Model?
	local record = cars[player]
	return record and record.Model
end

-- Alla aktiva bilar, för t.ex. RespawnService. Ändra inte i tabellen.
function VehicleService.GetCars(): { [Player]: Model }
	local result = {}
	for player, record in cars do
		if record.Chassis.Parent then
			result[player] = record.Model
		end
	end
	return result
end

-- Flyttar spelarens bil på ett sätt som servervalideringen godkänner.
function VehicleService.MoveCar(player: Player, target: CFrame): boolean
	local record = cars[player]
	if not record then
		return false
	end
	forceMove(record, target)
	return true
end

-- Byter kollisionsgrupp för spelarens bil och förare (t.ex. "RaceCars" under ett race).
-- Utan grupp återgår bilen till spökläget för fri körning.
function VehicleService.SetCollisionGroup(player: Player, group: string?)
	local record = cars[player]
	if not record then
		return
	end
	record.CollisionGroup = group or CAR_GROUP
	setCollisionGroup(record.Model, record.CollisionGroup)
	if player.Character then
		setCollisionGroup(player.Character, record.CollisionGroup)
	end
end

-- Ställer bilen på hjulen där den står, vänd åt samma håll.
function VehicleService.UprightCar(player: Player): boolean
	local record = cars[player]
	if not record then
		return false
	end
	local current = record.Chassis.CFrame
	forceMove(record, CFrame.new(current.Position + Vector3.new(0, 5, 0)) * flatYaw(current))
	return true
end

function VehicleService.Init()
	if not PhysicsService:IsCollisionGroupRegistered(CAR_GROUP) then
		PhysicsService:RegisterCollisionGroup(CAR_GROUP)
	end
	PhysicsService:CollisionGroupSetCollidable(CAR_GROUP, CAR_GROUP, false)
end

function VehicleService.Start()
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			spawnCarFor(player, character)
		end)
		if player.Character then
			task.spawn(spawnCarFor, player, player.Character)
		end
	end

	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(destroyCar)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < ServerLimits.CheckInterval then
			return
		end
		accumulator = 0
		local now = os.clock()
		for _, record in cars do
			if record.Chassis.Parent then
				validateCar(record, now)
			end
		end
	end)
end

return VehicleService
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000022"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">Leaderstats</string><ProtectedString name="Source"><![CDATA[--!strict
-- Gemensam åtkomst till leaderstats (syns i spelarlistan). Skapar mapp och värde vid behov,
-- så att flera services kan använda samma statistik utan att skapa dubbletter.

local Leaderstats = {}

function Leaderstats.Get(player: Player, name: string): IntValue
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		folder.Parent = player
	end
	local value = (folder :: Folder):FindFirstChild(name)
	if not value then
		value = Instance.new("IntValue")
		value.Name = name
		value.Parent = folder
	end
	return value :: IntValue
end

return Leaderstats
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000024"><Properties><string name="Name">Vehicle</string></Properties><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">CarBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- Bygger en fantasibil ("Kustpilen") av enkla Parts.
-- Chassit är den enda kroppen med massa; allt annat är Massless och svetsat.
-- Klienten hittar hjulen via attributen och styr fjädringen via VectorForces.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VehicleConfig = require(ReplicatedStorage.Shared.Config.VehicleConfig)

local Tuning = VehicleConfig.Tuning
local Geometry = VehicleConfig.Geometry

local CarBuilder = {}

local function makePart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		(part :: any)[key] = value
	end
	return part
end

local function weldTo(part: BasePart, chassis: BasePart, offset: CFrame)
	part.CFrame = chassis.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = chassis
	weld.Part1 = part
	weld.Parent = part
	part.Parent = chassis.Parent
end

function CarBuilder.Build(bodyColor: Color3, ownerUserId: number): Model
	local model = Instance.new("Model")
	model.Name = "Car_" .. ownerUserId
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model:SetAttribute("IsHalmstadCar", true)
	model:SetAttribute("OwnerUserId", ownerUserId)

	local size = Geometry.ChassisSize
	local chassis = makePart({
		Name = "Chassis",
		Size = size,
		Color = bodyColor,
		CanCollide = true,
		CanQuery = true,
		CanTouch = true,
		Massless = false,
		RootPriority = 10,
		CustomPhysicalProperties = PhysicalProperties.new(1.5, 0.1, 0.2, 1, 1),
	})
	chassis.Parent = model
	model.PrimaryPart = chassis

	-- Kaross (visuell)
	local top = size.Y / 2
	weldTo(makePart({ Name = "Hood", Size = Vector3.new(5.6, 0.6, 3.4), Color = bodyColor }), chassis, CFrame.new(0, top + 0.3, -3.6))
	weldTo(makePart({ Name = "Trunk", Size = Vector3.new(5.6, 0.7, 2.6), Color = bodyColor }), chassis, CFrame.new(0, top + 0.35, 4.1))
	weldTo(
		makePart({
			Name = "Windshield",
			Size = Vector3.new(5.4, 1.6, 0.2),
			Color = Color3.fromRGB(150, 200, 230),
			Transparency = 0.4,
			Material = Enum.Material.Glass,
		}),
		chassis,
		CFrame.new(0, top + 1.0, -1.7) * CFrame.Angles(math.rad(-25), 0, 0)
	)
	weldTo(
		makePart({ Name = "RollBar", Size = Vector3.new(5.4, 0.4, 0.4), Color = Color3.fromRGB(40, 40, 45) }),
		chassis,
		CFrame.new(0, top + 2.0, 2.4)
	)
	for _, x in { -2.6, 2.6 } do
		weldTo(
			makePart({ Name = "RollBarPost", Size = Vector3.new(0.4, 2.0, 0.4), Color = Color3.fromRGB(40, 40, 45) }),
			chassis,
			CFrame.new(x, top + 1.0, 2.4)
		)
		weldTo(
			makePart({
				Name = "Headlight",
				Size = Vector3.new(1.2, 0.5, 0.2),
				Color = Color3.fromRGB(255, 250, 220),
				Material = Enum.Material.Neon,
			}),
			chassis,
			CFrame.new(x * 0.8, 0.2, -size.Z / 2 - 0.05)
		)
		weldTo(
			makePart({
				Name = "Taillight",
				Size = Vector3.new(1.2, 0.4, 0.2),
				Color = Color3.fromRGB(255, 40, 40),
				Material = Enum.Material.Neon,
			}),
			chassis,
			CFrame.new(x * 0.8, 0.3, size.Z / 2 + 0.05)
		)
	end
	weldTo(
		makePart({ Name = "Spoiler", Size = Vector3.new(5.8, 0.25, 1.2), Color = Color3.fromRGB(30, 30, 30) }),
		chassis,
		CFrame.new(0, top + 1.3, 5.0)
	)
	weldTo(
		makePart({ Name = "Stripe", Size = Vector3.new(1.2, 0.05, 11.05), Color = Color3.new(1, 1, 1) }),
		chassis,
		CFrame.new(0, top + 0.01, 0)
	)

	-- Säte. CanTouch = false så att ingen kan kliva in av misstag; servern sätter föraren med Seat:Sit.
	local seat = Instance.new("Seat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(2, 0.4, 2)
	seat.Transparency = 1
	seat.CanCollide = false
	seat.CanTouch = false
	seat.CanQuery = false
	seat.Massless = true
	weldTo(seat, chassis, CFrame.new(0, top + 0.2, 0.6))

	-- Hjul: monteringspunkt (Attachment + VectorForce) och visuellt hjul (Motor6D).
	for _, mount in Geometry.WheelMounts do
		local attachment = Instance.new("Attachment")
		attachment.Name = "Mount_" .. mount.Name
		attachment.Position = mount.Offset
		attachment:SetAttribute("Front", mount.Front)
		attachment.Parent = chassis

		local force = Instance.new("VectorForce")
		force.Name = "Spring"
		force.Attachment0 = attachment
		force.RelativeTo = Enum.ActuatorRelativeTo.World
		force.ApplyAtCenterOfMass = false
		force.Force = Vector3.zero
		force.Parent = attachment

		local wheel = makePart({
			Name = "Wheel_" .. mount.Name,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(Geometry.WheelWidth, Tuning.WheelRadius * 2, Tuning.WheelRadius * 2),
			Color = Color3.fromRGB(25, 25, 25),
		})
		wheel.Parent = model

		local motor = Instance.new("Motor6D")
		motor.Name = "WheelMotor"
		motor.Part0 = chassis
		motor.Part1 = wheel
		motor.C0 = CFrame.new(mount.Offset - Vector3.new(0, Tuning.VisualSpringLength, 0))
		motor.Parent = attachment

		local hub = makePart({
			Name = "Hub",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(Geometry.WheelWidth + 0.1, 1.0, 1.0),
			Color = Color3.fromRGB(200, 200, 210),
			Material = Enum.Material.Metal,
		})
		weldTo(hub, wheel, CFrame.new())
		hub.Parent = model
	end

	return model
end

return CarBuilder
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000036"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000035"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000034"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[--!strict
-- Klientens startpunkt. Ordningen spelar roll: input först, sedan fordon,
-- därefter sådant som lyssnar på fordonet (kamera och UI).

local Controllers = script:WaitForChild("Controllers")
local UI = script:WaitForChild("UI")

local modules = {
	Controllers:WaitForChild("InputController"),
	Controllers:WaitForChild("VehicleController"),
	Controllers:WaitForChild("CameraController"),
	Controllers:WaitForChild("EffectsController"),
	Controllers:WaitForChild("CrashController"),
	Controllers:WaitForChild("RaceController"),
	UI:WaitForChild("HUD"),
	UI:WaitForChild("TouchControls"),
	UI:WaitForChild("DistrictBanner"),
	UI:WaitForChild("LocationMenu"),
	UI:WaitForChild("RaceUI"),
}

for _, module in modules do
	local controller = require(module :: ModuleScript) :: any
	local ok, err = pcall(controller.Start)
	if not ok then
		warn(("[Client] %s.Start misslyckades: %s"):format(module.Name, tostring(err)))
	end
end

-- Börja leta efter spelarens bil först när alla lyssnare är uppkopplade.
require(Controllers.VehicleController :: ModuleScript).Begin()
]]></ProtectedString></Properties><Item class="Folder" referent="RBX0000002D"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">CameraController</string><ProtectedString name="Source"><![CDATA[--!strict
-- Jaktkamera bakom bilen. Följer färdriktningen (så drifter syns), vidgar FOV
-- med farten och skakar lätt vid boost.

local RunService = game:GetService("RunService")

local VehicleController = require(script.Parent.VehicleController)
local VehicleConfig = require(game:GetService("ReplicatedStorage").Shared.Config.VehicleConfig)

local T = VehicleConfig.Tuning

local CameraController = {}

local BIND_NAME = "HalmstadRushCamera"
local DISTANCE = 18
local HEIGHT = 6.5
local LOOK_AHEAD = 8
local BASE_FOV = 70
local SPEED_FOV = 22
local BOOST_FOV = 8

local camera = workspace.CurrentCamera
local smoothedDirection = Vector3.new(0, 0, -1)
local smoothedPosition: Vector3? = nil
local fov = BASE_FOV

local function blend(rate: number, dt: number): number
	return 1 - math.exp(-rate * dt)
end

-- Krockkamera: kretsar långsamt runt en del (egen kvaddad bil eller utknuffad NPC)
local crashSubject: BasePart? = nil
local crashUntil = 0
local crashAngle = 0
local crashRadius = 24
local CRASH_ORBIT_SPEED = 0.7
local CRASH_FOV = 55

local shakeUntil = 0
local shakeMagnitude = 0

function CameraController.CrashCam(subject: BasePart, duration: number)
	crashSubject = subject
	crashUntil = os.clock() + duration
	local current = workspace.CurrentCamera.CFrame.Position - subject.Position
	crashAngle = math.atan2(current.Z, current.X)
end

function CameraController.Shake(magnitude: number, duration: number)
	shakeMagnitude = math.max(magnitude, if os.clock() < shakeUntil then shakeMagnitude else 0)
	shakeUntil = os.clock() + duration
end

local function shakeOffset(): CFrame
	local now = os.clock()
	if now >= shakeUntil then
		return CFrame.new()
	end
	local t = now * 45
	local m = shakeMagnitude * math.clamp((shakeUntil - now) * 3, 0, 1)
	return CFrame.new(math.noise(t, 1.3) * m, math.noise(2.7, t) * m, 0)
end

local function updateCrashCam(dt: number): boolean
	local subject = crashSubject
	if not subject or os.clock() >= crashUntil or not subject.Parent then
		crashSubject = nil
		return false
	end
	crashAngle += CRASH_ORBIT_SPEED * dt
	local center = subject.Position
	local position = center + Vector3.new(math.cos(crashAngle) * crashRadius, 9, math.sin(crashAngle) * crashRadius)
	camera.CFrame = CFrame.lookAt(position, center) * shakeOffset()
	fov += (CRASH_FOV - fov) * blend(6, dt)
	camera.FieldOfView = fov
	smoothedPosition = position
	return true
end

local function update(dt: number)
	local car = VehicleController.GetCar()
	local chassis = car and car.PrimaryPart
	if not chassis then
		return
	end
	camera = workspace.CurrentCamera
	if updateCrashCam(dt) then
		return
	end
	local state = VehicleController.GetState()
	local cf = chassis.CFrame
	local velocity = chassis.AssemblyLinearVelocity
	local flatVelocity = velocity * Vector3.new(1, 0, 1)
	local flatLook = cf.LookVector * Vector3.new(1, 0, 1)
	if flatLook.Magnitude < 0.01 then
		flatLook = smoothedDirection
	end

	-- Riktning: blanda bilens nos och färdriktningen. Vid back: titta som bilen pekar.
	local desired = flatLook.Unit
	if flatVelocity.Magnitude > 20 and state.Speed > 0 then
		desired = (flatLook.Unit * 0.5 + flatVelocity.Unit * 0.5).Unit
	end
	smoothedDirection = (smoothedDirection:Lerp(desired, blend(5, dt)))
	if smoothedDirection.Magnitude < 0.01 then
		smoothedDirection = desired
	end
	smoothedDirection = smoothedDirection.Unit

	local carPos = cf.Position
	local targetPos = carPos - smoothedDirection * DISTANCE + Vector3.yAxis * HEIGHT
	if smoothedPosition == nil then
		smoothedPosition = targetPos
	end
	-- Följ snabbt i sidled men låt höjden släpa lite (mjukare vid hopp).
	local current = smoothedPosition :: Vector3
	local horizontal = current:Lerp(targetPos, blend(12, dt))
	local vertical = current.Y + (targetPos.Y - current.Y) * blend(6, dt)
	local position = Vector3.new(horizontal.X, vertical, horizontal.Z)
	smoothedPosition = position

	local lookAt = carPos + smoothedDirection * LOOK_AHEAD + Vector3.yAxis * 2
	local result = CFrame.lookAt(position, lookAt)

	if state.Boosting then
		local t = os.clock() * 40
		result *= CFrame.new(math.noise(t, 0) * 0.15, math.noise(0, t) * 0.15, 0)
	end
	camera.CFrame = result * shakeOffset()

	local speedRatio = math.clamp(math.abs(state.Speed) / T.BoostMaxSpeed, 0, 1)
	local targetFov = BASE_FOV + SPEED_FOV * speedRatio + (if state.Boosting then BOOST_FOV else 0)
	fov += (targetFov - fov) * blend(4, dt)
	camera.FieldOfView = fov
end

function CameraController.Start()
	VehicleController.Entered:Connect(function()
		smoothedPosition = nil
		camera = workspace.CurrentCamera
		camera.CameraType = Enum.CameraType.Scriptable
		RunService:UnbindFromRenderStep(BIND_NAME)
		RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, update)
	end)

	VehicleController.Exited:Connect(function()
		RunService:UnbindFromRenderStep(BIND_NAME)
		camera = workspace.CurrentCamera
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = BASE_FOV
	end)
end

return CameraController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">CrashController</string><ProtectedString name="Source"><![CDATA[--!strict
-- Kopplar ihop krockar med effekter, kamera och meddelanden:
--  * Lätt smäll: gnistor och kameraskak.
--  * Kvaddad bil (WRECKED!): krockkamera med slow motion-känsla, plåtdelar, rök, sedan respawn.
--  * Takedown (servern avgör): popup, boost och en kort krockkamera på NPC-bilen.
--  * NPC-krockar (alla spelare ser): gnistor och plåtdelar där krocken skedde.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VehicleConfig = require(ReplicatedStorage.Shared.Config.VehicleConfig)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local CameraController = require(script.Parent.CameraController)
local EffectsController = require(script.Parent.EffectsController)
local VehicleController = require(script.Parent.VehicleController)

local C = VehicleConfig.Crash

local CrashController = {}

local EFFECT_RADIUS = 600 -- visa NPC-krockar bara i närheten

local function carColor(model: Model?): Color3
	local chassis = model and model.PrimaryPart
	return if chassis then chassis.Color else Color3.fromRGB(200, 60, 60)
end

local function onCrashed(strength: number, point: Vector3)
	EffectsController.Sparks(point, strength)
	CameraController.Shake(math.clamp(strength / 60, 0.2, 1.2), 0.35)
end

local function onWrecked(car: Model, point: Vector3)
	local chassis = car.PrimaryPart
	if not chassis then
		return
	end
	VehicleController.Popup:Fire("WRECKED!", "wreck")
	local velocity = chassis.AssemblyLinearVelocity
	local direction = if velocity.Magnitude > 1 then velocity.Unit else Vector3.yAxis
	EffectsController.Debris(point, direction, carColor(car), 10, C.WreckDuration * 0.7)
	EffectsController.Smoke(chassis.Position, 12)
	EffectsController.SlowMotionLook(C.WreckDuration)
	CameraController.CrashCam(chassis, C.WreckDuration)
	CameraController.Shake(1.2, 0.5)
end

local function onTakedown(npcChassis: unknown)
	if typeof(npcChassis) ~= "Instance" or not (npcChassis :: Instance):IsA("BasePart") then
		return
	end
	local chassis = npcChassis :: BasePart
	VehicleController.Popup:Fire("TAKEDOWN!", "takedown")
	VehicleController.AddBoost(C.ChargeTakedown)
	VehicleController.LockInput(C.TakedownCamDuration)
	EffectsController.SlowMotionLook(C.TakedownCamDuration)
	CameraController.CrashCam(chassis, C.TakedownCamDuration)
end

local function onCrashEffect(position: unknown, strength: unknown)
	if typeof(position) ~= "Vector3" or typeof(strength) ~= "number" then
		return
	end
	local car = VehicleController.GetCar()
	local chassis = car and car.PrimaryPart
	if chassis and (chassis.Position - (position :: Vector3)).Magnitude > EFFECT_RADIUS then
		return
	end
	EffectsController.Sparks(position :: Vector3, strength :: number)
	EffectsController.Smoke(position :: Vector3, 6)
	EffectsController.Debris(position :: Vector3, Vector3.yAxis, Color3.fromRGB(170, 170, 175), 6, 1)
end

function CrashController.Start()
	VehicleController.Crashed:Connect(onCrashed)
	VehicleController.Wrecked:Connect(onWrecked)
	Remotes.Get("Takedown").OnClientEvent:Connect(onTakedown)
	Remotes.Get("CrashEffect").OnClientEvent:Connect(onCrashEffect)
	-- När servern flyttar bilen (respawn, snabbresa) är kvaddningen över och
	-- den stora hastighetsändringen ska inte räknas som en krock.
	Remotes.Get("Notify").OnClientEvent:Connect(function(_text: unknown, kind: unknown)
		if kind == "respawn" or kind == "location" then
			VehicleController.EndWreck()
		end
	end)
end

return CrashController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">EffectsController</string><ProtectedString name="Source"><![CDATA[--!strict
-- Tecknade krockeffekter, bara lokalt på klienten: gnistor, rök, flygande plåtdelar
-- och "slow motion"-känsla (oskärpa + avmättade färger, plåtdelar som svävar sakta).
-- Fysiken saktas aldrig ner på riktigt.

local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local EffectsController = {}

local holder: Folder
local blur: BlurEffect
local grade: ColorCorrectionEffect

local SPARK_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"

local function emitterPart(position: Vector3): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.one
	part.CFrame = CFrame.new(position)
	part.Parent = holder
	Debris:AddItem(part, 4)
	return part
end

function EffectsController.Sparks(position: Vector3, strength: number)
	local part = emitterPart(position)
	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = SPARK_TEXTURE
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 230, 120), Color3.fromRGB(255, 120, 30))
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new(0.6, 0)
	sparks.Lifetime = NumberRange.new(0.3, 0.7)
	sparks.Speed = NumberRange.new(20, 45)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.Acceleration = Vector3.new(0, -60, 0)
	sparks.Rate = 0
	sparks.Parent = part
	sparks:Emit(math.clamp(math.floor(strength / 2), 10, 60))
end

function EffectsController.Smoke(position: Vector3, amount: number)
	local part = emitterPart(position)
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = SMOKE_TEXTURE
	smoke.Color = ColorSequence.new(Color3.fromRGB(200, 200, 200), Color3.fromRGB(120, 120, 120))
	smoke.Transparency = NumberSequence.new(0.3, 1)
	smoke.Size = NumberSequence.new(3, 10)
	smoke.Lifetime = NumberRange.new(1, 2)
	smoke.Speed = NumberRange.new(4, 10)
	smoke.SpreadAngle = Vector2.new(60, 60)
	smoke.Rate = 0
	smoke.Parent = part
	smoke:Emit(amount)
end

-- Plåtdelar som flyger iväg. Under `slowTime` sekunder bärs de nästan upp (motverkad
-- gravitation) och rör sig långsamt, sedan faller de som vanligt och tonas bort.
function EffectsController.Debris(position: Vector3, direction: Vector3, color: Color3, count: number, slowTime: number)
	local slow = slowTime > 0
	for _ = 1, count do
		local piece = Instance.new("Part")
		piece.Size = Vector3.new(math.random(10, 30) / 10, 0.2, math.random(8, 25) / 10)
		piece.Color = if math.random() < 0.6 then color else Color3.fromRGB(60, 60, 65)
		piece.Material = Enum.Material.Metal
		piece.CFrame = CFrame.new(position + Vector3.new(math.random() - 0.5, 1 + math.random(), math.random() - 0.5) * 2)
			* CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		piece.CanQuery = false
		piece.CanTouch = false
		piece.CollisionGroup = "Debris" -- krockar inte med bilar (registreras av CrashService)
		piece.Parent = holder

		local spread = Vector3.new(math.random() - 0.5, math.random() * 0.8 + 0.4, math.random() - 0.5) * 2
		local launch = (direction * 0.6 + spread).Unit * math.random(30, 60)
		local scale = if slow then 0.3 else 1
		piece.AssemblyLinearVelocity = launch * scale
		piece.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 20 * scale

		if slow then
			local attachment = Instance.new("Attachment")
			attachment.Parent = piece
			local float = Instance.new("VectorForce")
			float.Attachment0 = attachment
			float.RelativeTo = Enum.ActuatorRelativeTo.World
			float.Force = Vector3.new(0, piece.AssemblyMass * workspace.Gravity * 0.9, 0)
			float.Parent = piece
			task.delay(slowTime, function()
				if piece.Parent then
					float:Destroy()
					piece.AssemblyLinearVelocity *= 3
				end
			end)
		end

		task.delay(slowTime + 2, function()
			if piece.Parent then
				TweenService:Create(piece, TweenInfo.new(1), { Transparency = 1 }):Play()
			end
		end)
		Debris:AddItem(piece, slowTime + 3.2)
	end
end

-- Oskärpa och avmättade färger under krockkameran (känns som slow motion).
function EffectsController.SlowMotionLook(duration: number)
	local fadeIn = TweenInfo.new(0.15)
	local fadeOut = TweenInfo.new(0.4)
	TweenService:Create(blur, fadeIn, { Size = 8 }):Play()
	TweenService:Create(grade, fadeIn, { Saturation = -0.35, Contrast = 0.15 }):Play()
	task.delay(math.max(duration - 0.3, 0.1), function()
		TweenService:Create(blur, fadeOut, { Size = 0 }):Play()
		TweenService:Create(grade, fadeOut, { Saturation = 0, Contrast = 0 }):Play()
	end)
end

function EffectsController.Start()
	holder = Instance.new("Folder")
	holder.Name = "LocalEffects"
	holder.Parent = workspace

	blur = Instance.new("BlurEffect")
	blur.Size = 0
	blur.Parent = Lighting

	grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "CrashGrade"
	grade.Parent = Lighting
end

return EffectsController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">InputController</string><ProtectedString name="Source"><![CDATA[--!strict
-- Samlar körinput från tangentbord, handkontroll och pekskärm till ett gemensamt format.
--
-- Tangentbord: W/S eller pilar = gas/broms (back), A/D = styr, Space = handbroms/drift,
--              Shift = boost, R = återställ bilen.
-- Handkontroll: RT = gas, LT = broms, vänster spak = styr, X = drift, A = boost, Y = återställ.
-- Pekskärm: knappar på skärmen (skapas av TouchControls).

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage.Shared.Util.Signal)

export type DriveInput = {
	Throttle: number, -- 0..1
	Brake: number, -- 0..1
	Steer: number, -- -1 (vänster) .. 1 (höger)
	Handbrake: boolean,
	Boost: boolean,
}

local InputController = {}

InputController.ResetPressed = Signal.new()

-- Pekskärmsknapparna skriver hit
local touchState = {
	Throttle = false,
	Brake = false,
	Left = false,
	Right = false,
	Handbrake = false,
	Boost = false,
}

local gamepad = {
	Throttle = 0,
	Brake = 0,
	Steer = 0,
	Handbrake = false,
	Boost = false,
}

local STICK_DEADZONE = 0.15

function InputController.SetTouch(name: string, pressed: boolean)
	(touchState :: any)[name] = pressed
end

local function key(...: Enum.KeyCode): boolean
	for _, code in { ... } do
		if UserInputService:IsKeyDown(code) then
			return true
		end
	end
	return false
end

local function focused(): boolean
	return UserInputService:GetFocusedTextBox() ~= nil
end

function InputController.GetDriveInput(): DriveInput
	local typing = focused()
	local kThrottle = not typing and key(Enum.KeyCode.W, Enum.KeyCode.Up)
	local kBrake = not typing and key(Enum.KeyCode.S, Enum.KeyCode.Down)
	local kLeft = not typing and key(Enum.KeyCode.A, Enum.KeyCode.Left)
	local kRight = not typing and key(Enum.KeyCode.D, Enum.KeyCode.Right)
	local kHandbrake = not typing and key(Enum.KeyCode.Space)
	local kBoost = not typing and key(Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift)

	local throttle = math.max(if kThrottle or touchState.Throttle then 1 else 0, gamepad.Throttle)
	local brake = math.max(if kBrake or touchState.Brake then 1 else 0, gamepad.Brake)

	local steer = gamepad.Steer
	local digitalSteer = (if kRight or touchState.Right then 1 else 0) - (if kLeft or touchState.Left then 1 else 0)
	if digitalSteer ~= 0 then
		steer = digitalSteer
	end

	return {
		Throttle = throttle,
		Brake = brake,
		Steer = math.clamp(steer, -1, 1),
		Handbrake = kHandbrake or touchState.Handbrake or gamepad.Handbrake,
		Boost = kBoost or touchState.Boost or gamepad.Boost,
	}
end

function InputController.Start()
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end
		if input.KeyCode == Enum.KeyCode.R or input.KeyCode == Enum.KeyCode.ButtonY then
			InputController.ResetPressed:Fire()
		elseif input.KeyCode == Enum.KeyCode.ButtonX then
			gamepad.Handbrake = true
		elseif input.KeyCode == Enum.KeyCode.ButtonA then
			gamepad.Boost = true
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.ButtonX then
			gamepad.Handbrake = false
		elseif input.KeyCode == Enum.KeyCode.ButtonA then
			gamepad.Boost = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Gamepad1 then
			return
		end
		if input.KeyCode == Enum.KeyCode.Thumbstick1 then
			local x = input.Position.X
			gamepad.Steer = if math.abs(x) > STICK_DEADZONE then x else 0
		elseif input.KeyCode == Enum.KeyCode.ButtonR2 then
			gamepad.Throttle = input.Position.Z
		elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
			gamepad.Brake = input.Position.Z
		end
	end)
end

return InputController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">RaceController</string><ProtectedString name="Source"><![CDATA[--!strict
-- Klientens del av racen: tar emot inbjudan, uppställning, kontrollpunkter och resultat
-- från servern och visar portarna i världen. Servern avgör allt som räknas.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local VehicleController = require(script.Parent.VehicleController)

export type CheckpointInfo = { Position: Vector3, Direction: Vector3 }
export type RaceSetup = {
	RaceId: string,
	Name: string,
	StartAt: number,
	Checkpoints: { CheckpointInfo },
	Participants: number,
}

local RaceController = {}

RaceController.Invited = Signal.new() -- (raceId, raceName, lobbyOpen)
RaceController.SetupReceived = Signal.new() -- (setup)
RaceController.CheckpointPassed = Signal.new() -- (passed, total)
RaceController.Updated = Signal.new() -- (position, participants, elapsed)
RaceController.Finished = Signal.new() -- (data)

local GATE_WIDTH = 46
local GATE_HEIGHT = 16
local NEXT_COLOR = Color3.fromRGB(255, 200, 40)
local LATER_COLOR = Color3.fromRGB(120, 200, 255)
local FINISH_COLOR = Color3.fromRGB(255, 255, 255)

local setup: RaceSetup? = nil
local passed = 0
local gateFolder: Folder
local joinRemote: RemoteEvent
local leaveRemote: RemoteEvent

local function clearGates()
	gateFolder:ClearAllChildren()
end

local function gatePart(parent: Instance, size: Vector3, cframe: CFrame, color: Color3, transparency: number): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = transparency
	part.Size = size
	part.CFrame = cframe
	part.Parent = parent
	return part
end

local function buildGate(index: number, isNext: boolean)
	local current = setup
	if not current then
		return
	end
	local checkpoint = current.Checkpoints[index]
	if not checkpoint then
		return
	end
	local isFinish = index == #current.Checkpoints
	local color = if isFinish then FINISH_COLOR elseif isNext then NEXT_COLOR else LATER_COLOR
	local transparency = if isNext then 0.1 else 0.6
	local model = Instance.new("Model")
	model.Name = "Gate" .. index
	local base = CFrame.lookAt(checkpoint.Position, checkpoint.Position + checkpoint.Direction)
	for _, side in { -1, 1 } do
		gatePart(model, Vector3.new(1.6, GATE_HEIGHT, 1.6), base * CFrame.new(side * GATE_WIDTH / 2, GATE_HEIGHT / 2, 0), color, transparency)
	end
	local beam = gatePart(model, Vector3.new(GATE_WIDTH, 1.6, 1.6), base * CFrame.new(0, GATE_HEIGHT, 0), color, transparency)

	if isNext then
		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.fromOffset(120, 50)
		billboard.StudsOffset = Vector3.new(0, 6, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = beam
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = color
		label.TextStrokeTransparency = 0.2
		label.Text = if isFinish then "▼ FINISH" else ("▼ %d/%d"):format(index, #current.Checkpoints)
		label.Parent = billboard
	end
	model.Parent = gateFolder
end

local function refreshGates()
	clearGates()
	local current = setup
	if not current then
		return
	end
	buildGate(passed + 1, true)
	buildGate(passed + 2, false)
end

function RaceController.Join(raceId: string)
	joinRemote:FireServer(raceId)
end

function RaceController.Leave()
	leaveRemote:FireServer()
end

function RaceController.IsRacing(): boolean
	return setup ~= nil
end

function RaceController.Start()
	gateFolder = Instance.new("Folder")
	gateFolder.Name = "RaceGates"
	gateFolder.Parent = workspace

	joinRemote = Remotes.Get("RequestJoinRace")
	leaveRemote = Remotes.Get("LeaveRace")

	Remotes.Get("RaceInvite").OnClientEvent:Connect(function(raceId: unknown, raceName: unknown, lobbyOpen: unknown)
		if setup == nil and typeof(raceId) == "string" and typeof(raceName) == "string" then
			RaceController.Invited:Fire(raceId, raceName, lobbyOpen == true)
		end
	end)

	Remotes.Get("RaceSetup").OnClientEvent:Connect(function(data: any)
		if typeof(data) ~= "table" or typeof(data.Checkpoints) ~= "table" then
			return
		end
		setup = data :: RaceSetup
		passed = 0
		local untilStart = (data.StartAt :: number) - workspace:GetServerTimeNow()
		VehicleController.LockInput(math.max(untilStart, 0), true)
		VehicleController.IgnoreCrashes(1.5)
		refreshGates()
		RaceController.SetupReceived:Fire(data)
	end)

	Remotes.Get("RaceCheckpoint").OnClientEvent:Connect(function(index: unknown)
		local current = setup
		if not current or typeof(index) ~= "number" then
			return
		end
		passed = index :: number
		refreshGates()
		RaceController.CheckpointPassed:Fire(passed, #current.Checkpoints)
	end)

	Remotes.Get("RaceUpdate").OnClientEvent:Connect(function(position: unknown, total: unknown, elapsed: unknown)
		if setup and typeof(position) == "number" and typeof(total) == "number" and typeof(elapsed) == "number" then
			RaceController.Updated:Fire(position, total, elapsed)
		end
	end)

	Remotes.Get("RaceFinished").OnClientEvent:Connect(function(data: any)
		setup = nil
		passed = 0
		clearGates()
		if typeof(data) == "table" then
			RaceController.Finished:Fire(data)
		end
	end)
end

return RaceController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">VehicleController</string><ProtectedString name="Source"><![CDATA[--!strict
-- Arkadfysik för bilen spelaren kör. Körs på klienten eftersom föraren äger
-- bilens fysik (nätverksägare). Servern vaktar hastighet och position.
--
-- Modell: chassit "svävar" på fyra raycast-fjädrar (VectorForce per hjul).
-- På marken styr vi farten direkt: framåtfart (gas/broms), sidledsfart (grepp/drift)
-- och girhastighet (styrning). I luften: lite luftkontroll och självrätning.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local VehicleConfig = require(ReplicatedStorage.Shared.Config.VehicleConfig)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)
local Suspension = require(ReplicatedStorage.Shared.Vehicle.Suspension)
local InputController = require(script.Parent.InputController)

local T = VehicleConfig.Tuning
local C = VehicleConfig.Crash
local player = Players.LocalPlayer

type Wheel = {
	Mount: Attachment,
	Force: VectorForce,
	Motor: Motor6D?,
	Front: boolean,
	SpringLength: number,
	Spin: number,
}

export type DriveState = {
	Speed: number, -- framåtfart i studs/s (negativ = backar)
	Boost: number, -- 0..1
	Boosting: boolean,
	Drifting: boolean,
	Airborne: boolean,
	Wrecked: boolean,
}

local VehicleController = {}

VehicleController.Entered = Signal.new() -- (car: Model)
VehicleController.Exited = Signal.new()
VehicleController.Popup = Signal.new() -- (text: string, kind: string)
VehicleController.Crashed = Signal.new() -- (strength: number, point: Vector3) lätt eller hård smäll
VehicleController.Wrecked = Signal.new() -- (car: Model, point: Vector3) bilen är kvaddad

local car: Model? = nil
local chassis: BasePart? = nil
local wheels: { Wheel } = {}
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true
-- Andra bilar är spöken: fjädringen ska inte kunna "stå" på dem.
rayParams.CollisionGroup = VehicleConfig.CollisionGroup

local state: DriveState = {
	Speed = 0,
	Boost = T.BoostStart,
	Boosting = false,
	Drifting = false,
	Airborne = false,
	Wrecked = false,
}

local steerSmoothed = 0
local currentGrip = T.Grip
local airTime = 0
local flippedTime = 0
local nearMissCooldown: { [Instance]: number } = {}
local lastResetRequest = 0
local resetRemote: RemoteEvent
local wreckRemote: RemoteEvent

-- Krockdetektering: hastigheten vi själva satte förra bildrutan jämförs med vad fysiken
-- gjort av den. En plötslig förändring i sidled/framåt = vi har kört in i något.
local lastSetVelocity: Vector3? = nil
local lastPosition: Vector3? = nil
local ignoreCrashUntil = 0
local inputLockUntil = 0
local lockedThrottle = 0
local lockHold = false

local function moveToward(value: number, target: number, maxDelta: number): number
	if value < target then
		return math.min(value + maxDelta, target)
	end
	return math.max(value - maxDelta, target)
end

local function blend(rate: number, dt: number): number
	return 1 - math.exp(-rate * dt)
end

function VehicleController.GetState(): DriveState
	return state
end

function VehicleController.GetCar(): Model?
	return car
end

-- Krockar räknas inte en stund (efter teleport, respawn eller återställning).
function VehicleController.IgnoreCrashes(seconds: number)
	ignoreCrashUntil = math.max(ignoreCrashUntil, os.clock() + seconds)
	lastSetVelocity = nil
end

-- Låser styrningen en stund. Rakt fram med samma gas (takedown-kameran), eller
-- `hold` = stå still med bromsen i (nedräkning före race).
function VehicleController.LockInput(seconds: number, hold: boolean?)
	inputLockUntil = os.clock() + seconds
	lockHold = hold == true
	lockedThrottle = if lockHold then 0 else InputController.GetDriveInput().Throttle
end

function VehicleController.AddBoost(amount: number)
	state.Boost = math.clamp(state.Boost + amount, 0, 1)
end

-- Avslutar kvaddat läge (anropas när servern har flyttat tillbaka bilen till gatan).
function VehicleController.EndWreck()
	state.Wrecked = false
	VehicleController.IgnoreCrashes(C.IgnoreAfterTeleport)
end

function VehicleController.RequestReset()
	local now = os.clock()
	if not car or now - lastResetRequest < VehicleConfig.Server.ResetCooldown then
		return
	end
	lastResetRequest = now
	VehicleController.IgnoreCrashes(C.IgnoreAfterTeleport)
	resetRemote:FireServer()
end

local function setPlayerControlsEnabled(enabled: boolean)
	local ok, playerModule = pcall(function()
		return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript) :: any
	end)
	if ok and playerModule then
		local controls = playerModule:GetControls()
		if enabled then
			controls:Enable()
		else
			controls:Disable()
		end
	end
end

local function exitCar()
	if not car then
		return
	end
	for _, wheel in wheels do
		wheel.Force.Force = Vector3.zero
	end
	car = nil
	chassis = nil
	wheels = {}
	setPlayerControlsEnabled(true)
	VehicleController.Exited:Fire()
end

local function enterCar(model: Model)
	if car == model then
		return
	end
	exitCar()
	local root = model:WaitForChild("Chassis", 5) :: BasePart?
	if not root or not model.Parent then
		return
	end
	car = model
	chassis = root
	wheels = {}
	for _, child in root:GetChildren() do
		if child:IsA("Attachment") and child.Name:sub(1, 6) == "Mount_" then
			local force = child:FindFirstChild("Spring") :: VectorForce
			table.insert(wheels, {
				Mount = child,
				Force = force,
				Motor = child:FindFirstChild("WheelMotor") :: Motor6D?,
				Front = child:GetAttribute("Front") == true,
				SpringLength = T.VisualSpringLength,
				Spin = 0,
			})
		end
	end
	local filter: { Instance } = { model }
	if player.Character then
		table.insert(filter, player.Character)
	end
	rayParams.FilterDescendantsInstances = filter

	state.Speed = 0
	state.Drifting = false
	state.Boosting = false
	steerSmoothed = 0
	currentGrip = T.Grip
	airTime = 0
	flippedTime = 0
	state.Wrecked = false
	VehicleController.IgnoreCrashes(C.IgnoreAfterTeleport)

	setPlayerControlsEnabled(false)
	VehicleController.Entered:Fire(model)
end

local function onSeatChanged(seatPart: BasePart?)
	if seatPart and seatPart.Parent and seatPart.Parent:GetAttribute("IsHalmstadCar") then
		local model = seatPart.Parent :: Model
		if model:GetAttribute("OwnerUserId") == player.UserId then
			enterCar(model)
			return
		end
	end
	exitCar()
end

local function checkNearMiss(cf: CFrame, speed: number)
	if speed < T.NearMissMinSpeed then
		return
	end
	local origin = cf.Position
	local halfWidth = VehicleConfig.Geometry.ChassisSize.X / 2
	local reach = halfWidth + T.NearMissDistance
	local now = os.clock()
	local directions = {
		cf.RightVector,
		-cf.RightVector,
		(cf.RightVector - cf.LookVector * 0.6).Unit,
		(-cf.RightVector - cf.LookVector * 0.6).Unit,
	}
	for _, direction in directions do
		local result = workspace:Raycast(origin, direction * reach, rayParams)
		if result and result.Instance:GetAttribute("Obstacle") then
			local hit = result.Instance
			if (nearMissCooldown[hit] or 0) < now then
				nearMissCooldown[hit] = now + T.NearMissCooldown
				state.Boost = math.min(1, state.Boost + T.ChargeNearMiss)
				VehicleController.Popup:Fire("NEAR MISS!", "nearmiss")
			end
		end
	end
end

local function wreck(point: Vector3)
	if state.Wrecked or not car then
		return
	end
	state.Wrecked = true
	state.Boosting = false
	state.Drifting = false
	VehicleController.Wrecked:Fire(car, point)
	task.delay(C.WreckDuration, function()
		if state.Wrecked then
			wreckRemote:FireServer()
			-- Om servern av någon anledning inte flyttar oss: släpp läget ändå.
			task.delay(1.5, function()
				if state.Wrecked then
					VehicleController.EndWreck()
				end
			end)
		end
	end)
end

local function detectCrash(position: Vector3, velocity: Vector3, now: number)
	local previous = lastSetVelocity
	local previousPosition = lastPosition
	lastPosition = position
	if not previous or not previousPosition or now < ignoreCrashUntil or state.Wrecked then
		return
	end
	if (position - previousPosition).Magnitude > C.TeleportDistance then
		VehicleController.IgnoreCrashes(C.IgnoreAfterTeleport)
		return
	end
	local before = previous * Vector3.new(1, 0, 1)
	local after = velocity * Vector3.new(1, 0, 1)
	local change = (after - before).Magnitude
	if change < C.LightImpact then
		return
	end
	local point = position + (if before.Magnitude > 1 then before.Unit else Vector3.zero) * 5
	VehicleController.Crashed:Fire(change, point)
	local slowedDown = before.Magnitude - after.Magnitude > change * 0.5
	if change >= C.WreckImpact and before.Magnitude >= C.WreckMinSpeed and slowedDown then
		wreck(point)
	end
end

local function updateWheelVisuals(dt: number, forwardSpeed: number)
	for _, wheel in wheels do
		local motor = wheel.Motor
		if motor then
			wheel.Spin = (wheel.Spin - forwardSpeed / T.WheelRadius * dt) % (math.pi * 2)
			local steerAngle = if wheel.Front then -steerSmoothed * T.MaxSteerAngle else 0
			motor.Transform = CFrame.new(0, T.VisualSpringLength - wheel.SpringLength, 0)
				* CFrame.Angles(0, steerAngle, 0)
				* CFrame.Angles(wheel.Spin, 0, 0)
		end
	end
end

local function step(dt: number)
	local root = chassis
	if not root or not car or not car.Parent then
		return
	end
	dt = math.min(dt, 1 / 30)

	local now = os.clock()
	local input = InputController.GetDriveInput()
	if now < inputLockUntil then
		-- (Broms vid stillastående = back, så "håll" är bara ingen gas.)
		input = { Throttle = lockedThrottle, Brake = 0, Steer = 0, Handbrake = false, Boost = false }
	end
	local cf = root.CFrame
	local velocity = root.AssemblyLinearVelocity
	local angular = root.AssemblyAngularVelocity

	detectCrash(cf.Position, velocity, now)
	if state.Wrecked then
		-- Kvaddad: ingen styrning eller fjädring, bilen får tumla fritt tills respawn.
		Suspension.Release(wheels)
		lastSetVelocity = nil
		state.Speed = velocity:Dot(cf.LookVector)
		return
	end

	-- Under race byter servern kollisionsgrupp (RaceCars); strålarna ska följa med.
	rayParams.CollisionGroup = root.CollisionGroup
	local grounded, normalSum = Suspension.Update(root, wheels, rayParams)
	steerSmoothed = moveToward(steerSmoothed, input.Steer, T.SteerSpeed * dt)

	local wantsBoost = input.Boost and state.Boost > 0
	state.Boosting = wantsBoost
	if wantsBoost then
		state.Boost = math.max(0, state.Boost - T.BoostDrainPerSecond * dt)
	end

	if grounded >= 2 then
		if state.Airborne and airTime >= T.MinAirTimeForPopup then
			VehicleController.Popup:Fire(("AIR %.1fs"):format(airTime), "air")
		end
		state.Airborne = false
		airTime = 0

		local normal = (normalSum / grounded).Unit
		local forward = cf.LookVector - normal * cf.LookVector:Dot(normal)
		forward = if forward.Magnitude > 1e-3 then forward.Unit else cf.LookVector
		local right = forward:Cross(normal)

		local vF = velocity:Dot(forward)
		local vR = velocity:Dot(right)
		local vN = velocity:Dot(normal)

		-- Gas, broms, back
		local maxSpeed = if wantsBoost then T.BoostMaxSpeed else T.MaxSpeed
		local acceleration = if wantsBoost then T.BoostAcceleration else T.Acceleration
		local throttle = if wantsBoost then 1 else input.Throttle
		if throttle > 0 and vF < maxSpeed then
			vF = math.min(vF + acceleration * throttle * dt, maxSpeed)
		end
		-- Backhjälp: i uppförsbacke tar vi bort en del av tyngdkraften när man gasar.
		if throttle > 0 and forward.Y > 0 then
			vF += workspace.Gravity * forward.Y * T.HillAssist * throttle * dt
		end
		if input.Brake > 0 then
			if vF > 2 then
				vF = math.max(vF - T.BrakeDeceleration * input.Brake * dt, 0)
			else
				vF = math.max(vF - T.ReverseAcceleration * input.Brake * dt, -T.ReverseMaxSpeed)
			end
		end
		if throttle == 0 and input.Brake == 0 then
			vF *= math.exp(-T.Drag * dt)
			vF = moveToward(vF, 0, T.RollingResistance * dt)
		end
		if vF > maxSpeed then
			vF = math.max(maxSpeed, vF - T.OverspeedDecel * dt)
		end

		-- Drift
		local speedAbs = math.abs(vF)
		if input.Handbrake and speedAbs > T.DriftMinSpeed then
			if not state.Drifting then
				VehicleController.Popup:Fire("DRIFT!", "drift")
			end
			state.Drifting = true
		elseif state.Drifting then
			local stillSliding = math.abs(vR) > T.DriftExitLateral and speedAbs > T.DriftMinSpeed * 0.6
			if not stillSliding or input.Steer == 0 then
				state.Drifting = false
			end
		end
		if input.Handbrake then
			vF = moveToward(vF, 0, T.HandbrakeDecel * dt)
		end

		local targetGrip = if state.Drifting then T.DriftGrip else T.Grip
		currentGrip += (targetGrip - currentGrip) * blend(T.GripRecovery, dt)
		vR *= math.exp(-currentGrip * dt)

		if state.Drifting and speedAbs > 30 then
			state.Boost = math.min(1, state.Boost + T.ChargeDriftPerSecond * dt)
		end

		-- Styrning: sätt girhastigheten runt markens normal
		local speedRatio = math.clamp(speedAbs / T.MaxSpeed, 0, 1)
		local lowSpeedFactor = math.clamp(speedAbs / T.TurnSpeedFull, 0, 1)
		local turn = T.TurnRate * lowSpeedFactor * (1 - (1 - T.HighSpeedTurnFactor) * speedRatio)
		if state.Drifting then
			turn *= 1 + T.DriftTurnBonus
		end
		local direction = if vF >= 0 then 1 else -1
		local targetYaw = -steerSmoothed * turn * direction
		local currentYaw = angular:Dot(normal)
		local newYaw = currentYaw + (targetYaw - currentYaw) * blend(T.YawResponse, dt)
		angular += normal * (newYaw - currentYaw)

		velocity = forward * vF + right * vR + normal * vN
		state.Speed = vF
	else
		state.Airborne = grounded == 0
		state.Drifting = false
		if grounded == 0 then
			airTime += dt
			state.Boost = math.min(1, state.Boost + T.ChargeAirPerSecond * dt)
		end

		-- Luftkontroll (gir) och självrätning
		local up = cf.UpVector
		local currentYaw = angular:Dot(up)
		local targetYaw = -input.Steer * T.AirYawControl
		angular += up * ((targetYaw - currentYaw) * blend(2, dt))

		local tiltAxis = up:Cross(Vector3.yAxis)
		angular += tiltAxis * T.AirUprightStrength * dt
		local yawPart = Vector3.yAxis * angular:Dot(Vector3.yAxis)
		angular = yawPart + (angular - yawPart) * math.exp(-T.AirTiltDamping * dt)

		velocity -= Vector3.yAxis * T.ExtraGravity * dt
		state.Speed = velocity:Dot(cf.LookVector)
	end

	root.AssemblyLinearVelocity = velocity
	root.AssemblyAngularVelocity = angular
	lastSetVelocity = velocity

	checkNearMiss(cf, math.abs(state.Speed))
	updateWheelVisuals(dt, state.Speed)

	-- Ligger bilen på sidan/taket och står still? Återställ automatiskt.
	if cf.UpVector.Y < 0.3 and velocity.Magnitude < 8 then
		flippedTime += dt
		if flippedTime > T.FlippedResetDelay then
			flippedTime = 0
			VehicleController.RequestReset()
		end
	else
		flippedTime = 0
	end

	for instance, untilTime in nearMissCooldown do
		if untilTime < os.clock() then
			nearMissCooldown[instance] = nil
		end
	end
end

function VehicleController.Start()
	resetRemote = Remotes.Get("ResetVehicle")
	wreckRemote = Remotes.Get("ReportWreck")
	InputController.ResetPressed:Connect(VehicleController.RequestReset)
	RunService.PreSimulation:Connect(step)
end

-- Anropas sist av init.client, när kamera och UI redan lyssnar på Entered/Exited.
function VehicleController.Begin()
	local function onCharacter(character: Model)
		exitCar()
		local humanoid = character:WaitForChild("Humanoid") :: Humanoid
		humanoid:GetPropertyChangedSignal("SeatPart"):Connect(function()
			onSeatChanged(humanoid.SeatPart)
		end)
		onSeatChanged(humanoid.SeatPart)
	end

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
end

return VehicleController
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000033"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">DistrictBanner</string><ProtectedString name="Source"><![CDATA[--!strict
-- Visar stadsdelens namn stort när man kör in i ett nytt område (GTA-känsla).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local MapData = require(ReplicatedStorage.Shared.Map.MapData)
local VehicleController = require(script.Parent.Parent.Controllers.VehicleController)

local DistrictBanner = {}

local CHECK_INTERVAL = 0.5
local SHOW_TIME = 2.5

local label: TextLabel
local currentDistrict: string? = nil
local showToken = 0

local function build()
	local gui = Instance.new("ScreenGui")
	gui.Name = "DistrictBanner"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.3)
	label.Size = UDim2.fromOffset(700, 70)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 54
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.TextTransparency = 1
	label.TextStrokeColor3 = Color3.fromRGB(20, 30, 60)
	label.Parent = gui
end

local function show(name: string)
	showToken += 1
	local token = showToken
	label.Text = string.upper(name)
	label.TextTransparency = 0
	label.TextStrokeTransparency = 0.2
	task.delay(SHOW_TIME, function()
		if token ~= showToken then
			return
		end
		TweenService:Create(label, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
end

function DistrictBanner.Start()
	build()
	task.spawn(function()
		while true do
			task.wait(CHECK_INTERVAL)
			local car = VehicleController.GetCar()
			local chassis = car and car.PrimaryPart
			if chassis then
				local district = MapData.DistrictAt(chassis.Position)
				if district and district ~= currentDistrict then
					show(district)
				end
				currentDistrict = district
			end
		end
	end)
end

return DistrictBanner
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--!strict
-- Hastighetsmätare, boost-mätare och popup-texter (DRIFT!, NEAR MISS!, AIR, TAKEDOWN!, WRECKED!).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Remotes = require(game:GetService("ReplicatedStorage").Shared.Remotes)
local VehicleController = require(script.Parent.Parent.Controllers.VehicleController)

local HUD = {}

local POPUP_COLORS: { [string]: Color3 } = {
	drift = Color3.fromRGB(255, 170, 40),
	nearmiss = Color3.fromRGB(80, 220, 255),
	air = Color3.fromRGB(150, 255, 120),
	respawn = Color3.fromRGB(120, 190, 255),
	location = Color3.fromRGB(255, 255, 255),
	info = Color3.fromRGB(220, 220, 220),
	takedown = Color3.fromRGB(255, 70, 60),
	wreck = Color3.fromRGB(255, 150, 40),
	money = Color3.fromRGB(255, 215, 80),
}

local BIG_POPUPS: { [string]: boolean } = { takedown = true, wreck = true }

local gui: ScreenGui
local speedLabel: TextLabel
local boostFill: Frame
local boostFrame: Frame
local popupHolder: Frame
local moneyLabel: TextLabel

local function corner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function build()
	gui = Instance.new("ScreenGui")
	gui.Name = "HUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Enabled = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0)
	panel.Position = UDim2.new(0.5, 0, 0, 12)
	panel.Size = UDim2.fromOffset(260, 74)
	panel.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
	panel.BackgroundTransparency = 0.35
	panel.Parent = gui
	corner(panel, 12)

	speedLabel = Instance.new("TextLabel")
	speedLabel.Name = "Speed"
	speedLabel.BackgroundTransparency = 1
	speedLabel.Position = UDim2.fromOffset(0, 4)
	speedLabel.Size = UDim2.new(1, 0, 0, 40)
	speedLabel.Font = Enum.Font.GothamBlack
	speedLabel.TextSize = 34
	speedLabel.TextColor3 = Color3.new(1, 1, 1)
	speedLabel.Text = "0 km/h"
	speedLabel.Parent = panel

	boostFrame = Instance.new("Frame")
	boostFrame.Name = "Boost"
	boostFrame.Position = UDim2.new(0, 14, 0, 50)
	boostFrame.Size = UDim2.new(1, -28, 0, 14)
	boostFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
	boostFrame.Parent = panel
	corner(boostFrame, 7)

	boostFill = Instance.new("Frame")
	boostFill.Name = "Fill"
	boostFill.Size = UDim2.fromScale(0.5, 1)
	boostFill.BackgroundColor3 = Color3.fromRGB(255, 120, 30)
	boostFill.Parent = boostFrame
	corner(boostFill, 7)

	popupHolder = Instance.new("Frame")
	popupHolder.Name = "Popups"
	popupHolder.BackgroundTransparency = 1
	popupHolder.AnchorPoint = Vector2.new(0.5, 0)
	popupHolder.Position = UDim2.new(0.5, 0, 0, 100)
	popupHolder.Size = UDim2.fromOffset(400, 200)
	popupHolder.Parent = gui

	moneyLabel = Instance.new("TextLabel")
	moneyLabel.Name = "Money"
	moneyLabel.AnchorPoint = Vector2.new(1, 0)
	moneyLabel.Position = UDim2.new(1, -16, 0, 70)
	moneyLabel.Size = UDim2.fromOffset(200, 40)
	moneyLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
	moneyLabel.BackgroundTransparency = 0.35
	moneyLabel.Font = Enum.Font.GothamBlack
	moneyLabel.TextSize = 24
	moneyLabel.TextColor3 = Color3.fromRGB(255, 215, 80)
	moneyLabel.Text = "0 kr"
	moneyLabel.Parent = gui
	corner(moneyLabel, 10)

	local layout = Instance.new("UIListLayout")
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, 4)
	layout.Parent = popupHolder
end

local function showPopup(text: string, kind: string)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	local big = BIG_POPUPS[kind] == true
	label.Size = UDim2.fromOffset(400, if big then 56 else 36)
	label.Font = Enum.Font.GothamBlack
	label.TextSize = if big then 48 else 30
	label.Text = text
	label.TextColor3 = POPUP_COLORS[kind] or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Parent = popupHolder

	local fade = TweenService:Create(
		label,
		TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.6),
		{ TextTransparency = 1, TextStrokeTransparency = 1 }
	)
	fade:Play()
	fade.Completed:Once(function()
		label:Destroy()
	end)
end

-- Pengarna läses från leaderstats (servern äger värdet).
local function watchMoney()
	local player = Players.LocalPlayer
	local leaderstats = player:WaitForChild("leaderstats")
	local kronor = leaderstats:WaitForChild("Kronor") :: IntValue
	local function refresh()
		moneyLabel.Text = ("%d kr"):format(kronor.Value)
	end
	kronor.Changed:Connect(refresh)
	refresh()
end

function HUD.Start()
	build()
	task.spawn(watchMoney)

	VehicleController.Entered:Connect(function()
		gui.Enabled = true
	end)
	VehicleController.Exited:Connect(function()
		gui.Enabled = false
	end)
	VehicleController.Popup:Connect(showPopup)
	Remotes.Get("Notify").OnClientEvent:Connect(function(text: unknown, kind: unknown)
		if typeof(text) == "string" then
			showPopup(text, if typeof(kind) == "string" then kind else "info")
		end
	end)

	RunService.RenderStepped:Connect(function()
		if not gui.Enabled then
			return
		end
		local state = VehicleController.GetState()
		speedLabel.Text = ("%d km/h"):format(math.floor(math.abs(state.Speed) + 0.5))
		boostFill.Size = UDim2.fromScale(math.clamp(state.Boost, 0, 1), 1)
		boostFill.BackgroundColor3 = if state.Boosting
			then Color3.fromRGB(80, 220, 255)
			else Color3.fromRGB(255, 120, 30)
	end)
end

return HUD
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">LocationMenu</string><ProtectedString name="Source"><![CDATA[--!strict
-- Snabbresemeny: M-tangenten (eller MAP-knappen) öppnar en lista med platser.
-- Klienten skickar bara platsens id. Servern validerar id och cooldown.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local MapData = require(ReplicatedStorage.Shared.Map.MapData)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local VehicleController = require(script.Parent.Parent.Controllers.VehicleController)

local LocationMenu = {}

local gui: ScreenGui
local panel: ScrollingFrame
local teleportRemote: RemoteEvent

local function corner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function setOpen(open: boolean)
	panel.Visible = open
end

local function build()
	gui = Instance.new("ScreenGui")
	gui.Name = "LocationMenu"
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local toggle = Instance.new("TextButton")
	toggle.Name = "MapButton"
	toggle.Text = "MAP (M)"
	toggle.Font = Enum.Font.GothamBold
	toggle.TextSize = 18
	toggle.TextColor3 = Color3.new(1, 1, 1)
	toggle.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
	toggle.BackgroundTransparency = 0.3
	toggle.Position = UDim2.fromOffset(16, 70)
	toggle.Size = UDim2.fromOffset(110, 40)
	toggle.Parent = gui
	corner(toggle, 10)
	toggle.Activated:Connect(function()
		setOpen(not panel.Visible)
	end)

	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Panel"
	scroll.Visible = false
	scroll.Position = UDim2.fromOffset(16, 118)
	scroll.Size = UDim2.new(0, 240, 1, -140)
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollBarThickness = 6
	scroll.BorderSizePixel = 0
	panel = scroll
	panel.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
	panel.BackgroundTransparency = 0.2
	panel.Parent = gui
	corner(panel, 12)

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 8)
	padding.PaddingBottom = UDim.new(0, 8)
	padding.PaddingLeft = UDim.new(0, 8)
	padding.PaddingRight = UDim.new(0, 8)
	padding.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = panel

	local title = Instance.new("TextLabel")
	title.Text = "TRAVEL TO"
	title.Font = Enum.Font.GothamBlack
	title.TextSize = 18
	title.TextColor3 = Color3.fromRGB(255, 190, 60)
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, 24)
	title.LayoutOrder = 0
	title.Parent = panel

	for index, location in MapData.Locations do
		local button = Instance.new("TextButton")
		button.Name = location.Id
		button.Text = location.Name
		button.Font = Enum.Font.GothamBold
		button.TextSize = 18
		button.TextColor3 = Color3.new(1, 1, 1)
		button.BackgroundColor3 = Color3.fromRGB(45, 55, 80)
		button.Size = UDim2.new(1, 0, 0, 36)
		button.LayoutOrder = index
		button.Parent = panel
		corner(button, 8)
		button.Activated:Connect(function()
			teleportRemote:FireServer(location.Id)
			setOpen(false)
		end)
	end
end

function LocationMenu.Start()
	teleportRemote = Remotes.Get("TeleportToLocation")
	build()

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not gui.Enabled then
			return
		end
		if input.KeyCode == Enum.KeyCode.M or input.KeyCode == Enum.KeyCode.ButtonSelect then
			setOpen(not panel.Visible)
		end
	end)

	VehicleController.Entered:Connect(function()
		gui.Enabled = true
	end)
	VehicleController.Exited:Connect(function()
		gui.Enabled = false
		setOpen(false)
	end)
end

return LocationMenu
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">RaceUI</string><ProtectedString name="Source"><![CDATA[--!strict
-- Race-gränssnitt: startknapp vid startlinjen, nedräkning, racepanel och resultattavla.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local RaceController = require(script.Parent.Parent.Controllers.RaceController)

local RaceUI = {}

local INVITE_TIMEOUT = 1.6

local gui: ScreenGui
local prompt: TextButton
local countdownLabel: TextLabel
local panel: Frame
local positionLabel: TextLabel
local checkpointLabel: TextLabel
local timeLabel: TextLabel
local results: Frame
local resultList: Frame

local invitedRace: string? = nil
local lastInvite = 0
local startAt: number? = nil
local totalCheckpoints = 0
local raceStartedLocal = false

local function corner(parent: Instance, radius: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function label(parent: Instance, text: string, size: number, position: UDim2, dimension: UDim2): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextSize = size
	l.TextColor3 = Color3.new(1, 1, 1)
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Text = text
	l.Position = position
	l.Size = dimension
	l.Parent = parent
	return l
end

local function formatTime(seconds: number): string
	local minutes = math.floor(seconds / 60)
	return ("%d:%04.1f"):format(minutes, seconds - minutes * 60)
end

local function build()
	gui = Instance.new("ScreenGui")
	gui.Name = "RaceUI"
	gui.ResetOnSpawn = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	prompt = Instance.new("TextButton")
	prompt.Name = "Prompt"
	prompt.AnchorPoint = Vector2.new(0.5, 1)
	prompt.Position = UDim2.new(0.5, 0, 1, -40)
	prompt.Size = UDim2.fromOffset(320, 56)
	prompt.BackgroundColor3 = Color3.fromRGB(255, 190, 40)
	prompt.Font = Enum.Font.GothamBlack
	prompt.TextSize = 22
	prompt.TextColor3 = Color3.fromRGB(25, 25, 30)
	prompt.Visible = false
	prompt.Parent = gui
	corner(prompt, 14)

	countdownLabel = Instance.new("TextLabel")
	countdownLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	countdownLabel.Position = UDim2.fromScale(0.5, 0.4)
	countdownLabel.Size = UDim2.fromOffset(400, 140)
	countdownLabel.BackgroundTransparency = 1
	countdownLabel.Font = Enum.Font.GothamBlack
	countdownLabel.TextSize = 110
	countdownLabel.TextColor3 = Color3.fromRGB(255, 210, 60)
	countdownLabel.TextStrokeTransparency = 0.2
	countdownLabel.Visible = false
	countdownLabel.Parent = gui

	panel = Instance.new("Frame")
	panel.Name = "RacePanel"
	panel.AnchorPoint = Vector2.new(1, 0)
	panel.Position = UDim2.new(1, -16, 0, 120)
	panel.Size = UDim2.fromOffset(200, 128)
	panel.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
	panel.BackgroundTransparency = 0.25
	panel.Visible = false
	panel.Parent = gui
	corner(panel, 12)
	positionLabel = label(panel, "POS -/-", 26, UDim2.fromOffset(12, 6), UDim2.new(1, -24, 0, 32))
	checkpointLabel = label(panel, "CP 0/0", 18, UDim2.fromOffset(12, 40), UDim2.new(1, -24, 0, 22))
	timeLabel = label(panel, "0:00.0", 18, UDim2.fromOffset(12, 62), UDim2.new(1, -24, 0, 22))

	local leave = Instance.new("TextButton")
	leave.Text = "LEAVE RACE"
	leave.Font = Enum.Font.GothamBold
	leave.TextSize = 14
	leave.TextColor3 = Color3.new(1, 1, 1)
	leave.BackgroundColor3 = Color3.fromRGB(170, 50, 50)
	leave.Position = UDim2.fromOffset(12, 92)
	leave.Size = UDim2.new(1, -24, 0, 26)
	leave.Parent = panel
	corner(leave, 8)
	leave.Activated:Connect(RaceController.Leave)

	results = Instance.new("Frame")
	results.Name = "Results"
	results.AnchorPoint = Vector2.new(0.5, 0.5)
	results.Position = UDim2.fromScale(0.5, 0.45)
	results.Size = UDim2.fromOffset(420, 0)
	results.AutomaticSize = Enum.AutomaticSize.Y
	results.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
	results.BackgroundTransparency = 0.1
	results.Visible = false
	results.Parent = gui
	corner(results, 14)
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 12)
	padding.PaddingBottom = UDim.new(0, 12)
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 16)
	padding.Parent = results
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = results
	resultList = results
end

local function showResults(data: any)
	for _, child in resultList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local title = label(resultList, "RESULTAT · " .. tostring(data.RaceName or ""), 22, UDim2.new(), UDim2.new(1, 0, 0, 30))
	title.TextColor3 = Color3.fromRGB(255, 210, 60)
	title.LayoutOrder = 0
	local me = Players.LocalPlayer.UserId
	for i, result in data.Results or {} do
		local time = if result.Time then formatTime(result.Time) else "DNF"
		local reward = if (result.Reward or 0) > 0 then ("  +%d kr"):format(result.Reward) else ""
		local row = label(resultList, ("%d. %s   %s%s"):format(result.Position, result.Name, time, reward), 18, UDim2.new(), UDim2.new(1, 0, 0, 24))
		row.LayoutOrder = i
		row.Font = Enum.Font.GothamBold
		if result.UserId == me then
			row.TextColor3 = Color3.fromRGB(120, 255, 140)
		end
	end
	local close = Instance.new("TextButton")
	close.Text = "OK"
	close.Font = Enum.Font.GothamBlack
	close.TextSize = 20
	close.Size = UDim2.new(1, 0, 0, 40)
	close.BackgroundColor3 = Color3.fromRGB(255, 190, 40)
	close.LayoutOrder = 999
	close.Parent = resultList
	corner(close, 10)
	close.Activated:Connect(function()
		results.Visible = false
	end)
	results.Visible = true
	task.delay(15, function()
		results.Visible = false
	end)
end

local function join()
	if invitedRace and prompt.Visible then
		RaceController.Join(invitedRace)
		prompt.Visible = false
		lastInvite = 0
	end
end

function RaceUI.Start()
	build()

	RaceController.Invited:Connect(function(raceId: string, raceName: string, lobbyOpen: boolean)
		invitedRace = raceId
		lastInvite = os.clock()
		local action = if lobbyOpen then "JOIN RACE" else "START RACE"
		local key = if UserInputService.TouchEnabled then "" else " (E)"
		prompt.Text = ("%s%s · %s"):format(action, key, raceName)
		prompt.Visible = true
	end)
	prompt.Activated:Connect(join)
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if not gameProcessed and (input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.ButtonB) then
			join()
		end
	end)

	RaceController.SetupReceived:Connect(function(setup: any)
		startAt = setup.StartAt
		totalCheckpoints = #setup.Checkpoints
		raceStartedLocal = false
		prompt.Visible = false
		results.Visible = false
		panel.Visible = true
		positionLabel.Text = ("POS -/%d"):format(setup.Participants)
		checkpointLabel.Text = ("CP 0/%d"):format(totalCheckpoints)
		timeLabel.Text = "0:00.0"
	end)
	RaceController.CheckpointPassed:Connect(function(passed: number, total: number)
		checkpointLabel.Text = ("CP %d/%d"):format(passed, total)
	end)
	RaceController.Updated:Connect(function(position: number, total: number, _elapsed: number)
		positionLabel.Text = ("POS %d/%d"):format(position, total)
	end)
	RaceController.Finished:Connect(function(data: any)
		startAt = nil
		panel.Visible = false
		countdownLabel.Visible = false
		if not data.Left then
			showResults(data)
		end
	end)

	RunService.RenderStepped:Connect(function()
		if prompt.Visible and os.clock() - lastInvite > INVITE_TIMEOUT then
			prompt.Visible = false
		end
		local start = startAt
		if not start then
			return
		end
		local now = workspace:GetServerTimeNow()
		local left = start - now
		if left > 0 then
			countdownLabel.Visible = true
			countdownLabel.Text = tostring(math.ceil(left))
		elseif left > -1 then
			countdownLabel.Visible = true
			countdownLabel.Text = "GO!"
			raceStartedLocal = true
		else
			countdownLabel.Visible = false
		end
		if raceStartedLocal or left <= 0 then
			timeLabel.Text = formatTime(math.max(0, now - start))
		end
	end)
end

return RaceUI
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">TouchControls</string><ProtectedString name="Source"><![CDATA[--!strict
-- Körknappar för pekskärm. Visas bara på enheter med touch och bara när man kör.
-- Vänster: styr vänster/höger. Höger: gas, broms, drift, boost. Uppe till höger: återställ.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local InputController = require(script.Parent.Parent.Controllers.InputController)
local VehicleController = require(script.Parent.Parent.Controllers.VehicleController)

local TouchControls = {}

local gui: ScreenGui

local function makeButton(name: string, text: string, size: number, position: UDim2, color: Color3): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Text = text
	button.AutoButtonColor = false
	button.AnchorPoint = Vector2.new(0.5, 0.5)
	button.Size = UDim2.fromOffset(size, size)
	button.Position = position
	button.BackgroundColor3 = color
	button.BackgroundTransparency = 0.35
	button.TextColor3 = Color3.new(1, 1, 1)
	button.Font = Enum.Font.GothamBlack
	button.TextScaled = true
	button.Parent = gui

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = button

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.18, 0)
	padding.PaddingRight = UDim.new(0.18, 0)
	padding.PaddingTop = UDim.new(0.3, 0)
	padding.PaddingBottom = UDim.new(0.3, 0)
	padding.Parent = button

	return button
end

-- Håll-knapp: aktiv så länge ett finger ligger på den (fungerar med flera fingrar samtidigt).
local function bindHold(button: TextButton, inputName: string)
	local activeTouches: { [InputObject]: boolean } = {}
	local function refresh()
		local pressed = next(activeTouches) ~= nil
		InputController.SetTouch(inputName, pressed)
		button.BackgroundTransparency = if pressed then 0.1 else 0.35
	end
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			activeTouches[input] = true
			refresh()
		end
	end)
	button.InputEnded:Connect(function(input)
		activeTouches[input] = nil
		refresh()
	end)
end

local function build()
	gui = Instance.new("ScreenGui")
	gui.Name = "TouchControls"
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local grey = Color3.fromRGB(40, 40, 50)
	bindHold(makeButton("Left", "◀", 110, UDim2.new(0, 90, 1, -100), grey), "Left")
	bindHold(makeButton("Right", "▶", 110, UDim2.new(0, 215, 1, -100), grey), "Right")

	bindHold(makeButton("Gas", "GAS", 120, UDim2.new(1, -90, 1, -110), Color3.fromRGB(40, 170, 70)), "Throttle")
	bindHold(makeButton("Brake", "BRAKE", 90, UDim2.new(1, -215, 1, -70), Color3.fromRGB(190, 50, 50)), "Brake")
	bindHold(makeButton("Drift", "DRIFT", 90, UDim2.new(1, -215, 1, -175), Color3.fromRGB(220, 140, 30)), "Handbrake")
	bindHold(makeButton("Boost", "BOOST", 100, UDim2.new(1, -90, 1, -240), Color3.fromRGB(40, 150, 230)), "Boost")

	local reset = makeButton("Reset", "↻", 60, UDim2.new(1, -50, 0, 120), grey)
	reset.Activated:Connect(VehicleController.RequestReset)
end

function TouchControls.Start()
	if not UserInputService.TouchEnabled then
		return
	end
	build()
	pcall(function()
		(Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui).ScreenOrientation = Enum.ScreenOrientation.LandscapeSensor
	end)
	VehicleController.Entered:Connect(function()
		gui.Enabled = true
	end)
	VehicleController.Exited:Connect(function()
		gui.Enabled = false
		for _, name in { "Throttle", "Brake", "Left", "Right", "Handbrake", "Boost" } do
			InputController.SetTouch(name, false)
		end
	end)
end

return TouchControls
]]></ProtectedString></Properties></Item></Item></Item></Item></Item></roblox>
