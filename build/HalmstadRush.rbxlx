<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX00000009"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000008"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX00000002"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">VehicleConfig</string><ProtectedString name="Source"><![CDATA[--!strict
-- Alla siffror som styr bilens känsla. Justera här, inte i fysikkoden.
-- Enheter: studs, sekunder. 1 stud/s ≈ 1 km/h i HUD:en (1 stud ≈ 0,28 m).

local VehicleConfig = {}

VehicleConfig.Tuning = {
	-- Fjädring (raycast-hjul)
	SuspensionRestLength = 2.0, -- max avstånd montering -> hjulcentrum
	SpringStrength = 196, -- jämvikt: kompression = Gravity / SpringStrength ≈ 1 stud
	SpringDamping = 18, -- ~0,65 av kritisk dämpning: lite studsig arkadkänsla
	WheelRadius = 1.1,
	VisualSpringLength = 1.0, -- fjäderlängd i vila, används för hjulens grundposition
	MaxSteerAngle = math.rad(28), -- endast visuellt (framhjulen)

	-- Motor
	MaxSpeed = 110,
	Acceleration = 48,
	BrakeDeceleration = 110,
	ReverseAcceleration = 40,
	ReverseMaxSpeed = 35,
	Drag = 0.35, -- exponentiell fartförlust utan gas (per sekund)
	RollingResistance = 6,
	OverspeedDecel = 25, -- hur snabbt farten sjunker tillbaka efter boost

	-- Styrning
	TurnRate = 2.4, -- rad/s vid full styrning
	TurnSpeedFull = 25, -- under denna fart minskar svängförmågan (bilen svänger inte stillastående)
	HighSpeedTurnFactor = 0.55, -- andel svängförmåga kvar vid toppfart
	SteerSpeed = 5, -- hur snabbt rattutslaget når målet (per sekund)
	YawResponse = 10,

	-- Grepp och drift
	Grip = 10, -- hur snabbt sidledsfart dör ut (per sekund)
	DriftGrip = 1.3,
	GripRecovery = 4,
	DriftTurnBonus = 0.6,
	DriftMinSpeed = 35,
	DriftExitLateral = 8,
	HandbrakeDecel = 12,
	HillAssist = 0.6, -- andel av tyngdkraften i uppförsbacke som tas bort när man gasar (arkadkänsla)

	-- Luft
	AirYawControl = 2.0,
	AirUprightStrength = 7,
	AirTiltDamping = 1.5,
	ExtraGravity = 45, -- extra tyngd i luften för mer "punchiga" hopp

	-- Boost (Burnout-stil)
	BoostMaxSpeed = 165,
	BoostAcceleration = 85,
	BoostDrainPerSecond = 0.3,
	BoostStart = 0.5, -- startvärde i fas 1 så att det går att testa direkt
	ChargeDriftPerSecond = 0.18,
	ChargeAirPerSecond = 0.25,
	ChargeNearMiss = 0.12,
	NearMissDistance = 5,
	NearMissMinSpeed = 60,
	NearMissCooldown = 1.5,
	MinAirTimeForPopup = 0.6,

	-- Auto-återställning när bilen ligger på taket
	FlippedResetDelay = 2.5,
}

-- Gränser som servern kontrollerar. Klienten simulerar fysiken, servern håller koll.
VehicleConfig.Server = {
	HorizontalSpeedCap = 165 * 1.25,
	CheckInterval = 0.25,
	SpeedStrikesBeforeCorrection = 3,
	TeleportSlack = 12, -- extra studs som tolereras per kontroll
	ResetCooldown = 1.5,
}

-- Respawn och snabbresa (RespawnService)
VehicleConfig.Respawn = {
	DoubleResetWindow = 4, -- tryck R två gånger inom detta antal sekunder = till närmaste väg
	TeleportCooldown = 5,
	CheckInterval = 0.25,
	WaterMargin = 1, -- respawn när chassit är så här nära vattenytan
	RoadPointSpacing = 50,
}

-- Kollisionsgrupp för bilar och förare. Krockar inte med sig själv (spökläge i fri roam).
VehicleConfig.CollisionGroup = "Cars"

-- Bilens geometri (relativt chassits centrum). Framåt = -Z.
VehicleConfig.Geometry = {
	ChassisSize = Vector3.new(6, 1.6, 11),
	WheelMounts = {
		{ Name = "FL", Offset = Vector3.new(-3.3, -0.3, -3.8), Front = true },
		{ Name = "FR", Offset = Vector3.new(3.3, -0.3, -3.8), Front = true },
		{ Name = "RL", Offset = Vector3.new(-3.3, -0.3, 3.8), Front = false },
		{ Name = "RR", Offset = Vector3.new(3.3, -0.3, 3.8), Front = false },
	},
	WheelWidth = 1.2,
}

return VehicleConfig
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000004"><Properties><string name="Name">Map</string></Properties><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">MapData</string><ProtectedString name="Source"><![CDATA[--!strict
-- Block-out av Halmstad. Stiliserat och komprimerat, inte en exakt karta.
-- Koordinater i studs. X = öster, Z = söder (norr är -Z). Marken ligger på Y = 0.
-- Delas av server (bygger kartan, respawn) och klient (platsnamn, snabbresemeny).
--
--   Galgberget (NV)          Norra vägen / Nissansbron
--        \                     |
--   Västra ringen -- Centrum (Stora torg) | Nissan | Östra Förstaden -- Kustvägen
--        |                Slottet         |        Hamnen / industri
--   Tylösandsvägen (landsväg väster ut)   |        Östra stranden (SO)
--   Tylösand (långt i väster)           Havet (Laholmsbukten) i söder

export type Road = {
	Name: string,
	Width: number,
	Points: { Vector2 }, -- (X, Z)
	Trees: boolean?,
	LaneLines: boolean?,
}

export type Zone = {
	Name: string,
	Min: Vector2,
	Max: Vector2,
	Color: Color3,
	Material: Enum.Material,
	Layer: number, -- högre lager ritas ovanpå (undviker flimmer)
}

export type Block = {
	Min: Vector2,
	Max: Vector2,
	Style: string,
}

export type BuildingStyle = {
	CellMin: number,
	CellMax: number,
	MinHeight: number,
	MaxHeight: number,
	Gap: number, -- chans att en tomt lämnas tom (gränder och genvägar)
	Colors: { Color3 },
	RoofColor: Color3,
}

export type Hill = {
	Name: string,
	Center: Vector2,
	FlatRadius: number,
	Radius: number,
	Height: number,
	Material: Enum.Material,
}

export type Ramp = {
	Name: string,
	Start: Vector3, -- rampens nedre kant (mitt)
	Yaw: number, -- grader, 0 = stiger mot norr (-Z), 90 = mot väster, -90 = mot öster, 180 = mot söder
	Length: number,
	Angle: number,
	Width: number,
}

export type Location = {
	Id: string,
	Name: string,
	Position: Vector3,
	Yaw: number,
}

export type Area = {
	Name: string,
	Min: Vector2,
	Max: Vector2,
}

local function v(x: number, z: number): Vector2
	return Vector2.new(x, z)
end

