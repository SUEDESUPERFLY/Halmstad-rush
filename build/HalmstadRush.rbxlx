<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX0000000D"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX0000000C"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX00000004"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">EconomyConfig</string><ProtectedString name="Source"><![CDATA[--!strict
-- Pengar (kronor). Alla belopp betalas ut av servern, aldrig på klientens begäran.

local EconomyConfig = {}

EconomyConfig.Currency = "Kronor" -- namnet i leaderstats
EconomyConfig.StartMoney = 0
EconomyConfig.MaxSingleReward = 5000 -- skyddsräcke: ingen enskild utbetalning får vara större

-- Fri körning
EconomyConfig.TakedownReward = 25

return EconomyConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">RaceConfig</string><ProtectedString name="Source"><![CDATA[--!strict
-- Race. Banorna följer de genererade rutterna (src/server/Map/Generated/CityRoutes.luau).

export type RaceDefinition = {
	Id: string,
	Name: string,
	Route: string, -- namn i CityRoutes
	StartIndex: number, -- ruttpunkt där start/mål ligger
	CheckpointSpacing: number, -- ruttpunkter mellan kontrollpunkter (≈ 20 studs per punkt)
	Laps: number,
	Rivals: number,
	RivalSpeeds: { number },
	Rewards: { number }, -- kronor per placering (1:a, 2:a, ...), sista värdet gäller resten
}

local RaceConfig = {}

RaceConfig.Races = {
	{
		Id = "StoraRingen",
		Name = "Stora ringen",
		Route = "StoraRingen",
		StartIndex = 3,
		CheckpointSpacing = 22,
		Laps = 1,
		Rivals = 3,
		RivalSpeeds = { 92, 100, 108 },
		Rewards = { 500, 300, 200, 100 },
	},
} :: { RaceDefinition }

RaceConfig.CollisionGroup = "RaceCars" -- deltagare krockar med varandra och trafiken, inte med andra spelare
RaceConfig.StartRadius = 30 -- så nära startmarkeringen man måste vara för att starta/gå med
RaceConfig.LobbyTime = 8 -- sekunder andra kan gå med innan start
RaceConfig.Countdown = 3.5
RaceConfig.CheckpointRadius = 42
RaceConfig.FinishTimeout = 30 -- efter att första bilen gått i mål
RaceConfig.MaxRaceTime = 300
RaceConfig.MaxParticipants = 8 -- spelare + NPC-motståndare
RaceConfig.CooldownAfterRace = 5
RaceConfig.TakedownBonus = 50 -- kronor per takedown under racet
RaceConfig.GridMoveTolerance = 15 -- studs man får rulla från startrutan under nedräkningen
RaceConfig.RubberBand = 0.0015 -- NPC-motståndarnas fartjustering per ruttpunkt efter/före ledande spelare
RaceConfig.RubberBandMax = 0.25
RaceConfig.RivalWreckDuration = 2.5
RaceConfig.PlayerTakedownRadius = 25 -- kvaddad racedeltagare med en annan deltagare så nära = takedown

function RaceConfig.Find(id: string): RaceDefinition?
	for _, race in RaceConfig.Races do
		if race.Id == id then
			return race
		end
	end
	return nil
end

return RaceConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">VehicleConfig</string><ProtectedString name="Source"><![CDATA[--!strict
-- Alla siffror som styr bilens känsla. Justera här, inte i fysikkoden.
-- Enheter: studs, sekunder. 1 stud/s ≈ 1 km/h i HUD:en (1 stud ≈ 0,28 m).

local VehicleConfig = {}

VehicleConfig.Tuning = {
	-- Fjädring (raycast-hjul)
	SuspensionRestLength = 2.0, -- max avstånd montering -> hjulcentrum
	SpringStrength = 196, -- jämvikt: kompression = Gravity / SpringStrength ≈ 1 stud
	SpringDamping = 18, -- ~0,65 av kritisk dämpning: lite studsig arkadkänsla
	WheelRadius = 1.1,
	VisualSpringLength = 1.0, -- fjäderlängd i vila, används för hjulens grundposition
	MaxSteerAngle = math.rad(28), -- endast visuellt (framhjulen)

	-- Motor
	MaxSpeed = 110,
	Acceleration = 48,
	BrakeDeceleration = 110,
	ReverseAcceleration = 40,
	ReverseMaxSpeed = 35,
	Drag = 0.35, -- exponentiell fartförlust utan gas (per sekund)
	RollingResistance = 6,
	OverspeedDecel = 25, -- hur snabbt farten sjunker tillbaka efter boost

	-- Styrning
	TurnRate = 2.4, -- rad/s vid full styrning
	TurnSpeedFull = 25, -- under denna fart minskar svängförmågan (bilen svänger inte stillastående)
	HighSpeedTurnFactor = 0.55, -- andel svängförmåga kvar vid toppfart
	SteerSpeed = 5, -- hur snabbt rattutslaget når målet (per sekund)
	YawResponse = 10,

	-- Grepp och drift
	Grip = 10, -- hur snabbt sidledsfart dör ut (per sekund)
	DriftGrip = 1.3,
	GripRecovery = 4,
	DriftTurnBonus = 0.6,
	DriftMinSpeed = 35,
	DriftExitLateral = 8,
	HandbrakeDecel = 12,
	HillAssist = 0.6, -- andel av tyngdkraften i uppförsbacke som tas bort när man gasar (arkadkänsla)

	-- Luft
	AirYawControl = 2.0,
	AirUprightStrength = 7,
	AirTiltDamping = 1.5,
	ExtraGravity = 45, -- extra tyngd i luften för mer "punchiga" hopp

	-- Boost (Burnout-stil)
	BoostMaxSpeed = 165,
	BoostAcceleration = 85,
	BoostDrainPerSecond = 0.3,
	BoostStart = 0.5, -- startvärde i fas 1 så att det går att testa direkt
	ChargeDriftPerSecond = 0.18,
	ChargeAirPerSecond = 0.25,
	ChargeNearMiss = 0.12,
	NearMissDistance = 5,
	NearMissMinSpeed = 60,
	NearMissCooldown = 1.5,
	MinAirTimeForPopup = 0.6,

	-- Auto-återställning när bilen ligger på taket
	FlippedResetDelay = 2.5,
}

-- Gränser som servern kontrollerar. Klienten simulerar fysiken, servern håller koll.
VehicleConfig.Server = {
	HorizontalSpeedCap = 165 * 1.25,
	CheckInterval = 0.25,
	SpeedStrikesBeforeCorrection = 3,
	TeleportSlack = 12, -- extra studs som tolereras per kontroll
	ResetCooldown = 1.5,
}

-- Respawn och snabbresa (RespawnService)
VehicleConfig.Respawn = {
	DoubleResetWindow = 4, -- tryck R två gånger inom detta antal sekunder = till närmaste väg
	TeleportCooldown = 5,
	CheckInterval = 0.25,
	WaterMargin = 1, -- respawn när chassit är så här nära vattenytan
	RoadPointSpacing = 50,
}

-- Krockar och takedowns (fas 3)
VehicleConfig.Crash = {
	LightImpact = 30, -- studs/s fartändring på en bildruta: gnistor och skak
	WreckImpact = 70, -- hård smäll: bilen kvaddas
	WreckMinSpeed = 55, -- man måste ha kört minst så här fort för att kvaddas
	WreckDuration = 1.8, -- krockkamerans längd innan respawn
	TakedownCamDuration = 1.1,
	ChargeTakedown = 0.3, -- boost för en takedown
	TeleportDistance = 25, -- större hopp än så på en bildruta = teleport, inte krock
	IgnoreAfterTeleport = 1.5,
	ReportWreckCooldown = 2, -- servern: minsta tid mellan två respawn efter kvaddning
}

-- NPC-bilar som kör runt på huvudgatorna (fas 3)
VehicleConfig.Npc = {
	CollisionGroup = "NPCCars",
	PerRoute = { StoraRingen = 7, Vastra = 3 },
	CruiseSpeed = 62,
	Acceleration = 35,
	Grip = 8,
	TurnGain = 3,
	MaxYawRate = 1.8,
	YawResponse = 6,
	WaypointRadius = 16,
	ImpactThreshold = 22, -- fartändring som räknas som en smäll
	WreckImpact = 38, -- smäll som kvaddar NPC-bilen
	HitRadius = 22, -- spelarbil inom detta avstånd vid smällen = den som knuffade
	TakedownWindow = 3, -- sekunder efter knuffen som en kvaddning räknas som takedown
	WreckDuration = 4,
	StuckTime = 5,
	MinSpawnDistance = 120, -- respawna inte närmare spelare än så
	Colors = {
		Color3.fromRGB(235, 235, 235),
		Color3.fromRGB(70, 70, 75),
		Color3.fromRGB(150, 160, 170),
		Color3.fromRGB(30, 60, 110),
		Color3.fromRGB(120, 30, 30),
		Color3.fromRGB(200, 190, 160),
	},
}

-- Kollisionsgrupp för bilar och förare. Krockar inte med sig själv (spökläge i fri roam).
VehicleConfig.CollisionGroup = "Cars"

-- Bilens geometri (relativt chassits centrum). Framåt = -Z.
VehicleConfig.Geometry = {
	ChassisSize = Vector3.new(6, 1.6, 11),
	WheelMounts = {
		{ Name = "FL", Offset = Vector3.new(-3.3, -0.3, -3.8), Front = true },
		{ Name = "FR", Offset = Vector3.new(3.3, -0.3, -3.8), Front = true },
		{ Name = "RL", Offset = Vector3.new(-3.3, -0.3, 3.8), Front = false },
		{ Name = "RR", Offset = Vector3.new(3.3, -0.3, 3.8), Front = false },
	},
	WheelWidth = 1.2,
}

return VehicleConfig
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000006"><Properties><string name="Name">Map</string></Properties><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">MapData</string><ProtectedString name="Source"><![CDATA[--!strict
-- Halmstad, byggt från stadskartan (Destination Halmstad, City 2023).
-- Själva stadens markmaterial, hus och respawnpunkter genereras av tools/map/build_city.py
-- till src/server/Map/Generated/. Den här modulen innehåller allt som sätts för hand:
-- landmärken, platser, stadsdelar, kullar och områdena utanför kartan (Tylösand, kusten).
--
-- Skala: 1 kartpixel = 2 studs (≈ 1:3,6 mot verkligheten). Origo (0, 0) = Stora torg.
-- X = öster, Z = söder (norr är -Z). Marken ligger på Y = 0.

export type Hill = {
	Name: string,
	Center: Vector2,
	FlatRadius: number,
	Radius: number,
	Height: number,
	Material: Enum.Material,
}

export type Location = {
	Id: string,
	Name: string,
	Position: Vector3,
	Yaw: number, -- grader, 0 = norr
	SnapToRoad: boolean?, -- flytta till närmaste gatupunkt (stadens gator är genererade)
}

export type Sign = {
	Kind: string, -- "Billboard" | "Highway" | "Plaque" | "Arch"
	Text: string,
	SubText: string?,
	Position: Vector3,
	Yaw: number, -- hållet framsidan vänds mot (0 = norr, 90 = väster, -90 = öster, 180 = söder)
	Width: number,
	Color: Color3,
	TextColor: Color3?,
}

export type Road = {
	Name: string,
	Width: number,
	Points: { Vector2 },
}

export type District = {
	Name: string,
	Position: Vector2,
}

local function v(x: number, z: number): Vector2
	return Vector2.new(x, z)
end

local MapData = {}

MapData.WaterLevel = -4 -- Terrain-vatten fylls från -12 upp till hit

-- Stadskartans rutnät (se Generated/CityGrid). Havet tar vid söder om kusten.
MapData.City = { MinX = -2272, MaxX = 2264, MinZ = -1304, MaxZ = 1844 }
MapData.CoastZ = 1844
MapData.TylosandCoastZ = 1150 -- kusten väster om stadskartan

MapData.Bounds = {
	{ Min = v(-4800, -1700), Max = v(2800, 2700) }, -- Halmstad med omnejd
	{ Min = v(5200, -800), Max = v(6800, 800) }, -- testbanan
}

MapData.TestTrackOrigin = Vector3.new(6000, 0, 0)

MapData.Hills = {
	-- Galgberget med utsiktstornet. Gator och hus i backen följer terrängen.
	{ Name = "Galgberget", Center = v(-394, -1158), FlatRadius = 50, Radius = 430, Height = 36, Material = Enum.Material.Grass },
	{ Name = "Dyn 1", Center = v(-4300, 1112), FlatRadius = 0, Radius = 26, Height = 5, Material = Enum.Material.Sand },
	{ Name = "Dyn 2", Center = v(-3500, 1115), FlatRadius = 0, Radius = 26, Height = 5, Material = Enum.Material.Sand },
} :: { Hill }

-- Landmärken (lägen uppmätta på kartan)
MapData.Landmarks = {
	Church = { Center = v(-109, 78), Length = 70, Width = 32 }, -- S:t Nikolai kyrka, torn i väster
	Castle = { Center = v(-10, 335), Size = v(100, 70) }, -- Halmstads slott vid Nissan
	Library = { Center = v(310, -210), Yaw = 15 }, -- Stadsbiblioteket, delvis över ån
	NorrePort = { Position = v(86, -408), Yaw = 12 },
	LookoutTower = v(-394, -1158), -- Galgbergets utsiktstorn
	Hallandsgarden = v(-212, -1086), -- friluftsmuseet
	Hotel = v(-4150, 960), -- strandhotellet i Tylösand (generiskt namn)
	Pier = { Start = v(-4000, 1150), Length = 200, Width = 14 }, -- badbryggan i Tylösand
	Breakwater = { Start = v(-100, 1844), Length = 220, Width = 14 }, -- pir vid Nissans mynning
	Ship = { Center = v(80, 2010), Length = 150, Width = 30, Name = "M/S LAXEN" },
	WindTurbines = { v(-3000, 620), v(-3300, 560), v(-3600, 640) },
}

-- Vägar utanför stadskartan (Terrain-asfalt). Tylösandsvägen fortsätter där
-- Slottsjordsvägen lämnar kartan i väster.
MapData.ExtraRoads = {
	{
		Name = "Tylösandsvägen",
		Width = 30,
		Points = { v(-2272, 786), v(-2700, 790), v(-3150, 860), v(-3550, 960), v(-3800, 1030) },
	},
	{ Name = "Tylösand strandväg", Width = 26, Points = { v(-4550, 1050), v(-3300, 1050) } },
} :: { Road }

MapData.Beaches = {
	{
		Name = "Tylösand",
		Min = v(-4560, 1085),
		Max = v(-3300, 1145),
		Lifeguards = { -4350, -3700 },
		Volleyball = v(-3600, 1100),
		Surfboards = v(-4200, 1090),
		Keep = { -4000 },
	},
	{
		Name = "Östra stranden",
		Min = v(-60, 1800),
		Max = v(2240, 1840),
		Lifeguards = { 400, 1300, 2000 },
		Volleyball = v(900, 1815),
		Surfboards = v(150, 1803),
		Keep = { -100 },
	},
}

local SIGN_BLUE = Color3.fromRGB(30, 80, 160)
local SIGN_BROWN = Color3.fromRGB(120, 70, 40) -- turistskyltar i Sverige är bruna

MapData.Signs = {
	{ Kind = "Billboard", Text = "VÄLKOMMEN TILL HALMSTAD", Position = Vector3.new(-2500, 0, 825), Yaw = 90, Width = 44, Color = SIGN_BLUE },
	{ Kind = "Highway", Text = "Tylösand  ↑", SubText = "Halmstad C  ↓", Position = Vector3.new(-2400, 0, 755), Yaw = -90, Width = 26, Color = SIGN_BLUE },
	{ Kind = "Highway", Text = "Halmstad C  ↑", SubText = "Tylösand  ↓", Position = Vector3.new(-3300, 0, 935), Yaw = 75, Width = 26, Color = SIGN_BLUE },
	{ Kind = "Arch", Text = "TYLÖSAND", Position = Vector3.new(-3400, 0, 1050), Yaw = -90, Width = 40, Color = SIGN_BROWN },
	{ Kind = "Arch", Text = "ÖSTRA STRANDEN", Position = Vector3.new(120, 0, 1776), Yaw = 90, Width = 40, Color = SIGN_BROWN },
	{ Kind = "Plaque", Text = "HALMSTADS SLOTT", Position = Vector3.new(-62, 0, 292), Yaw = 0, Width = 18, Color = SIGN_BROWN },
	{ Kind = "Plaque", Text = "S:T NIKOLAI KYRKA", Position = Vector3.new(-109, 0, 100), Yaw = 180, Width = 18, Color = SIGN_BROWN },
	{ Kind = "Plaque", Text = "UTSIKTSTORNET", Position = Vector3.new(-394, 0, -1128), Yaw = 180, Width = 16, Color = SIGN_BROWN },
	{ Kind = "Plaque", Text = "HALLANDSGÅRDEN", Position = Vector3.new(-212, 0, -1052), Yaw = 180, Width = 18, Color = SIGN_BROWN },
	{ Kind = "Plaque", Text = "STADSBIBLIOTEKET", Position = Vector3.new(266, 0, -176), Yaw = 90, Width = 18, Color = SIGN_BROWN },
} :: { Sign }

-- Stadsdelsnamn (lägen från kartans lila etiketter). Närmaste namn visas.
MapData.Districts = {
	{ Name = "Galgberget", Position = v(-500, -1180) },
	{ Name = "Nickedala", Position = v(-2100, -800) },
	{ Name = "Karlsro", Position = v(-2118, -110) },
	{ Name = "Rotorp", Position = v(-1538, 188) },
	{ Name = "Alet", Position = v(-1596, 992) },
	{ Name = "Söder", Position = v(-684, 1128) },
	{ Name = "Gamletull", Position = v(402, -510) },
	{ Name = "Furet", Position = v(1042, -994) },
	{ Name = "Nyatorp", Position = v(1100, -160) },
	{ Name = "Nyhem", Position = v(1430, 906) },
	{ Name = "Östergård", Position = v(2108, 402) },
	{ Name = "Sannarp", Position = v(2186, -606) },
	{ Name = "Linehed", Position = v(2166, 1042) },
	{ Name = "Centrum", Position = v(0, 150) },
} :: { District }

-- Områden som vinner över närmaste stadsdel (första träffen gäller)
MapData.SpecialAreas = {
	{ Name = "Stora torg", Min = v(-90, -50), Max = v(85, 50) },
	{ Name = "Testbanan", Min = v(5200, -800), Max = v(6800, 800) },
	{ Name = "Tylösand", Min = v(-4800, 900), Max = v(-3300, 2700) },
	{ Name = "Tylösandsvägen", Min = v(-4800, -1700), Max = v(-2272, 2700) },
	{ Name = "Östra stranden", Min = v(-60, 1780), Max = v(2800, 2700) },
}

MapData.Locations = {
	{ Id = "StoraTorg", Name = "Stora torg", Position = Vector3.new(0, 0, 24), Yaw = 0 },
	{ Id = "Slottet", Name = "Halmstads slott", Position = Vector3.new(-40, 0, 270), Yaw = 0, SnapToRoad = true },
	{ Id = "NorreKatt", Name = "Norre Katts park", Position = Vector3.new(120, 0, -470), Yaw = 0, SnapToRoad = true },
	{ Id = "Biblioteket", Name = "Stadsbiblioteket", Position = Vector3.new(380, 0, -200), Yaw = 0, SnapToRoad = true },
	{ Id = "Galgberget", Name = "Galgberget", Position = Vector3.new(-360, 0, -1100), Yaw = 0, SnapToRoad = true },
	{ Id = "Centralen", Name = "Halmstad C", Position = Vector3.new(362, 0, 654), Yaw = 0, SnapToRoad = true },
	{ Id = "Arena", Name = "Halmstad Arena", Position = Vector3.new(2000, 0, -24), Yaw = 0, SnapToRoad = true },
	{ Id = "Hogskolan", Name = "Högskolan", Position = Vector3.new(1546, 0, 1276), Yaw = 0, SnapToRoad = true },
	{ Id = "RaceStoraRingen", Name = "Race: Stora ringen", Position = Vector3.new(-250, 0, 230), Yaw = -90 },
	{ Id = "OstraStranden", Name = "Östra stranden", Position = Vector3.new(600, 0, 1776), Yaw = -90 },
	{ Id = "Tylosand", Name = "Tylösand", Position = Vector3.new(-3500, 0, 1050), Yaw = 90 },
	{ Id = "Testbanan", Name = "Testbanan", Position = Vector3.new(6000, 0, 300), Yaw = 0 },
} :: { Location }

-- Höjden på en kulle i punkten (x, z). Samma formel används när terrängen byggs.
function MapData.HillHeight(hill: Hill, x: number, z: number): number
	local r = math.sqrt((x - hill.Center.X) ^ 2 + (z - hill.Center.Y) ^ 2)
	if r <= hill.FlatRadius then
		return hill.Height
	elseif r >= hill.Radius then
		return 0
	end
	local t = (r - hill.FlatRadius) / (hill.Radius - hill.FlatRadius)
	return hill.Height * (0.5 + 0.5 * math.cos(math.pi * t))
end

function MapData.GroundHeightAt(x: number, z: number): number
	local best = 0
	for _, hill in MapData.Hills do
		best = math.max(best, MapData.HillHeight(hill, x, z))
	end
	return best
end

-- Spelarnas startplats: två rader om fem bilar på Stora torg (fontänen i mitten), vända mot norr.
function MapData.PlayerSpawn(slot: number): CFrame
	local column = (slot - 1) % 5
	local row = math.floor((slot - 1) / 5) % 2
	return CFrame.new((column - 2) * 14, 4, if row == 0 then 24 else -24)
end

function MapData.LocationCFrame(location: Location): CFrame
	local p = location.Position
	local y = MapData.GroundHeightAt(p.X, p.Z)
	return CFrame.new(p.X, y + 4, p.Z) * CFrame.Angles(0, math.rad(location.Yaw), 0)
end

function MapData.FindLocation(id: string): Location?
	for _, location in MapData.Locations do
		if location.Id == id then
			return location
		end
	end
	return nil
end

function MapData.IsInBounds(position: Vector3): boolean
	for _, area in MapData.Bounds do
		if position.X >= area.Min.X and position.X <= area.Max.X and position.Z >= area.Min.Y and position.Z <= area.Max.Y then
			return true
		end
	end
	return false
end

function MapData.DistrictAt(position: Vector3): string?
	for _, area in MapData.SpecialAreas do
		if position.X >= area.Min.X and position.X <= area.Max.X and position.Z >= area.Min.Y and position.Z <= area.Max.Y then
			return area.Name
		end
	end
	local best: string? = nil
	local bestDistance = math.huge
	for _, district in MapData.Districts do
		local d = (Vector2.new(position.X, position.Z) - district.Position).Magnitude
		if d < bestDistance then
			best, bestDistance = district.Name, d
		end
	end
	return best
end

return MapData
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--!strict
-- Alla RemoteEvents definieras här. Bara servern skapar dem; klienten väntar in dem.
-- Varje handler på servern MÅSTE validera argument och takt (rate limit).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

Remotes.Names = {
	ResetVehicle = "ResetVehicle", -- klient -> server, inga argument
	TeleportToLocation = "TeleportToLocation", -- klient -> server, (locationId: string)
	Notify = "Notify", -- server -> klient, (text: string, kind: string)
	ReportWreck = "ReportWreck", -- klient -> server, inga argument (min bil är kvaddad, flytta mig)
	Takedown = "Takedown", -- server -> klient, (npcChassis: BasePart) du gjorde en takedown
	CrashEffect = "CrashEffect", -- server -> alla, (position: Vector3, strength: number) NPC-krock
	RaceInvite = "RaceInvite", -- server -> klient, (raceId, raceName, lobbyOpen: boolean) du står vid en startlinje
	RequestJoinRace = "RequestJoinRace", -- klient -> server, (raceId: string)
	LeaveRace = "LeaveRace", -- klient -> server, inga argument
	RaceSetup = "RaceSetup", -- server -> klient, (setup: table) kontrollpunkter och starttid
	RaceCheckpoint = "RaceCheckpoint", -- server -> klient, (passedIndex: number)
	RaceUpdate = "RaceUpdate", -- server -> klient, (position, participants, elapsed)
	RaceFinished = "RaceFinished", -- server -> klient, (results: table)
}

local FOLDER_NAME = "Remotes"

local function getFolder(): Folder
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		return folder :: Folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
end

function Remotes.Get(name: string): RemoteEvent
	assert(Remotes.Names[name], "Okänd remote: " .. name)
	local folder = getFolder()
	if RunService:IsServer() then
		local remote = folder:FindFirstChild(name)
		if not remote then
			remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
		return remote :: RemoteEvent
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000009"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[--!strict
-- Minimal signal för kommunikation mellan moduler på samma sida (klient eller server).

export type Connection = {
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, callback: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
}

local Signal = {}

function Signal.new(): Signal
	local listeners: { [number]: ((...any) -> ())? } = {}
	local nextId = 0
	local self = {}

	function self:Connect(callback: (...any) -> ()): Connection
		nextId += 1
		local id = nextId
		listeners[id] = callback
		local connection = {}
		function connection:Disconnect()
			listeners[id] = nil
		end
		return connection :: Connection
	end

	function self:Fire(...: any)
		for _, callback in listeners do
			if callback then
				task.spawn(callback, ...)
			end
		end
	end

	return self :: Signal
end

return Signal
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX0000000B"><Properties><string name="Name">Vehicle</string></Properties><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Suspension</string><ProtectedString name="Source"><![CDATA[--!strict
-- Raycast-fjädring som delas av spelarbilar (klienten) och NPC-bilar (servern).
-- Varje hjul har en monteringspunkt (Attachment) och en VectorForce som trycker upp chassit.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VehicleConfig = require(ReplicatedStorage.Shared.Config.VehicleConfig)

local T = VehicleConfig.Tuning

export type Wheel = {
	Mount: Attachment,
	Force: VectorForce,
	SpringLength: number,
}

local Suspension = {}

-- Hittar hjulen ("Mount_*" på chassit) i en bil byggd av CarBuilder.
function Suspension.FindWheels(chassis: BasePart): { Wheel }
	local wheels: { Wheel } = {}
	for _, child in chassis:GetChildren() do
		if child:IsA("Attachment") and child.Name:sub(1, 6) == "Mount_" then
			table.insert(wheels, {
				Mount = child,
				Force = child:FindFirstChild("Spring") :: VectorForce,
				SpringLength = T.VisualSpringLength,
			})
		end
	end
	return wheels
end

-- Uppdaterar fjäderkrafterna. Returnerar antal hjul i marken och summan av markens normaler.
function Suspension.Update(root: BasePart, wheels: { any }, rayParams: RaycastParams): (number, Vector3)
	local cf = root.CFrame
	local up = cf.UpVector
	local mass = root.AssemblyMass
	local rayLength = T.SuspensionRestLength + T.WheelRadius
	local maxForce = mass * workspace.Gravity * 4
	local grounded = 0
	local normalSum = Vector3.zero

	for _, wheel in wheels do
		local mountPos = wheel.Mount.WorldPosition
		local result = workspace:Raycast(mountPos, -up * rayLength, rayParams)
		if result then
			grounded += 1
			normalSum += result.Normal
			local springLength = math.max(result.Distance - T.WheelRadius, 0)
			local compression = T.SuspensionRestLength - springLength
			local pointVelocity = root:GetVelocityAtPosition(mountPos):Dot(up)
			local force = (mass / 4) * (T.SpringStrength * compression - T.SpringDamping * pointVelocity)
			wheel.Force.Force = up * math.clamp(force, 0, maxForce)
			wheel.SpringLength = springLength
		else
			wheel.Force.Force = Vector3.zero
			wheel.SpringLength = T.SuspensionRestLength
		end
	end

	return grounded, normalSum
end

-- Nollställer krafterna (t.ex. när en bil är kraschad och ska tumla fritt).
function Suspension.Release(wheels: { any })
	for _, wheel in wheels do
		wheel.Force.Force = Vector3.zero
	end
end

return Suspension
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000026"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000025"><Properties><string name="Name">Server</string><ProtectedString name="Source"><![CDATA[--!strict
-- Serverns startpunkt. Laddar alla services i Services/, kör Init() på alla
-- och därefter Start() på alla. Init: skapa saker och koppla ihop. Start: börja köra.

local servicesFolder = script:WaitForChild("Services")

type Service = {
	Init: (() -> ())?,
	Start: (() -> ())?,
}

local services: { [string]: Service } = {}

for _, module in servicesFolder:GetChildren() do
	if module:IsA("ModuleScript") then
		services[module.Name] = require(module) :: any
	end
end

for name, service in services do
	if service.Init then
		local ok, err = pcall(service.Init)
		if not ok then
			warn(("[Server] %s.Init misslyckades: %s"):format(name, tostring(err)))
		end
	end
end

for name, service in services do
	if service.Start then
		task.spawn(function()
			local ok, err = pcall(service.Start :: () -> ())
			if not ok then
				warn(("[Server] %s.Start misslyckades: %s"):format(name, tostring(err)))
			end
		end)
	end
end

print("[Server] Halmstad Rush startad")
]]></ProtectedString></Properties><Item class="Folder" referent="RBX00000017"><Properties><string name="Name">Map</string></Properties><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">CityBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- Bygger Halmstad från de genererade kartdatafilerna:
--  * Terrain: ett material per 4x4-studs-ruta (asfalt, trottoar, gräs, vatten, broar, sand)
--  * Hus: ett block per fotavtryck, med färg och material efter stadsdelens stil
--  * Respawnpunkter mitt på gatorna
-- Allt utanför stadskartan (havet, Tylösand, Galgbergets norra sida) byggs också här.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MapData = require(ReplicatedStorage.Shared.Map.MapData)
local Geometry = require(script.Parent.Geometry)
local CityGrid = require(script.Parent.Generated.CityGrid)
local CityBuildings = require(script.Parent.Generated.CityBuildings)
local CityRoadPoints = require(script.Parent.Generated.CityRoadPoints)

local CityBuilder = {}

local CELL = CityGrid.CellSize
local BOTTOM = -16 -- terrängens undersida
local CHUNK = 64 -- celler per WriteVoxels-anrop i varje led

local Material = Enum.Material

-- Kod -> markmaterial (W = vatten, D = brodäck över vatten)
local SURFACE: { [string]: Enum.Material } = {
	A = Material.Asphalt,
	Y = Material.Asphalt,
	B = Material.Pavement,
	P = Material.Grass,
	G = Material.Concrete,
	F = Material.LeafyGrass,
	S = Material.Grass,
	R = Material.Pavement,
	N = Material.Sand,
}

local codeBytes: buffer
local codeOf: { [number]: string } = {}

local function decodeGrid()
	local width, height = CityGrid.Width, CityGrid.Height
	codeBytes = buffer.create(width * height)
	local codes = CityGrid.Codes
	local indexOf: { [string]: number } = {}
	for i = 1, #codes do
		local ch = codes:sub(i, i)
		indexOf[ch] = i
		codeOf[i] = ch
	end
	for row, line in CityGrid.Rows do
		local offset = (row - 1) * width
		for ch, count in line:gmatch("(%a)(%d+)") do
			local n = tonumber(count) :: number
			buffer.fill(codeBytes, offset, indexOf[ch], n)
			offset += n
		end
	end
end

-- Koden för rutan som innehåller världspunkten (x, z), eller nil utanför stadskartan.
function CityBuilder.CodeAt(x: number, z: number): string?
	local cx = math.floor((x - CityGrid.OriginX) / CELL)
	local cz = math.floor((z - CityGrid.OriginZ) / CELL)
	if cx < 0 or cz < 0 or cx >= CityGrid.Width or cz >= CityGrid.Height then
		return nil
	end
	return codeOf[buffer.readu8(codeBytes, cz * CityGrid.Width + cx)]
end

-- Skriver terräng för ett rektangulärt område (i hela celler) med en materialfunktion.
local function writeArea(minX: number, minZ: number, countX: number, countZ: number, codeAt: (number, number) -> string)
	for chunkX = 0, countX - 1, CHUNK do
		for chunkZ = 0, countZ - 1, CHUNK do
			local nx = math.min(CHUNK, countX - chunkX)
			local nz = math.min(CHUNK, countZ - chunkZ)
			local x0 = minX + chunkX * CELL
			local z0 = minZ + chunkZ * CELL

			local codes = table.create(nx * nz)
			local heights = table.create(nx * nz)
			local maxHeight = 0
			for ix = 1, nx do
				local x = x0 + (ix - 0.5) * CELL
				for iz = 1, nz do
					local z = z0 + (iz - 0.5) * CELL
					local index = (ix - 1) * nz + iz
					codes[index] = codeAt(x, z)
					local h = MapData.GroundHeightAt(x, z)
					heights[index] = h
					if h > maxHeight then
						maxHeight = h
					end
				end
			end

			local top = math.max(0, math.ceil(maxHeight / CELL) * CELL)
			local layers = (top - BOTTOM) / CELL
			local materials = table.create(nx)
			local occupancies = table.create(nx)
			for ix = 1, nx do
				local matX = table.create(layers)
				local occX = table.create(layers)
				for iy = 1, layers do
					matX[iy] = table.create(nz)
					occX[iy] = table.create(nz)
				end
				for iz = 1, nz do
					local index = (ix - 1) * nz + iz
					local code = codes[index]
					local h = heights[index]
					local surface = SURFACE[code] or Material.Grass
					for iy = 1, layers do
						local y0 = BOTTOM + (iy - 1) * CELL
						local material, occupancy = Material.Air, 0
						if code == "W" or code == "D" then
							if y0 < -12 then
								material, occupancy = Material.Sand, 1
							elseif y0 < -4 then
								material, occupancy = Material.Water, 1
							elseif code == "D" and y0 < 0 then
								material, occupancy = Material.Asphalt, 1
							end
						else
							occupancy = math.clamp((h - y0) / CELL, 0, 1)
							if occupancy > 0 then
								material = surface
							end
						end
						matX[iy][iz] = material
						occX[iy][iz] = occupancy
					end
				end
				materials[ix] = matX
				occupancies[ix] = occX
			end

			local region = Region3.new(Vector3.new(x0, BOTTOM, z0), Vector3.new(x0 + nx * CELL, top, z0 + nz * CELL))
			workspace.Terrain:WriteVoxels(region, CELL, materials, occupancies)
		end
		task.wait() -- låt servern andas mellan kolumnerna
	end
end

local function terrainBox(min: Vector3, max: Vector3, material: Enum.Material)
	local size = max - min
	local maxChunk = 1024
	local nx = math.max(1, math.ceil(size.X / maxChunk))
	local nz = math.max(1, math.ceil(size.Z / maxChunk))
	local chunkSize = Vector3.new(size.X / nx, size.Y, size.Z / nz)
	for ix = 0, nx - 1 do
		for iz = 0, nz - 1 do
			local chunkMin = min + Vector3.new(ix * chunkSize.X, 0, iz * chunkSize.Z)
			workspace.Terrain:FillBlock(CFrame.new(chunkMin + chunkSize / 2), chunkSize, material)
		end
	end
end

local function terrainRoad(a: Vector2, b: Vector2, width: number)
	local from = Vector3.new(a.X, -2, a.Y)
	local to = Vector3.new(b.X, -2, b.Y)
	local length = (to - from).Magnitude + width
	workspace.Terrain:FillBlock(CFrame.lookAt((from + to) / 2, to), Vector3.new(width, 4, length), Material.Asphalt)
end

local function setTerrainLook()
	local terrain = workspace.Terrain
	terrain:SetMaterialColor(Material.Asphalt, Color3.fromRGB(62, 64, 70))
	terrain:SetMaterialColor(Material.Pavement, Color3.fromRGB(176, 170, 160))
	terrain:SetMaterialColor(Material.Concrete, Color3.fromRGB(150, 150, 152))
	terrain:SetMaterialColor(Material.Grass, Color3.fromRGB(96, 140, 70))
	terrain:SetMaterialColor(Material.LeafyGrass, Color3.fromRGB(128, 150, 80))
	terrain:SetMaterialColor(Material.Sand, Color3.fromRGB(226, 208, 160))
	terrain.WaterColor = Color3.fromRGB(40, 95, 115)
	terrain.WaterTransparency = 0.5
	terrain.WaterReflectance = 0.6
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 8
end

function CityBuilder.BuildTerrain()
	decodeGrid()
	setTerrainLook()
	local city = MapData.City
	local landTop = 0

	-- 1) Gräsmark under hela världen norr om kusten
	terrainBox(Vector3.new(-4800, BOTTOM, -1700), Vector3.new(2800, landTop, MapData.CoastZ), Material.Grass)
	-- 2) Havet söder om kusten och väster om stadskartan (sandbotten + vatten)
	for _, area in
		{
			{ Vector2.new(-4800, MapData.CoastZ), Vector2.new(2800, 2700) },
			{ Vector2.new(-4800, MapData.TylosandCoastZ), Vector2.new(city.MinX, MapData.CoastZ) },
		}
	do
		local min, max = area[1], area[2]
		terrainBox(Vector3.new(min.X, BOTTOM, min.Y), Vector3.new(max.X, -12, max.Y), Material.Sand)
		terrainBox(Vector3.new(min.X, -12, min.Y), Vector3.new(max.X, -4, max.Y), Material.Water)
		terrainBox(Vector3.new(min.X, -4, min.Y), Vector3.new(max.X, landTop, max.Y), Material.Air)
	end
	-- 3) Tylösands strand
	terrainBox(Vector3.new(-4600, BOTTOM, 1072), Vector3.new(city.MinX, landTop, MapData.TylosandCoastZ), Material.Sand)

	-- 4) Själva stadskartan
	local countX = CityGrid.Width
	local countZ = CityGrid.Height
	writeArea(CityGrid.OriginX, CityGrid.OriginZ, countX, countZ, function(x, z)
		return CityBuilder.CodeAt(x, z) or "P"
	end)

	-- 5) Galgbergets norra del utanför kartan, och sanddyner
	for _, hill in MapData.Hills do
		local minX = math.floor((hill.Center.X - hill.Radius) / CELL) * CELL
		local minZ = math.floor((hill.Center.Y - hill.Radius) / CELL) * CELL
		local maxZ = hill.Center.Y + hill.Radius
		if hill.Name == "Galgberget" then
			maxZ = math.min(maxZ, CityGrid.OriginZ) -- resten är redan skriven
		end
		local count = math.ceil(hill.Radius * 2 / CELL)
		local countRows = math.ceil((maxZ - minZ) / CELL)
		if countRows > 0 then
			local fallback = if hill.Material == Material.Sand then "N" else "P"
			writeArea(minX, minZ, count, countRows, function(x, z)
				return CityBuilder.CodeAt(x, z) or fallback
			end)
		end
	end

	-- 6) Vägar utanför stadskartan
	for _, road in MapData.ExtraRoads do
		for i = 1, #road.Points - 1 do
			terrainRoad(road.Points[i], road.Points[i + 1], road.Width)
		end
	end
end

local STYLES = {
	-- 0: stenstaden i centrum (puts i varma toner)
	[0] = {
		Material = Material.SmoothPlastic,
		Colors = {
			Color3.fromRGB(226, 196, 150),
			Color3.fromRGB(236, 226, 204),
			Color3.fromRGB(196, 120, 92),
			Color3.fromRGB(238, 216, 160),
			Color3.fromRGB(210, 172, 140),
			Color3.fromRGB(190, 192, 188),
		},
	},
	-- 1: flerfamiljshus (tegel och ljus puts)
	[1] = {
		Material = Material.Brick,
		Colors = {
			Color3.fromRGB(176, 104, 78),
			Color3.fromRGB(214, 190, 150),
			Color3.fromRGB(200, 198, 192),
			Color3.fromRGB(160, 90, 70),
		},
	},
	-- 2: villor (falurött, vitt, gult, ljusgrått)
	[2] = {
		Material = Material.WoodPlanks,
		Colors = {
			Color3.fromRGB(150, 45, 35),
			Color3.fromRGB(150, 45, 35),
			Color3.fromRGB(240, 238, 230),
			Color3.fromRGB(232, 204, 120),
			Color3.fromRGB(200, 205, 210),
		},
	},
	-- 3: större offentliga byggnader (tegel)
	[3] = {
		Material = Material.Brick,
		Colors = { Color3.fromRGB(165, 85, 65), Color3.fromRGB(150, 78, 60) },
	},
}

function CityBuilder.BuildBuildings(parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Buildings"
	local rng = Random.new(1307)
	local count = 0
	for x, z, w, d, h, s in (CityBuildings :: string):gmatch("(%-?%d+),(%-?%d+),(%d+),(%d+),(%d+),(%d)") do
		local px, pz = tonumber(x) :: number, tonumber(z) :: number
		local width, depth, height = tonumber(w) :: number, tonumber(d) :: number, tonumber(h) :: number
		local style = STYLES[tonumber(s) :: number] or STYLES[0]
		local base = MapData.GroundHeightAt(px, pz) - 1
		local part = Geometry.Part(
			folder,
			"Building",
			Vector3.new(width, height + 1, depth),
			CFrame.new(px, base + (height + 1) / 2, pz),
			style.Colors[rng:NextInteger(1, #style.Colors)],
			style.Material
		)
		Geometry.Obstacle(part)
		count += 1
		if count % 500 == 0 then
			task.wait()
		end
	end
	folder.Parent = parent
	return count
end

export type RoadPoint = { Position: Vector3, Yaw: number }

function CityBuilder.RoadPoints(): { RoadPoint }
	local points: { RoadPoint } = {}
	for x, z, yaw in (CityRoadPoints :: string):gmatch("(%-?%d+),(%-?%d+),(%-?%d+)") do
		local px, pz = tonumber(x) :: number, tonumber(z) :: number
		table.insert(points, {
			Position = Vector3.new(px, MapData.GroundHeightAt(px, pz), pz),
			Yaw = tonumber(yaw) :: number,
		})
	end
	return points
end

return CityBuilder
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000013"><Properties><string name="Name">Generated</string></Properties><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">CityBuildings</string><ProtectedString name="Source"><![CDATA[--!strict
